Abaddon: {
	DisplayName: Abaddon
	Tooltip:
		'''
		Golpes críticos amaldiçoam os inimigos com [cbuff:CalamityMod/Bane], que escala com sua chance de acerto crítico
		Quando atingidos com um golpe crítico, os inimigos espalham todos os efeitos negativos mais fracos que sua [cbuff:CalamityMod/Bane] que possuem a inimigos próximos
		Reduz os danos sofridos por [cbuff:CalamityMod/BrimstoneFlames] em {1}%
		'''
	Equipped: Dano atual da [cbuff:CalamityMod/Bane]: {0} DPS
	Unequipped: Equipe este acessório para ver o dano atual da [cbuff:CalamityMod/Bane]
}

AbyssalDivingGear: {
	DisplayName: Equipamento de Mergulho Abissal
	Tooltip:
		'''
		Reduz o dano causado pela pressão do abismo enquanto estiver sem fôlego
		Oferece a capacidade de nadar e aumenta muito o tempo embaixo d'água
		Fornece luz debaixo d'água e maior mobilidade no gelo
		Fornece uma quantidade razoável de luz e reduz a perda de fôlego no abismo
		'''
}

AbyssalDivingSuit: {
	DisplayName: Traje de Mergulho Abissal
	Tooltip:
		'''
		Transforma o jogador em um mergulhador com armadura:
		Aumenta a velocidade dos movimentos máxima e a aceleração enquanto debaixo d'água, mas as reduz fora d'água
		Oferece a capacidade de nadar, estende o fôlego debaixo d'água, emite luz debaixo d'água e melhora a mobilidade no gelo
		Fornece uma quantidade razoável de luz, reduz a perda de fôlego e reduz o dano causado pelo afogamento no abismo
		Criaturas do abismo terão dificuldade em vê-lo, mitiga a redução de defesa causada pelo abismo, e permite que você afunde mais rápido em líquidos
		Oferece imunidade às águas sulfurosas e o aumento de perda de fôlego da [cbuffplr:CalamityMod/CrushDepth]
		Oferece resistência à perda de fôlego aumentada causada pela [cbuffplr:CalamityMod/HadopelagicPressure]
		'''
}

AbyssalMirror: {
	DisplayName: Espelho Abissal
	Tooltip:
		'''
		A chance dos inimigos mirarem em você é menor, até mesmo no abismo
		A furtividade é gerada 25% mais rapidamente enquanto parado e 12% mais rápido enquanto se move
		{$Common.DodgeProvided}
		Desviar de um ataque restaura a furtividade e libera uma nuvem danosa que atordoa inimigos próximos
		'''
	HoldShiftTooltip: "{$Common.DodgeInformation}"
	FlavorTooltip: "'A luz não atinge as profundezas do oceano'"
}

AeroStone: {
	DisplayName: Rocha Aérea
	Tooltip:
		'''
		Fornece {0} segundos de tempo de voo adicional
		Você recupera lentamente o tempo de voo enquanto está no ar se não estiver voando ou planando
		'Uma das relíquias antigas'
		'''
}

Affliction: {
	DisplayName: Aflição
	Tooltip: Concede a todos os jogadores da equipe regen. de +{0} de vida/s, +{1}% de vida máxima, {3} de defesa e {4}% de aumento nos danos
}

AlchemicalDecanter: {
	DisplayName: Decantador Químico
	Tooltip:
		'''
		Todos os ataques infligem a [cbuff:CalamityMod/Plague] e reduz os danos sofridos pela [cbuffplr:CalamityMod/Plague] em {0}%
		Projéteis invocam caçadores da praga ao atingir o inimigo
		Libera abelhas da praga e ensopa o jogador com [cbuffplr:Honey] ao sofrer danos
		'''
}

AlluringBait: {
	DisplayName: Isca Encantadora
	Tooltip:
		'''
		{0} de aumento no poder de pescaria
		Aumenta bastante o retorno de peixes que são ingredientes de poção
		'''
}

AmalgamatedBrain: {
	DisplayName: Cérebro Amalgamado
	Tooltip:
		'''
		Sofrer danos confunde os inimigos próximos e invoca um rastejante nojento
		O rastejante nojento voa acima de você, explodindo em várias nuvens de chuva das sombras
		{$Common.DodgeProvided}
		Depois de desviar, os danos por invocações e chance de acerto crítico são aumentados em 10%
		'''
	HoldShiftTooltip: "{$Common.DodgeInformation}"
}

AmbrosialAmpoule: {
	DisplayName: Ampola Ambrosial
	Tooltip:
		'''
		Concede regen. de +{0} a +{1} de vida/s com base na vida ausente [c/999999:(Atualmente: +[REGEN] de vida/s)]
		A regen. de vida natural é {2}% mais potente e retorna {3}% mais rapidamente
		Você emite luz amarela se a visibilidade estiver ligada
		'''
}

AmidiasPendant: {
	DisplayName: Pingente de Amidias
	Tooltip: Fragmentos que podem brevemente atordoar os inimigos choverão periodicamente
}

AncientFossil: {
	DisplayName: Fóssil Antigo
	Tooltip:
		'''
		Aumenta a velocidade de mineração em {0}%
		Oferece imunidade aos danos causados por blocos em queda
		'''
}

AnechoicPlating: {
	DisplayName: Revestimento Anecóico
	Tooltip:
		'''
		A chance das criaturas abissais verem você é menor
		Mitiga a redução da defesa causada pela pressão do abismo
		'''
}

AngelicAlliance: {
	DisplayName: Aliança Angelical
	Tooltip:
		'''
		Invoque a força dos céus para fortalecer seus ataques e lacaios
		Coragem, Iluminação, Felicidade. Unidos no Julgamento
		+{0} lacaios máximos, {1}% de aumento nos danos por invocação e {2}% de aumento no dano de todas as outras classes
		Regen. de +{3} de vida/s enquanto o tempo de voo estiver esgotado parcialmente ou vazio
		Pressione [KEY] para se abençoar com o efeito [cbuff:CalamityMod/DivineBless] por {4} segundos
		Enquanto estiver ativado, um arcanjo é invocado para cada lacaio que você tiver
		Arcanjos vaporizam os inimigos com luz divina e cada um restaura {5} de vida ao ser invocado
		Ataques de lacaios infligem [cbuff:CalamityMod/BanishingFire] e você recebe uma regen. plana de +{6} de vida/s
		Este efeito tem um tempo de recarga de {7} minuto
		'''
}

AngelTreads: {
	DisplayName: Pisantes Angelicais
	Tooltip:
		'''
		Permite o voo, a corrida super veloz e maior mobilidade no gelo
		{0}% de aumento na velocidade dos movimentos e {1}% de aumento no tempo de voo
		Permite andar sobre a água, o mel e a lava
		Oferece imunidade a blocos de fogo e {2} segundos de imunidade a lava
		Reduz dano sofrido ao entrar em contato com lava
		'Velocidade extrema!'
		'''
}

Apollyon: {
	DisplayName: Apollyon
	Tooltip:
		'''
		Golpes críticos amaldiçoam os inimigos com [cbuff:CalamityMod/Bane], que escala muito com sua chance de acerto crítico
		Quando atingidos com um golpe crítico, os inimigos espalham todos os efeitos negativos mais fracos que sua [cbuff:CalamityMod/Bane] que possuem a inimigos próximos
		Golpes críticos causam 3% a mais de dano por cada efeito negativo no inimigo
		[DAMAGELINE]
		'''
	Equipped: Dano atual da [cbuff:CalamityMod/Bane]: {0} DPS
	Unequipped: Equipe este acessório para ver o dano atual da [cbuff:CalamityMod/Bane]
}

AquaticEmblem: {
	DisplayName: Emblema Aquático
	Tooltip:
		'''
		A maioria dos inimigos do oceano tornam-se amigáveis e fornece respiração embaixo d'água
		Estar debaixo d'água aumenta gradualmente sua defesa mas diminui a sua velocidade de movimento por um período de {0} segundos
		Este efeito desaparece lentamente fora d'água
		O impulso máximo de defesa é {1} e a redução máxima da velocidade de movimento é {2}%
		Fornece uma quantidade pequena de luz no abismo e reduz razoavelmente a perda de fôlego no abismo
		'''
}

AquaticHeart: {
	DisplayName: Coração Aquático
	Tooltip:
		'''
		Transforma o jogador em um elemental de água que emite luz
		[STATUS]
		'''
	LockedTooltip: "[c/F05A5A:A magia da pérola está sendo suprimida por uma maldição antiga]"
	FullTooltip:
		'''
		Uau, você pode nadar agora!
		Estar embaixo d'água aumenta a velocidade máxima e a aceleração em {0}%
		Reduz bastante a perda de fôlego e reduz a intensidade da escuridão do abismo
		Atacantes são infligidos com [cbuff:Frozen]
		Receba uma barreira de gelo frágil que concede {1}% de redução nos danos para um ataque
		O escudo de gelo regenera em {2} segundos
		'''
}

ArcFlashRing: {
	DisplayName: Anel do Clarão em Arco
	Tooltip:
		'''
		Ataques têm uma chance de {0}% de chamar um relâmpago que causa {1}x o dano
		A chance é reduzida para cada inimigo que o ataque atingir
		O dano do relâmpago é baseado no dano sem críticos, mas ele mesmo pode causar acertos críticos
		Os relâmpagos são transparentes e silenciosos se a visibilidade estiver desativada
		'''
}

ArchaicPowder: {
	DisplayName: Pó Arcáico
	Tooltip:
		'''
		{0}% de aumento na velocidade de mineração
		Oferece imunidade aos danos causados por blocos em queda e armadilhas de dardo
		{1}% de resistência aos danos causados por armadilhas
		Não acumula com versões anteriores
		'''
}

AscendantInsignia: {
	DisplayName: Insígnia Ascendente
	Tooltip:
		'''
		Aumenta o tempo de voo da asa em {0}%, a velocidade dos movimentos em {1}, e a aceleração em {2}x
		Pressionar [KEY] lhe dará o poder da ascensão, concedendo voo infinito por {3} segundos
		A ascensão tem um tempo de recarga de {4} segundos
		'''
}

AsgardianAegis: {
	DisplayName: Égide Asgardiana
	Tooltip:
		'''
		{$Common.KnockbackImmunity}
		Concede a capacidade de fazer uma investida, fortalecida pelo inferno cósmico
		Essa investida permite atravessar os inimigos sem sofrer danos
		'''
}

AsgardsValor: {
	DisplayName: Valor de Asgard
	Tooltip:
		'''
		{$Common.KnockbackImmunity}
		Concede a capacidade de fazer uma investida de colisão
		Essa investida permite atravessar os inimigos sem sofrer danos
		'''
}

FadedIdolatry: {
	DisplayName: Idolatria Desvanecida
	Tooltip:
		'''
		[i:CalamityMod/YharonsKindleStaff] Draconídeos Flamejantes invocados custam 1 espaço de lacaio a menos
		[c/ffe100:'Quando tudo se desfizer em pó, o que restará do mundo que você criou?']
		'''
}

BadgeofBravery: {
	DisplayName: Insígnia da Bravura
	Tooltip:
		'''
		Aumenta os danos por ataque físico e chance de acerto crítico físico em 10%
		+5 de perfuração de blindagem
		'''
}

Baroclaw: {
	DisplayName: Barogarra
	Tooltip:
		'''
		10% de aumento nos danos e 5% de aumento na redução dos danos
		Atacantes sofrem muito dano e são infligidos com [cbuff:CalamityMod/ArmorCrunch] e [cbuff:CalamityMod/CrushDepth]
		'''
}

BatholithBangle: {
	DisplayName: Bracelete de Batólito
	Tooltip:
		'''
		Acertos mágicos fazem um clarão de granito poderoso que sempre causa um acerto crítico
		Este efeito tem um tempo de recarga de 10 segundos
		Efeitos visuais e sonoros são reduzidos se a visibilidade estiver desativada
		[c/0189D7:'O granito sólido radia energia por todo o seu corpo']
		'''
}

BlackGlassBand: {
	DisplayName: Pulseira de Vidro Negro
	Tooltip:
		'''
		Acertos no inimigo fazem um clarão de obsidiana que sempre causa um acerto crítico
		Este efeito tem um tempo de recarga de 5 segundos, mas é reduzido na metade se o clarão matar um inimigo
		Efeitos visuais e sonoros são reduzidos se a visibilidade estiver desativada
		[c/655DC5:'Uma pulseira brilhante com potencial sem limites']
		'''
}

BlazingCore: {
	DisplayName: Núcleo Ardente
	Tooltip:
		'''
		{$Common.KnockbackImmunity}
		O núcleo abrasador da Deusa Profana
		Pressionar [KEY] irá ativar uma aparada, encapsulando você com um cristal profano luminoso
		Ser atingido logo após ser encapsulado quebrará o cristal
		Na destruição, estrelas sagradas espiralam para fora e o dano é anulado
		Depois da destruição, este efeito de redução dos danos entra em recarga
		Danos aparados durante o tempo de recarga invocam estrelas de cura adicionais, e não serão reduzidos
		'''
}

BloodflareCore: {
	DisplayName: Núcleo das Chamas Sangrentas
	Tooltip:
		'''
		{$Common.KnockbackImmunity}
		Recuperar dano na defesa cura você, cada ponto de defesa recuperado concede 1 de vida
		Sofrer danos converte metade da sua defesa total em dano na defesa
		'''
}

BloodPact: {
	DisplayName: Pacto Sanguíneo
	Tooltip:
		'''
		Aumenta a vida máxima em 25%
		Poções de cura são 33% mais efetivas
		Oferece imunidade a [cbuffplr:Bleeding], [cbuffplr:CalamityMod/BurningBlood] e [cbuffplr:CalamityMod/HeavyBleeding]
		'''
}

BloodstainedGlove: {
	DisplayName: Luva Manchada de Sangue
	Tooltip: Ataques furtivos têm +8 perfuração de blindagem e curam 5 de vida
}

BloodyWormScarf: {
	DisplayName: Cachecol de Verme Sangrento
	Tooltip: 10% de aumento na redução dos danos e nos danos por ataque físico
}

BloodyWormTooth: {
	DisplayName: Dente de Verme Sangrento
	Tooltip: 10% de aumento nos danos por ataque físico
}

BloomStone: {
	DisplayName: Rocha do Desabrocho
	Tooltip:
		'''
		Poções de cura são 50% mais efetivas, mas concedem sua cura ao longo do tempo
		Ganchos retraem e puxam o jogador 30 mph mais rapidamente, além de crescerem uma flor nos pontos de contato
		Tocar numa flor a faz explodir em pólem que concede um aumento temporário na velocidade de cura das poções
		A velocidade de cura das poções reduz drasticamente com a vida cheia
		'Uma das relíquias antigas'
		'''
}

BlunderBooster: {
	DisplayName: Reforço da Enganação
	Tooltip:
		'''
		12% de aumento nos danos por ataques ladinos e 15% de aumento na velocidade dos projéteis ladinos
		A furtividade é gerada 10% mais rapidamente
		Invoca uma aura de relâmpago vermelha para cercar o jogador e eletrificar os inimigos próximos
		A aura possui uma opacidade reduzida se a visibilidade estiver desativada
		Pressione [KEY] para consumir 25% de sua furtividade máxima para executar uma corrida ascendente diagonal veloz
		Esta investida deixa um rastro de relâmpagos vermelhos
		Este efeito tem um tempo de recarga de 1 segundo antes que possa ser usado novamente
		'''
}

Calamity: {
	DisplayName: Calamidade
	Tooltip:
		'''
		Incendeia o seu cursor com as chamas da Bruxa, envolvendo-o em uma aura ardente
		Inimigos que tocam nas chamas recebem danos imensos e são infligidos com o [cbuff:CalamityMod/VulnerabilityHex]
		Focar num inimigo por 2,5 segundos o amaldiçoa, ascendendo o Feitiço de Vulnerabilidade à sua forma Verdadeira
		Inimigos infligidos com o [cbuff:CalamityMod/TrueVulnerabilityHex] sofrem 1,15x a mais de dano de todas as fontes
		Este efeito é aumentado para 2,5x para o cursor ardente em si
		Equipe em um espaço social para alterar o cursor sem causar danos
		Essas mudanças funcionam em conjunto com o Cursor de Arco-íris
		'''
}

ChaliceOfTheBloodGod: {
	DisplayName: Cálice do Deus do Sangue
	Tooltip:
		'''
		Aumenta a vida máxima em 25%
		Concede regen. de +2 de vida/s e reduz o tempo de recarga de poções de cura em 25%
		Sofrer mais de 5 de dano converte o golpe em um efeito de dano por sangramento ao longo do tempo
		Esse sangramento não interfere com a regeneração de vida
		Beber uma Poção de Cura remove um pouco do sangramento restante, até um máximo de 50% do seu valor de cura
		Desequipar esse acessório enquanto estiver sangrando inflige o dano restante instantaneamente
		Oferece imunidade a [cbuffplr:Bleeding], [cbuffplr:CalamityMod/BurningBlood], [cbuffplr:CalamityMod/HeavyBleeding], e [cbuffplr:CalamityMod/Laceration]
		'Pai, afasta de mim esse cálice...'
		'''
}

ChaosStone: {
	DisplayName: Rocha do Caos
	Tooltip:
		'''
		Desativa o consumo de poções automático
		Itens que consomem mana podem ser usados mesmo sem o valor de mana necessário
		O uso de mana pode transbordar em mana negativa, fazendo com que você receba e inflija [cbuff:CalamityMod/ManaBurn]
		Quanto mais baixa estiver a sua mana, mais intenso será o fogo de mana
		Mana negativa tem um limite correspondente à sua quantidade de mana máxima
		Intensidade máxima atual de acordo com sua mana máxima: -[REGEN] de vida/s, e queima os inimigos por [DAMAGE]% do dano causado
		'''
}

CleansingJelly: {
	DisplayName: Geleia da Pureza
	Tooltip:
		'''
		Usar uma poção de cura invocará uma aura azul que dura {0} segundos
		Andar na aura removerá todos os efeitos negativos e dano da defesa uma vez
		'''
}

CoinofDeceit: {
	DisplayName: Moeda do Engano
	Tooltip:
		'''
		Ataques furtivos gastam apenas 90% de sua furtividade máxima
		6% de aumento na chance de ataque ladino crítico
		'''
}

CorrosiveSpine: {
	DisplayName: Coluna Corrosiva
	Tooltip:
		'''
		5% de aumento na velocidade dos movimentos
		25% de aumento nos danos por efeitos negativos de Doença e Água
		Todos os ataques infligem [cbuff:CalamityMod/Irradiated] nos inimigos e reduz a severidade das águas sulfuricas
		Você explode em nuvens radioativas ao sofrer danos
		'''
}

CounterScarf: {
	DisplayName: Cachecol do Contra-ataque
	Tooltip:
		'''
		Permite fazer uma investida; fazer uma investida em um ataque fará com que você desvie dele
		Depois de um desvio bem-sucedido, você deve esperar 30 segundos antes de poder desviar novamente
		'''
}

CrawCarapace: {
	DisplayName: Carapaça de Caranguejo
	Tooltip:
		'''
		7% de aumento nos danos
		Atacantes sofrem dano e são infligidos com [cbuff:CalamityMod/Crumbling]
		'''
}

CrownJewel: {
	DisplayName: Joia da Coroa
	Tooltip:
		'''
		Regen. de +{0} de vida/s
		Reduz os danos sofridos com o tempo em {1} de vida/s
		'''
}

CryoStone: {
	DisplayName: Rocha do Gelo
	Tooltip:
		'''
		50% de aumento nos danos por efeitos negativos de Frio
		Cria um escudo de gelo giratório ao seu redor que causa danos e desacelera os inimigos que o tocarem
		'Uma das relíquias antigas'
		'''
}

DaawnlightSpiritOrigin: {
	DisplayName: Origem do Espírito de Daawnlight
	Tooltip:
		'''
		Todas as armas de ataque à distância podem realizar um ataque supercrítico com uma chance de acerto crítico maior que 100%
		Marca inimigos e chefes próximos com alvos que aumentam a chance de acerto crítico ao serem atingidos
		A chance de acerto crítico extra some com o tempo
		Invoca um espírito heróico de outro mundo se a visibilidade estiver ativada, ou se estiver em um espaço decorativo
		'''
	HoldShiftTooltip:
		'''
		Todas as armas de ataque à distância podem realizar um ataque supercrítico com uma chance de acerto crítico maior que 100%
		Marca inimigos e chefes próximos com alvos que desaparecem logo após serem atingidos
		Ataques à distância que atingirem alvos recebem maior chance de acerto crítico
		Projéteis grandes e explosões não atingem os alvos
		Armas mais lentas recebem uma chance de acerto crítico maior no acerto
		A chance de acerto crítico adicional some rapidamente com o tempo
		Quanto maior o impulso, maior a velocidade que ele some
		Invoca um espírito heróico de outro mundo se a visibilidade estiver ativada, ou se estiver em um espaço decorativo
		'''
	FlavorTooltip: "'Uma vertente de um cosmos perdido permanece, esperando por seu mestre'"
}

DarkMatterSheath: {
	DisplayName: Bainha da Matéria Escura
	Tooltip:
		'''
		+10 furtividade máxima
		A regeneração furtiva móvel acelera se você não estiver atacando
		Ataques furtivos gastam apenas 50% de sua furtividade máxima
		6% de aumento nos danos por ataques ladinos e na chance de ataque ladino crítico
		'''
}

DarkSunRing: {
	DisplayName: Anel do Sol Escuro
	Tooltip:
		'''
		{$Common.KnockbackImmunity}
		12% de aumento nos danos
		Regen. de +0,5 de vida/s e +2 lacaios máximos
		Aumenta o recuo dos lacaios
		Fornece vários feitos conforme o dia passa
		'''
	HoldShiftTooltip:
		'''
		  Durante o dia, concede regen. de +2 de vida/s
		  Durante a noite, concede +16 de defesa
		  Durante um eclipse, condece regen. de +1 de vida/s e +8 de defesa
		'''
	FlavorTooltip: "'Contém o poder do sol escuro'"
}

DeadshotBrooch: {
	DisplayName: Broche do Tiro Morto
	Tooltip:
		'''
		12% de aumento nos danos por ataque à distância, 7% de aumento na chance de acerto crítico à distância e 20% de redução no consumo de munição
		Pressionar [KEY] trocará automaticamente a ordem das munições no seus espaços de munição 
		O tipo de munição trocadaa depende da munição da arma empunhada
		'''
}

DeepDiver: {
	DisplayName: Mergulhador das Profundezas
	Tooltip:
		'''
		Permite que o jogador faça uma investida com um tempo de recarga menor
		Essa investida permite atravessar os inimigos sem sofrer danos
		Fornece mobilidade muito maior embaixo d'água
		'''
}

DeificAmulet: {
	DisplayName: Amuleto Sagrado
	Tooltip:
		'''
		Libera uma explosão de abelhas-astrais teleguiadas[TOGGLE] e o encharca de [cbuffplr:Honey] ao sofrer danos
		Aumenta a duração da invencibilidade, com uma duração ainda maior com vida baixa
		[c/aaaaaa:Segure Shift e <right> neste item no seu inventário para alternar o efeito do] [i:PanicNecklace] [c/aaaaaa:Colar do Pânico]
		'''
	ToggleEffect: ", aumenta a velocidade dos movimentos"
}

DepthCharm: {
	DisplayName: Amuleto das Profundezas
	Tooltip:
		'''
		Reduz o dano causado pelo afogamento no abismo
