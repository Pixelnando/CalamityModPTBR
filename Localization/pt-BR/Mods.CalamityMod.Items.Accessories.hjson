}

FeatherCrown: {
	DisplayName: Feather Crown
	Tooltip:
		'''
		Invoca uma [c/81B7F7:Pena do Horizonte] a cada 2 segundos, até um máximo de 5
		Cada [c/81B7F7:Pena do Horizonte] aumenta o dano por magia em 2% e reduz o custo de mana em 1%
		Com 5 penas, aumenta a chance de acerto crítico mágico em 5% e todos os ataques mágicos infligirão [cbuff:CalamityMod/StaticDischarge]
		Esgotar a mana ou usar uma poção de mana faz com que você perca as penas
		Ao perder uma pena, não é possível ganhar outras penas por 5 segundos
		As penas são transparentes e silenciosas se a visibilidade estiver desativada
		'''
	HoldShiftTooltip:
		'''
		[c/81B7F7:Os jovens magos vestiam-se com penas e contemplavam a noite estrelada, como se estivessem dando as boas-vindas ao sopro dos céus.]
		[c/81B7F7:Entrar em comunhão com a mana era entrar em comunhão com o mundo e, além disso, com seus senhores draconianos.]
		'''
}

FilthyGlove: {
	DisplayName: Luva Suja
	Tooltip: Golpes furtivos têm +8 perfuração da blindagem e causam 8% a mais de dano
}

FishStocks: {
