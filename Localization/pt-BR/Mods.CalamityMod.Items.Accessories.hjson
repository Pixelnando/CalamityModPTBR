}

GlimmeringRibbon: {
	DisplayName: Laço Cintilante
	Tooltip: "'Nascemos sem cor. São as pessoas que conhecemos que nos colorem.'"
}

TheComb: {
	DisplayName: O Pente
	Tooltip:
		'''
		Fornece um acabamento brilhante aos cabelos do usuário
		Pequenos brilhos são atraídos a baús próximos
		'Não encontramos merda nenhuma!'
		'''
}

XyksBlessingBlue: {
	DisplayName: Bênção de Xyk (Azul)
	Tooltip:
		'''
		Aplica efeitos visuais às suas investidas, asas e morte
		<right> neste item em seu inventário para transformá-lo, ou segure Shift e <right> para alternar a visibilidade da armadura
		A visibilidade da armadura está [TOGGLE]
		'É simplesmente demais para voltar agora; a paixão e tempo já há muito o mancharam.
		[c/5f8ae1:Sempre fui assim, tão egoísta?']
		'''
	ArmorDisabled: "[c/D44748:DESATIVADA]"
	ArmorEnabled: "[c/58D447:ATIVADA]"
}

XyksBlessingOrange: {
	DisplayName: Bênção de Xyk (Laranja)
	Tooltip:
		'''
		Aplica efeitos visuais às suas investidas, asas e morte
		<right> neste item em seu inventário para transformá-lo, ou segure Shift e <right> para alternar a visibilidade da armadura
		A visibilidade da armadura está [TOGGLE]
		'Mesmo assim, a marcha do tempo não espera por ninguém. Lembre-se daquela sensação de realização e mostre-a ao mundo.
		[c/E1B65F:Prove que ela nunca foi um desperdício.']
		'''
	ArmorDisabled: "[c/D44748:DESATIVADA]"
	ArmorEnabled: "[c/58D447:ATIVADA]"
}

FrozenCube: {
	DisplayName: Cubo Congelado
	Tooltip:
		'''
		Um bloco de gelo com algo dentro
		Invoca um Elumfante pra sentar na sua cabeça e te proteger
		O elumfante irá alternar entre disparar ar frio que inflige [cbuff:CalamityMod/WindChilled] e dar cabeçadas nos inimigos
		As cabeçadas do elumfante focam apenas em inimigos infligidos com [cbuff:CalamityMod/WindChilled]
		Reduz sua defesa em 33%, mas usa essa defesa para aumentar o poder do elumfante e o dano por efeitos negativos de gelo
		[DAMAGELINE]
		[c/7497ED:'O que eu quero saber é: cadê o mamute?']
		'''
	SalesPitch: "{$Common.SalesmanShrinePitch}"
	EquippedDebuff: Aumento atual nos danos por efeitos negativos de gelo: +{0}%
	EquippedElumphant: Poder atual do Elumfante: +{0}%
	Unequipped: Equipe este acessório para ver suas estatísticas
}
