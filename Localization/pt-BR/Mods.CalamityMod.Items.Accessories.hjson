		'''
	ShieldAdren: Você perde apenas metade da Adrenalina se todo o dano for absorvido
}

TheTransformer: {
	DisplayName: O Transformador
	Tooltip: "[GFB]"
	TooltipNormal:
		'''
		Gera uma aura ao seu redor que cria orbes mutantes quando projéteis atravessam ela ou quando inimigos são derrotados
		Os orbes orbitam ao seu redor e causam dano e recuo baixos aos inimigos que colidirem com eles
		O círculo pode guardar até 30 orbes de uma só vez
		Aperte [KEY] para transformar todos os orbes em agulhas e lança-las na direção do seu cursor
		'Como que isso surgiu das tralhas que você amassou junto? Você tem sorte que isso não TE transforma'
		'''
	TooltipGFB:
		'''
		Gera uma aura ao seu redor que cria orbes mutantes quando projéteis atravessam ela ou quando inimigos são derrotados
		Os orbes orbitam ao seu redor e causam dano e recuo baixos aos inimigos que colidirem com eles
		O círculo não tem limite de orbes que pode guardar, mas pode ser que seu PC tenha
		Aperte [KEY] para transformar todos os orbes em agulhas e lança-las na direção do seu cursor
		'Não é um Beeftank Doctrine, mas definitivamente é um breakthrough!'
		'''
}

ToxicHeart: {
	DisplayName: Coração Tóxico
	Tooltip:
		'''
		Seu coração bate com a praga, pulsando para fora do seu corpo
		A frequência do pulso escala com a regen. de vida, e pulsos que matarem inimigos pulsam novamente para te curar
