		'''
}

WarbanneroftheRighteous: {
	DisplayName: Estandarte de Guerra do Justiceiro
	Tooltip:
		'''
		Multiplica todos os danos com base na proximidade aos inimigos
		O aumento máximo é de 15%, o mínimo é de -15%
		Emite uma aura ardente que queima e repele inimigos próximos com [cbuff:CalamityMod/HolyFlames]
		Os inimigos sofrem mais dano quanto mais perto estiverem de você e quanto mais tempo permanecerem próximos
		Os efeitos são transparentes e silenciosos se a visibilidade estiver desativada
		'''
}

WulfrumAcrobaticsPack: {
	DisplayName: Pacote de Acrobacias de Vulfrúmio
	Tooltip:
		'''
		Fornece um estilingue de vulfrúmio como um gancho
		As estatísticas do estiligue aumentam de acordo com seu gancho equipado
		Se o gancho tiver efeitos especiais, o estilingue também se beleficia deles
		O estilingue permite físicas avançadas para balançar a corda
		Segure {$Key.UP} ou {$Key.DOWN} para retrair ou estender a corda do estilingue
		Agarra em paredes próximas automaticamente se uma caída letal for detectada
		Este recurso de segurança não será ativado se {$Key.DOWN} for pressionada
		8% de aumento na velocidade dos movimentos
		'''
}

WulfrumBattery: {
	DisplayName: Bateria de Vulfrúmio
	Tooltip:
		'''
		Suas invocações emitem luz se a visibilidade estiver ativada
		7% de aumento nos danos por lacaios
		Inimigos de vulfrúmio deixam cair mais uma sucata
		Também pode ser sucateado em um extrator
		'''
}

YharimsGift: {
	DisplayName: Presente de Yharim
	Tooltip:
		'''
		{$Common.KnockbackImmunity}
		10% de aumento nos danos e 20% de aumento na velocidade dos movimentos
		Todos os ataques infligem [cbuff:CalamityMod/AuricRebuke]
		Meteoros em chamas chovem enquanto estiver invulnerável
		[c/FCA92B:'O poder para matar um deus pulsa dentro deste artefato']
		'''
}

// Vanity Accessories
AbandonedWulfrumHelmet: {
	DisplayName: Capacete de Vulfrúmio Abandonado
