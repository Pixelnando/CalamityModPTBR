	SalesPitch:
		'''
		'Pescar é difícil, mas sabe o que é fácil? Economia! Com esse aparelhinho feito pelo meu colega Hoggart, a pescaria vai ser tão fácil quanto a economia!'
		'Puxe a linha quando estiver em alta, e não puxe quando estiver em baixa! É mamão com peixe! ...Ou açúcar.'
		'''
}

FlameLickedShell: {
	DisplayName: Casco da Língua de Chamas
	Tooltip:
		'''
		{$Common.KnockbackImmunity}
