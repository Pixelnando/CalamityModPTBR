// Be warned translators, this thing fucking sucks
StatMeter: {
	DisplayName: Medidor de Estatísticas
	FoolsName: Coador de Macarrão
	Tooltip:
		'''
		Exibe quase todas as estatísticas do jogador
		Estatísticas ofensivas/utilitárias exibidas variam de acordo com o item segurado
		[REV]
		[ITEMS]
		[GENERIC]
		[ABYSS]
		'''
	RevStats:
		'''
		Aumento de danos no Modo Fúria: {0}% | Duração do Modo Fúria: {1} segundos
		Aumento de danos no Modo Adrenalina: {2}% | Aumento na redução dos danos no Modo Adrenalina: {3}%
		'''

	ClassNameOverride: {
		Default: de dano verdadeiro
		Generic: de dano sem classe
		NoSpeed: " (sem velocidade)"
		SummonMeleeSpeed: " (chicote)"
	}

	DamageStats:
		'''
		Classe: {0}
		Dano: {1}
		Perfuração de armadura: {2}
		'''
	DamageBase: "[{0} base] +"
	DamageNormal: "{0}%"
	DamageMult: " x{0}"
	DamageFlat: " {0} plano"
	Crit: " | Chance de acerto crítico: {0}%"
	AttackSpeed: Velocidade de ataque: {0}%
	WhipMeleeInheritance: " [{0}% do ataque físico]"
	// Class stats
	AmmoStats: Chance de consumo de munição: {0}%
	ManaStats: Consumo de mana: {0}% | Regen. de mana: {1}
	SummonStats: Espaços de lacaio: {0} | Espaços de sentinela: {1}
	WhipStats: Alcance do chicote: {0}%
	RogueStats:
		'''
		Furtividade máx: {0} | Regen. de furt. enquanto parado: {1}/s. | Regen. de furt. enquanto se move: {2}/s.
		Aumento na velocidade dos projéteis ladinos: {3}%
		'''
	// Utility stats
	ToolRange: Bônus no alcance da ferramenta: ({0}, {1})
	MiningSpeed: " | Velocidade de mineração: {0}%"
	PlacementRange: Bônus no alcance do posicionamento: ({0}, {1})
	TileSpeed: " | Velocidade de posicionamento de blocos: {0}%"
	WallSpeed: " | Velocidade de posicionamento de paredes: {0}%"
	// Other stats
	GenericStats:
		'''
		Defesa: {0} | Redução dos danos: {1}% | Regeneração de vida: {2}
		Velocidade dos movimentos: {3}% | Aumento dos pulos: {4}%
		'''
	FlightTime: " | Tempo de voo da asa: {0} segundo(s)"
	MiscStats: Agressividade: {0} | Sorte: {1}%
	AbyssStats:
		'''
		Escuridão no Abismo: {0} | Brilho do jogador: {1}x | Largura da lanterna: {2}x
		Taxa de perda de fôlego: {3}
		Vida perdida por tique enquanto sem fôlego: {4}
		Defesa perdida pela pressão: {5}
		'''
	AbyssStatsHidden: Estatísticas do abismo são exibidas apenas enquanto você estiver no abismo
}

StressPills: {
	DisplayName: Pílulas de Estresse
	Tooltip:
		'''
		A adrenalina é carregada 20% mais rapidamente
		Aumenta a sua velocidade dos movimentos máxima e a aceleração em 5%
		'''
	SalesPitch:
		'''
		'Algumas pessoas apreciam as verdades simples da vida: o bem e o mal, a saúde e a doença. '
		'Não sei ao certo se são saudáveis, mas garanto que estes aparelhos trevosos farão seu sangue ferver! Me ajude a criar rótulos simples para eles e eu te darei um desconto de parar o coração!'
		'''
}

SupremeBaitTackleBoxFishingStation: {
	DisplayName: Estação de Pesca com Caixa de Equipamento de Isca Suprema
	Tooltip:
		'''
		Aumenta a habilidade de pesca em 50
		A linha de pesca nunca quebra e diminui as chances de consumo de iscas	
		Permite pescar na lava
		'''
}

TeslasAmulet: {
	DisplayName: Amuleto de Tesla
	Tooltip:
		'''
		Gera um campo elétrico que desacelera os inimigos
		O campo inflige [cbuff:CalamityMod/StaticDischarge] e [cbuff:CalamityMod/GalvanicCorrosion]
		O campo tem opacidade reduzida se a visibilidade estiver desativada
		Reduz a duração do efeito negativo [cbuffplr:CalamityMod/StaticDischarge]
		'''
}

TheAbsorber: {
	DisplayName: O Absorvedor
	Tooltip:
		'''
		{$Common.KnockbackImmunity}
		{0}% de aumento na velocidade dos movimentos e dos pulos
		Atacantes sofrem muito dano e são afligidos com um efeito negativo de doença incapacitante
		Usar uma poção de cura invocará uma aura verde que dura {1} segundos
		Andar na aura removerá todos os efeitos negativos e concede regen. de +{2} de vida/s, {3}% de aumento nos danos e {4}% na redução dos danos
		{5}% dos danos dos ataques dos inimigos é convertido em cura
		'''
}

TheAmalgam: {
	DisplayName: O Amálgama
	Tooltip:
		'''
		Todos os ataques infligem uma variedade de efeitos negativos, 200% de aumento nos danos de efeitos negativos elementais
		A maioria dos efeitos dura o dobro do tempo e persistem na morte
		Sofrer danos confunde os inimigos próximos e invoca um rastejante nojento
		O rastejante nojento voa acima de você, explodindo em várias nuvens de chuva das sombras
		{$Common.DodgeProvided}
		Depois de se esquivar, os danos por invocação e a chance de acerto crítico por invocação são aumentados em 10%
		'Você não faz ideia de como ele mantém a forma'
		'''
	HoldShiftTooltip: "{$Common.DodgeInformation}"
}

TheBee: {
	DisplayName: A Abelha
	Tooltip:
		'''
		Com vida cheia, seu dano é aumentado com base na sua redução dos danos
		Danos sofridos com vida cheia serão cortados pela metade
		Escudos de energia devem estar cheios para que este efeito se aplique
		Isto possui um tempo de recarga de 6 segundos
		'''
}

TheCamper: {
	DisplayName: O Campista
	Tooltip:
		'''
		Você causa 50% menos danos a menos que esteja estacionário
		Ficar parado concede efeitos dependendo da arma que você está segurando e cria uma aura danosa ao seu redor
		Enquanto se move, você regenera vida como se estivesse parado
		{$Common.AbyssGlow} enquanto estiver parado
		'No descanso, podemos encontrar a vitória'
		'''
}

TheCommunity: {
	DisplayName: A Comunidade
	Tooltip:
		'''
		[STATS]
		'O coração (da maioria) da comunidade do Terraria'
		Obrigado a todos os nossos apoiadores que tornaram este mod uma realidade!
		'''
	StatsList:
		'''
		Aumenta o dano em {0}% e a chance de acerto crítico em {1}%
		Aumenta a vida máxima em {2}%, redução dos danos em {3}%, e defesa em {4}
		Regen. de +{5} de vida/s quando afligido com efeitos negativos danosos
		Aumenta a velocidade dos movimentos em {6}% e o tempo de voo em {7}%
		Torne-se mais poderoso conforme você derrota os chefes ({8}% de poder)
		'''
}

TheEvolution: {
	DisplayName: A Evolução
	Tooltip:
		'''
		Permite que você se esquive de projéteis, refletindo fragmentos de espelho altamente danosos de volta aos inimigos
		{$Common.DodgeInformation}
		Caso for atingido por um projétil igual durante o tempo de recarga, você resistirá o dano em 25%
		'''
}

TheFirstShadowflame: {
	DisplayName: A Primeira Chama das Sombras
	Tooltip:
		'''
		Aumenta os lacaios máximos em 1
		Ataques de lacaios infligem [cbuff:CalamityMod/Shadowflame] e oferece imunidade a [cbuffplr:CalamityMod/Shadowflame]
		'''
}

ThePointer: {
	DisplayName: Ponteiro à Laser
	Tooltip:
		'''
		Permite foco automático nos inimigos
		Aperte [KEY] para alternar entre alvos perto do mouse
		Depois de alternar entre todos os inimigos próximos, apertar novamente desativará o ponteiro
		'Bom para gatos!'
		'''
}

TheSponge: {
	DisplayName: A Esponja
	Tooltip:
		'''
		{$Common.KnockbackImmunity}
		Receba uma barreira com {0} de vida
		A barreira concede {1}% de redução dos danos enquanto estiver ativada
		[ADREN]
		A barreira será regenerada {2} segundos após ser atingido, levando {3} segundos para regenerar completamente
