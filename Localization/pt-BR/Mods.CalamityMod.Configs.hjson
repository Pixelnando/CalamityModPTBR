SetBonusDoubleTapOptions: {
	// Tooltip: ""

	On: {
		// Label: Always On
		// Tooltip: Always enables double-tap. Can be used in conjunction with Calamity's {$Keybinds.ArmorSetBonus.DisplayName} hotkey.
	}

	Auto: {
		// Label: Auto
		// Tooltip: Automatically turns off double-tap as long as Calamity's {$Keybinds.ArmorSetBonus.DisplayName} hotkey is bound.
	}

	Off: {
		// Label: Always Off
		// Tooltip: Always disables double-tap. Can be used to completely disable set bonus activation.
	}
}

