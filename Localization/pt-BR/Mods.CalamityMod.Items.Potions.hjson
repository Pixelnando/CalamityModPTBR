BaconOil: {
	DisplayName: Óleo de Bacon
	Tooltip:
		'''
		Fornece uma "boa" mobilidade que escala com as estatísticas de dano
		Conta como 3 álcoois para o {$Buffs.AlcoholPoisoning.DisplayName}
		{$Common.AlcoholWarning}
		'''
	DripEffect:
		'''
		Fornece uma "boa" mobilidade que escala com as estatísticas de dano
		Conta como 3 álcoois para o {$Buffs.AlcoholPoisoning.DisplayName}
		Quando combinado com o consumo direto de Óleo de Bacon, a mobilidade fica ainda mais maluca
		'''
	SalesPitch:
		'''
		'Os monges ficam falando sem parar sobre abrir mão do apego. Não acho que fosse isso que eles queriam dizer. É melhor assim!'
		'Não ligue para o aviso sobre possíveis acidentes: compre um pouco desse óleo escorregadio e gorduroso, e nada neste mundo vai conseguir te segurar!'
		'''
}

