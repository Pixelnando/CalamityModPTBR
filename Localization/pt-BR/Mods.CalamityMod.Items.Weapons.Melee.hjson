		'''
		[c/df4420:Um presente aos Demônios extraordinários, é uma réplica da espada usada pelo mais grandioso dos Lordes Demônio.]
		[c/df4420:A prosperidade que ele trouxe para a sua espécie é inigualável, até mesmo agora, quando apenas eles comandam o Submundo.]
		'''
}

OmegaBiomeBlade: {
	DisplayName: Verdadeira Lâmina do Bioma
	// See the attunement file for each attunement
	Tooltip:
		'''
		[FUNC]
		[PASS]
		Segurar <right> por 2 segundos sintoniza a arma com os poderes do bioma em sua volta
		Pressionar <right> por um período de tempo mais curto alterna as suas sintonizações ativas e passivas
		Sintonização Ativa: [ATT1]
		Sintonização Passiva: [ATT2]
		'''
	DefaultFunction:
		'''
		Não faz nada... ainda
		Parece que melhorar a lâmina expandiu o escopo das sintonizações anteriores
		'''
	DefaultPassive: A sua sintonização secundária agora pode fornecer efeitos passivos
}

Omniblade: {
	DisplayName: Omnilâmina
	Tooltip: Uma lâmina antiga forjada pelo lendário Omnir
}

Orderbringer: {
	DisplayName: O Ordeiro
	Tooltip:
		'''
		Dispara ondas de energia perfurantes e invoca quatro estrelas teleguiadas perto do cursor
		Acertos com a lâmina invocam dois feixes dos céus
		'Não importa onde você esteja, você nunca está sozinho'
		'''
}

Ozzathoth: {
	DisplayName: Ozzathoth
	Tooltip:
		'''
		{$Common.YoyoStatsInfinite}
		Dispara orbes cósmicos que atingem os inimigos próximos com lasers
		'Destrua o universo num piscar de olhos'
		'''
}

Pandemic: {
	DisplayName: Pandemia
	Tooltip:
		'''
		{$Common.YoyoStats}
		Cada inimigo único infectado com a [cbuff:CalamityMod/Plague] aumenta o tamanho, poder e tempo de duração do ioiô
		Reinicia a duração da [cbuff:CalamityMod/Plague] se o alvo já estiver infectado
		Contrapesos infligem a [cbuff:CalamityMod/Plague] e voam duas vezes mais rápido
		'''
}

PerfectDark: {
	DisplayName: Escuridão Perfeita
	Tooltip: Dispara uma bola vil que gruda nas peças e explode
}

PhosphorescentGauntlet: {
	DisplayName: Manopla Fosforescente
