VulcaniteLance: {
	DisplayName: Lança de Vulcanita
	Tooltip: Explode ao atingir o inimigo e invoca chamas teleguiadas em acertos críticos
}

WindBlade: {
	DisplayName: Lâmina do Vento
	Tooltip: Dispara ciclones que puxam os inimigos
}

WulfrumScrewdriver: {
	DisplayName: Chave de Fenda de Vulfrúmio
	Tooltip:
		'''
		Pode ser usado para rapidamente e regiamente aferir uma fenda nos inimigos
		Atacar um inimigo às vezes lhe dá um parafuso de vulfrúmio que você pode jogar pressionando <right>
		Atinja um parafuso arremessado com a chave de fenda para lançá-lo para frente em alta velocidade
		[c/83B87E:'Quem faz parafusos escareados deste tamanho?? Para que diabos devo usá-la?!]
		[c/83B87E:Ela poderia arrancar um olho!]
		[c/83B87E:...Ah.]
		'''
}

YateveoBloom: {
	DisplayName: Flor Yateveo
	Tooltip:
		'''
		Uma síntese da flora da selva
		Lança um poderoso mangual de rosa
		<right> para atacar com uma lança de flores
		'''
}

YinYo: {
	DisplayName: Yin-Iô
	Tooltip:
		'''
		Dispara fragmentos claros ou escuros quando os inimigos estão próximos
		Os fragmentos voam para frente e para trás
		Um ioiô muito ágil
		'''
}
