		'''
}

Riptide: {
	DisplayName: Correnteza
	Tooltip:
		'''
		{$Common.YoyoStats}
		Espalha uma espiral de fluxos d'água
		'''
}

Roxcalibur: {
	DisplayName: Excalirrocha
	// The WOF tag generates a new line above when placed at the start of a line
	Tooltip:
		'''
		[WOF]Segure <left> para carregar um ataque
		Libere com o cursor acima de você para balançar normalmente, liberando fragmentos de rocha
		Libere com o cursor abaixo de você para mergulhar para baixo e ricochetear de inimigos
		Mergulhar em blocos cria uma onda de choque
		Você não conseguia tirá-la da rocha, então você levou a rocha junto
		'''
	LockedInfo: A infernal Parede de Carne detém a chave para o poder desta arma
}

SaharaSlicers: {
	DisplayName: Fatiadores do Saara
	Tooltip:
		'''
		Um par de adagas duplas de curto alcance
		Atingir inimigos com as adagas lhe dará dois espinhos para cada acerto, até um limite de 10
		Pressionar <right> permitirá que você jogue espinhos coletados nos inimigos
		'''
}

SausageMaker: {
	DisplayName: Linguiçador
	Tooltip: Espalha sangue teleguiado no acerto
}

ScourgeoftheCosmos: {
	DisplayName: Tormento dos Cosmos
	Tooltip: Lança um tormento cósmico saltitante que emite pequenos clones teleguiados ao atingir inimigos e peças
}

SeashineSword: {
	DisplayName: Espada do Brilho dos Mares
	Tooltip: Atira um feixe de espada d'água
}

SeekingScorcher: {
	DisplayName: Chama Perseguidora
	Tooltip:
		'''
		Arremessa um machado cristalino enorme que ricocheteia de até três alvos adicionais depois do acerto
		Cristaliza no local se os ricochetes não forem esgotados
		Machadinhas	cristalizadas podem ser destruídas por outro machado
		Fazer isto fortalece a machadinha com base na quantidade destruída, mas impede que ela se cristalize
		'Que seus inimigos queimem no inferno pelos pecados que cometeram'
		'''
}

Shimmerspark: {
	DisplayName: Faísca Cintilante
	Tooltip:
		'''
		{$Common.YoyoStatsInfinite}
		Dispara estrelas quando os inimigos estão próximos
		'''
}

SkytideDragoon: {
	DisplayName: Dragão da Maré Celeste
	Tooltip:
		'''
		Chama um trovão para atingir e carregar a ponta da lança
		<left> para liberar raios consecutivos que se estreitam com o consumo de energia
		Segure o <right> quando a lança capturar o trovão para redirecioná-lo ao cursor
		'''
}

SmokingComet: {
	DisplayName: Cometa Fumegante
	Tooltip:
		'''
		{$Common.YoyoStats}
		Faz chover estrelas do céu
		'''
}

SolsticeClaymore: {
	DisplayName: Claymore do Solstício
	Tooltip:
		'''
		Muda a cor do projétil com base na época do ano
		Inflige [cbuff:CalamityMod/Daybroken] durante o dia e [cbuff:CalamityMod/Nightwither] durante a noite
		'''
}

SoulHarvester: {
	DisplayName: Ceifador de Almas
	Tooltip:
		'''
		Atira uma foice de alma
		Inimigos explodem quando estão com a vida baixa, espalhando a praga
		'''
}

SpineOfThanatos: {
	DisplayName: Coluna do Tânato
	Tooltip:
		'''
		Arremessa 3 chicotes metálicos rápidos para fora
		Quando os três colidirem, um prisma de luz é disparado para fora
		Se um inimigo estiver dentro da linha de visão dos chicotes na colisão, a luz dispersará em direção a ele
		'''
}

StarnightLance: {
	DisplayName: Lança da Estrela da Noite
	Tooltip: Dispara um feixe da estrela da noite frígido
}

StellarContempt: {
	DisplayName: Desprezo Estelar
	Tooltip:
		'''
		Lança um martelo pesado afetado pela gravidade que retornará para você após atingir um inimigo
		Acertos consecutivos chamarão mais chamas lunares do céu
		Depois de acertar cinco vezes, o martelo sobrecarrega com energia lunar para pulverizar o alvo
		'''
}

StellarStriker: {
	DisplayName: Atacante Estelar
	Tooltip: Invoca uma série de chamas lunares do céu ao atingir o inimigo
}

StormRuler: {
	DisplayName: Imperador das Tempestades
	Tooltip:
		'''
		Dispara feixes que geram tornados na morte
		Os tornados sugam os inimigos
		'Apenas uma tempestade pode derrubar um grande bosque'
		'''
}

StormSaber: {
	DisplayName: Sabre das Tempestades
	Tooltip:
		'''
		Dispara dois feixes de tempestade
		Um da lâmina e um do céu
		'''
}

StreamGouge: {
	DisplayName: Fluxo de Fissuras
	Tooltip:
		'''
		Invoca um portal que a lança atravessa
		Logo após atravessar o portal, portais aparecem perto do mouse que liberam cópias da lâmina cortante da lança
		Inimigos atingidos pelas cópias criam lacerações no espaço, relevando um fundo cósmico
		'''
}

StygianShield: {
	DisplayName: Escudo Estígio
	Tooltip:
		'''
		Segura <left> para carregar uma investida omnidirecional que atravessa os inimigos
		<right> para lançar um escudo que salta em direção a um inimigo próximo após a colisão
		Concede imunidade a recuos e {0} de defesa quando estiver sendo segurado
		No entanto, investidas são desativadas até que você pare de segurar essa arma por {1} segundos
		'''
}

SubmarineShocker: {
	DisplayName: Eletrocutador Submersível
	Tooltip: Inimigos liberam faíscas elétricas ao serem atingidos
}

SulphurousGrabber: {
	DisplayName: Agarrador Sulfuroso
	Tooltip:
		'''
		{$Common.YoyoStatsInfinite}
		Ocasionalmente libera um anel de bolhas coloridas
		O ioiô fica mais forte depois de tocar em uma bolha verde
		'''
}

Swordsplosion: {
	DisplayName: Espadexplosão
	Tooltip:
		'''
		Dispara várias espadas de feixe arco-íris que chovem do céu
		Barragem de espadas
		'''
}

TaintedBlade: {
	DisplayName: Lâmina Manchada
	Tooltip: Inflige [cbuff:Poisoned] ao atingir o inimigo
}

TeardropCleaver: {
	DisplayName: Cutelo Lacrimogêneo
	Tooltip: Faz seus inimigos chorarem
}

TenebreusTides: {
	DisplayName: Maré Tenebrosa
	Tooltip:
		'''
		Atira uma lança d'agua que perfura os inimigos e o terreno
		Atacar inimigos invoca lâminas e lanças líquidas para atacar o inimigo atingido
		'Inundatio ex Laminis'
		'''
}

Terratomere: {
	DisplayName: Terratomere
	Tooltip:
		'''
		Cura o jogador em acertos físicos verdadeiros
		Dispara vários raios de energia perfurantes que perseguem inimigos rapidamente
		No acerto, explode e corta repetidamente o alvo
		'Ligado à essência do Terraria'
		'''
}

TerrorBlade: {
	DisplayName: Lâmina do Terror
	Tooltip:
		'''
		Dispara um feixe de terror que salta em peças
		Em cada salto, ele emite uma explosão
		'''
}

TheBurningSky: {
	DisplayName: O Céu Flamejante
	Tooltip:
		'''
		Faz chover um fluxo de [cbuff:CalamityMod/Dragonfire] no cursor
		'Segure a lâmina aos céus, e testemunhe o Armagedom'
		'''
}

TheDarkMaster: {
	DisplayName: O Mestre Sombrio
	Tooltip:
		'''
		Dispara projéteis cortantes ecoantes vermelhos com a vida acima de 75%
		O dano do projétil aumenta com cada ponto de vida acima de 400
		<right> para invocar três clones das sombras em uma formação em Delta
		Os clones seguirão seus balanços de espadas e liberarão projéteis
		Os projéteis são disparados independentemente da sua própria vida, mas causam menos dano
		Os clones existirão apenas ao segurar essa arma
		'A lâmina pela qual as sombras lançam sobre seus inimigos um destino abominável'
		'''
}

TheGodsGambit: {
	DisplayName: O Gambito dos Deuses
	Tooltip:
		'''
		{$Common.YoyoStatsInfinite}
		Dispara um fluxo de geleia danosa quando os inimigos estão próximos
		'''
}

TheLastMourning: {
	DisplayName: O Luto Final
	Tooltip:
		'''
		Invoca abóboras flamejantes e crânios do luto
		As abóboras e crânios se dividem em orbes de fogo teleguiados ao atingir o inimigo
		'''
}

TheMicrowave: {
	DisplayName: O Micro-ondas
	Tooltip:
		'''
		{$Common.YoyoStatsInfinite}
		Frita os inimigos próximos com radiação e espalha a [cbuff:CalamityMod/AstralInfectionDebuff]
		'Cozinhando ao estilo Infecção Astral'
		'''
}

TheMutilator: {
	DisplayName: O Mutilador
	Tooltip:
		'''
		Atacar um inimigo fortalece o Mutilador, aumentando seu dano
		Com a carga completa, atacar um inimigo causa uma explosão de orbes de sangue
		{$Mods.CalamityModPTBR.Common.CollectBloodOrbs}
		'''
}

TheObliterator: {
	DisplayName: O Obliterador
	Tooltip:
		'''
		{$Common.YoyoStatsInfinite}
		[GFB]
		'''
	TooltipNormal:
		'''
		Ocasionalmente executa uma [ceffect/dog:Propulsão Dimensional] em miniatura em inimigos próximos
		Acertos com contrapesos iniciam outra [ceffect/dog:Propulsão Dimensional] imediatamente
		'''
	TooltipGFB: quanta poeira, meu Deus
}

TheOracle: {
	DisplayName: O Oráculo
	Tooltip:
		'''
		{$Common.YoyoStatsInfinite}
		Emite uma arma de relâmpâgos áuricos que é carregada conforme atinge os inimigos
		Dispara orbes áuricos quando está supercarregado
		'Contemple o passado, o presente, e o futuro... e as circunstâncias de sua morte inevitável'
		'''
}

TitanArm: {
	DisplayName: Braço de Titã
	Tooltip:
		'''
		Envia os inimigos direto para as estrelas na velocidade da luz
		Ponteiro do Dar um Tapa, só que melhor
		'''
}

TriactisTruePaladinianMageHammerofMight: {
	DisplayName: Verdadeiro Martelo-mágico Paladiniano do Poder de Triactis
	Tooltip:
		'''
		Lança um martelo afetado pela gravidade que retornará a você depois de atingir um inimigo
		Acertos com o martelo liberam chamas de luz prismática que orbitam o inimigo atingido
		Em vez de retornar, o quarto acerto transforma as chamas em martelos de luz dura
		Estes martelos martelos convergem em uma explosão universal que sempre causa acertos críticos
		'''
}

TrueArkoftheAncients: {
	DisplayName: Arca dos Anciões
	Tooltip:
		'''
		[PARRY]
		Uma lâmina celestial forjada para acabar com todo o mal
		'''
	ParryInfo:
		'''
		<right> para estender a Arca à sua frente
		Atingir um inimigo com ela irá causar uma aparada, concedendo-lhe uma breve invulnerabilidade
		Você também pode aparar projéteis para fazê-los causarem 30 a menos de dano por um curto período
		Aparar fortalecerá os próximos 10 ataques da espada, permitindo que ela lance projéteis mais fortes
		'''
}

TrueBiomeBlade: {
	DisplayName: Lâmina do Bioma
	// See the attunement file for each attunement
	Tooltip:
		'''
		[FUNC]
		Segure <right> parado em terreno plano para sintonizar a arma com os poderes do bioma em sua volta
		Caso contrário, pressionar <right> alterna entre a sintonização atual e uma adicional armazenada
		Sintonização Principal: [ATT1]
		Sintonização Secundária: [ATT2]
		'''
	DefaultFunction:
		'''
		Não faz nada... ainda
		Reparar a lâmina parece ter melhorado as suas capacidades de sintonização
		'''
}

TrueCausticEdge: {
	DisplayName: Lâmina Cáustica
	Tooltip:
		'''
		Dispara um feixe cáustico saltitante
		Inflige [cbuff:Venom] e desacelera o inimigo ao atingí-lo
		'''
}

Tumbleweed: {
	DisplayName: Arbusto Rolante
	Tooltip:
		'''
		Lança um mangual feito de um arbusto rolante
		Arbustos rolantes giratórios conjuram uma tempestade de poeira localizada
		Arbustos lançados lançados se soltam da corrente ao atingir um inimigo e rolam para frente
		'''
}

TyphonsGreed: {
	DisplayName: Ganância de Typhon
	Tooltip:
		'''
		Invoca espíritos d'água durante o uso
		Estes espíritos d'água seguirão os inimigos depois de viajar na direção do jogador
		'''
}

UltimusCleaver: {
	DisplayName: Cutelo Ultimus
	Tooltip: Lança faíscas teleguiadas danosas e explode ao atingir o inimigo
}

UrchinMace: {
	DisplayName: Maça do Ouriço-do-mar
	Tooltip:
		'''
		Lança um redemoinho quando liberado
		[c/5C95A1:'O povo do mar era hábil na caça, mas abominava a violência desnecessária.]
		[c/5C95A1:Infelizmente, as nações vizinhas eram brutais, por isso eles fabricaram suas armas de guerra.']
		'''
}

VanishingPoint: {
	DisplayName: Ponto de Fuga
	Tooltip: "[GFB]"
	TooltipNormal:
		'''
		Dispara um feixe de lança que se divide várias vezes conforme viaja
		'Rasgue o cosmos por completo!'
		'''
	TooltipGFB:
		'''
		Dispara um feixe de lança que se divide, tipo, MUITO mesmo. Muito mais do que deveria.
		'Rasgue o limite de projéteis por completo!'
		'''
}

VeinBurster: {
	DisplayName: Estourador de Veias
	Tooltip: Dispara uma bola de sangue que gruda nas peças e explode
}

Violence: {
	DisplayName: Violência
	Tooltip:
		'''
		Um garfo demoníaco, amaldiçoado a causar carnificina eterna
		<left> para comandar o tridente a seguir seu cursor e triturar os inimigos com sua velocidade devastadora
		<right> para arremessar o tridente e rasgar violentamente os inimigos com um poder imenso, infligindo [cbuff:CalamityMod/VulnerabilityHex]
		'''
}

Virulence: {
	DisplayName: Virulência
	Tooltip: Dispara uma nuvem da [cbuff:CalamityMod/Plague]
}

VoidEdge: {
	DisplayName: Lâmina do Vazio
	Tooltip:
		'''
		Dispara as almas horrendas de antigos habitantes do abismo
		Golpear com a lâmina invoca mais almas do subterrâneo
		'''
}

VulcaniteLance: {
	DisplayName: Lança de Vulcanita
	Tooltip: Explode ao atingir o inimigo e invoca chamas teleguiadas em acertos críticos
}

WindBlade: {
	DisplayName: Lâmina do Vento
	Tooltip: Dispara ciclones que puxam os inimigos
}

WulfrumScrewdriver: {
	DisplayName: Chave de Fenda de Vulfrúmio
	Tooltip:
		'''
		Pode ser usado para rapidamente e regiamente aferir uma fenda nos inimigos
		Atacar um inimigo às vezes lhe dá um parafuso de vulfrúmio que você pode jogar pressionando <right>
		Atinja um parafuso arremessado com a chave de fenda para lançá-lo para frente em alta velocidade
		[c/83B87E:'Quem faz parafusos deste tamanho?? Para que diabos devo usá-la?!]
		[c/83B87E:Dá pra arrancar um olho com ela!]
		[c/83B87E:...Ah.]
		'''
}

YateveoBloom: {
	DisplayName: Flor Yateveo
	Tooltip:
		'''
		Uma síntese da flora da selva
		Lança um poderoso mangual de rosa
		<right> para atacar com uma lança de flores
		'''
}

YinYo: {
	DisplayName: Yin-Iô
	Tooltip:
		'''
		{$Common.YoyoStatsInfinite}
		Dispara fragmentos claros ou escuros quando os inimigos estão próximos
		Os fragmentos voam para frente e para trás
		'''
}
