}

Oblivion: {
	DisplayName: Oblívio
	Tooltip:
		'''
		{$Common.YoyoStatsInfinite}
		Dispara dardos de enxofre quando os inimigos estão próximos
		'''
}

OldLordClaymore: {
	DisplayName: Claymore do Velho Lorde
	Tooltip: Uma lâmina poderosa, porém lenta que incendeia os inimigos e possui um recuo forte
