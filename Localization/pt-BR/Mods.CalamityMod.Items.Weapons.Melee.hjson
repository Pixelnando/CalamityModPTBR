		'''
		[c/b63cd1:A blade forged in the likeness of that granted to the Demon Lord.]
		[c/b63cd1:The title was coveted by all demonkind. Only one may exist at a time.]
		[c/b63cd1:Any claimant who seeks the throne has a simple goal: the head of the former Lord.]
		''' */
}

ForsakenSaber: {
	DisplayName: Sabre Abandonado
	Tooltip: Dispara duas lâminas de areia que alteram a velocidade à medida que viajam
}

FourSeasonsGalaxia: {
	DisplayName: Galáxia
	// See the attunement file for each attunement
	Tooltip:
		'''
		[FUNC]
		[PASS]
		Livre das algemas terrenas e fluindo com poder cósmico
		Tem acesso a todas as sintonizações a todo momento
		<right> para alternar a sintonização da espada dependendo da posição do 
		Sintonização Ativa: [ATT]
		Bênção Passiva: [BLE]
		'''
}

FracturedArk: {
	DisplayName: Arca Fraturada
	Tooltip:
		'''
		[PARRY]
		Uma lâmina desgastada e enferrujada uma vez empunhada contra o mal deste mundo, pronta para ser usada mais uma vez
		'''
	ParryInfo:
		'''
		<right> para estender a Arca à sua frente
		Atingir um inimigo com ela aparará-lo, concedendo-lhe um curto período de invulnerabilidade
		Você pode aparar projéteis para fazê-los causarem 50 a menos de dano temporariamente
		Aparar fortalecerá os próximos 10 ataques da espada, aumentando o dano e permitindo que ela lance projéteis
		'''
}

GaelsGreatsword: {
	DisplayName: Montante de Gael
	Tooltip:
		'''
		O primeiro balanço dispara crânios teleguiados
		O segundo balanço atira um crânio gigante e poderoso
		O terceiro balanço não tem projéteis
		Gera fúria constantemente quando em uso
		Ataques deixam trilhas de sangue quando estiver com menos de 50% de vida
		Ocasionalmente invoca uma barragem de relâmpagos quando estiver com menos de 50% de vida
		Substitui o Modo Fúria com uma barragem enorme de crânios
		Esse ataque tem um tempo de recarga de 30 segundos
		'Passe para cá, essa coisa. Sua alma sombria'
		'''
}

GalactusBlade: {
	DisplayName: Lâmina de Galactus
	Tooltip:
		'''
		Lança uma barragem de cometas do céu
		Forjada com a fúria do caos nuclear
		'''
}

GalaxySmasher: {
	DisplayName: Esmagador de Galáxias
	Tooltip:
		'''
		Lança um martelo pesado afetado pela gravidade que retornará para você após atingir um inimigo
		Acertos consecutivos invocam mais martelos cósmicos
		Depois de atingir oito vezes, o martelo se sobrecarrega com energias galácticas,
		liberando um ataque apocalíptico que reverbera através do espaço e do tempo
		'''
}

GalileoGladius: {
	DisplayName: Galileo Gladius
	Tooltip:
		'''
		Dispara uma lua crescente teleguiada
		Invoca planetóides ao atingir o inimigo
		'Não subestime o poder das pequenas espadas espaciais'
		'''
}

GeliticBlade: {
	DisplayName: Espada Gelítica
	Tooltip: Dispara uma onda de gel que desacelera o inimigo ao atingí-lo
}

GildedProboscis: {
	DisplayName: Probóscide Dourada
	Tooltip: Cura o jogador no acerto
}

GoldplumeSpear: {
	DisplayName: Lança de Plumas Douradas
	Tooltip: Dispara penas que caem
}

