AbsoluteZero: {
	DisplayName: Zero Absoluto
	Tooltip:
		'''
		Dispara cristais de gelo escuros
		A lâmina cria explosões de gelo em acertos diretos
		Lâmina de gelo antiga imbuída com a magia do Arquimago de Gelo
		'''
}

AbyssBlade: {
	DisplayName: Lâmina do Abismo
	Tooltip:
		'''
		Lança uma espada abissal giratória que corta os inimigos e libera energia aquática ao atingir uma peça
		A espada voará na direção dos inimigos depois de um ricochete, causando 2x o dano
		'''
}

AcidwoodSword: {
	DisplayName: Espada de Madeira Ácida
	Tooltip: ""
}

AegisBlade: {
	DisplayName: Lâmina da Égide
	Tooltip:
		'''
		Atacar um inimigo com a lâmina causa uma erupção terrestre
		<right> para disparar um raio da égide
		'''
}

AirSpinner: {
	DisplayName: Rotador Aéreo
	Tooltip:
		'''
		{$Common.YoyoStats}
		Dispara penas quando os inimigos estão próximos
		'''
}

AmidiasTrident: {
	DisplayName: Tridente de Amidias
	Tooltip: Dispara redemoinhos teleguiados
}

AnarchyBlade: {
	DisplayName: Lâmina da Anarquia
	Tooltip:
		'''
		Quanto menor for a sua vida, mais danos esta lâmina causa
		Seus acertos irão gerar uma grande explosão
		Se você estiver com menos de 50% de vida, seus acertos podem matar inimigos normais instantaneamente
		'''
}

Aorta: {
	DisplayName: Aorta
	Tooltip:
		'''
		{$Common.YoyoStats}
		Dispara sangue teleguiado quando os inimigos estão próximos
		'''
}

ArkoftheCosmos: {
	DisplayName: Arca do Cosmos
	Tooltip:
		'''
		[COMBO]
		[PARRY]
		[BLAST]
		A culminação física de sua jornada, capaz de rasgar deuses em pedaços
		'''
	ComboInfo:
		'''
		<left> para executar um combo de 5 golpes que termina com o arremesso da lâmina
		A lâmina arremessada seguirá seu cursor
		Soltar o ataque enquanto a lâmina estiver fora causará um estalo explosivo
		'''
	ParryInfo:
		'''
		<right> para cortar as lâminas de tesoura na sua frente
		Atingir um inimigo com elas irá causar uma aparada, concedendo-lhe uma invulnerabilidade breve
		Você pode aparar projéteis para fazê-los causarem 120 a menos de dano por um curto período
		Aparar qualquer coisa fortalecerá os próximos 16 ataques da espada
		'''
	BlastInfo: <right> duas vezes com cargas disponíveis para provocar um Grande Rasgo no espaço-tempo e usar todas as cargas
	// BlastInfoKeybind: Press [KEY] with charges available to cause a Big Rip in spacetime and consume all charges
}

ArkoftheElements: {
	DisplayName: Arca dos Elementos
	Tooltip:
		'''
		[COMBO]
		[PARRY]
		Um par de lâminas infundidas com a essência do Terraria, poderosas o suficiente para cortar o tecido da realidade
		'''
	ComboInfo:
		'''
		<left> para executar um combo de 5 golpes que termina com o arremesso da lâmina
		Soltar o ataque enquanto a lâmina estiver fora causará dano adicional
		'''
	ParryInfo:
		'''
		<right> para cortar as lâminas de tesoura na sua frente
		Atingir um inimigo com elas irá causar uma aparada, concedendo-lhe uma invulnerabilidade breve
		Você pode aparar projéteis para fazê-los causarem 60 a menos de dano por um curto período
		Aparar fortalecerá os próximos 10 ataques da espada, permitindo que você use as duas lâminas ao mesmo tempo
		'''
}

AstralPike: {
	DisplayName: Lança Astral
	Tooltip: Invoca barragens de estrelas astrais que espalham a [cbuff:CalamityMod/AstralInfectionDebuff] em acertos críticos
}

AstralScythe: {
	DisplayName: Foice Astral
	Tooltip: Dispara um anel de foice que acelera com o tempo e espalha a [cbuff:CalamityMod/AstralInfectionDebuff]
}

Ataraxia: {
	DisplayName: Ataraxia
	Tooltip: Equanimidade
}

Avalanche: {
	DisplayName: Avalanche
	Tooltip:
		'''
		Atingir o inimigo gera bombas de gelo orbitantes
		Depois de 2 segundos, as bombas de gelo explodem em fragmentos de gelo
		'''
}

BalefulHarvester: {
	DisplayName: Ceifeiro Sinistro
	Tooltip:
		'''
		Uma foice flamejante que é balançada três vezes em rápida sucessão ao seu redor
		Invoca crânios flamejantes que se dividem em orbes de fogo teleguiados ao atingir o inimigo
		'''
}

BallOFugu: {
	DisplayName: Pelota de Baiacu
	Tooltip:
		'''
		Lança um baiacu abissal descontrolado
		Acumula espinhos venenosos conforme gira
		Os espinhos são expelidos do peixe quando ele se retrai
		'''
}

BansheeHook: {
	DisplayName: Gancho das Almas Penadas
	Tooltip: Balança um gancho de almas penadas que dispara lâminas e explode ao atingir o inimigo
}

Basher: {
	DisplayName: Espancador
	Tooltip: Balança um porrete podre enquanto te empurra
}

BladecrestOathsword: {
	DisplayName: Lâmina da Crista do Juramento
	Tooltip:
		'''
		Arremessa uma lâmina afiada que empala e desacelera os inimigos
		Até três lâminas podem empalar um inimigo por vez
		Acertos consecutivos além dos três primeiros arrancarão as lâminas já empaladas
		'''
	HoldShiftTooltip:
		'''
		[c/df0049:Uma lâmina de ritual usada pelos Demônios em seus sacrifícios.]
		[c/df0049:Quanto mais sangue mancha a lâmina, mais afiada ela se torna.]
		'''
}

BlightedCleaver: {
	DisplayName: Cutelo Arruinado
	Tooltip: Dispara lâminas flamejantes teleguiadas
}

Bonebreaker: {
	DisplayName: Quebra-ossos
	Tooltip:
		'''
		Dispara azagaias que grudam nos inimigos antes de explodir em estilhaços
		Azagaias presas infligem vários efeitos negativos
		'''
}

BotanicPiercer: {
	DisplayName: Perfurador Botânico
	Tooltip: Dispara um feixe de energia botânico
}

Brimlance: {
	DisplayName: Enxolança
	Tooltip: Cria explosões de [cbuff:CalamityMod/BrimstoneFlames] ao atingir o inimigo
}

Brimlash: {
	DisplayName: Cortador de Enxofre
	Tooltip: Dispara um raio de enxofre que explode em mais raios no acerto
}

BrimstoneSword: {
	DisplayName: Espada de Enxofre
	Tooltip:
		'''
		Invoca gêiseres de [cbuff:CalamityMod/BrimstoneFlames] no acerto
		<right> para lançar a espada como uma azagaia que explode no acerto
		'''
}

BrinyBaron: {
	DisplayName: Lâmina Salgada
	Tooltip:
		'''
		Atacar um inimigo com a lâmina faz com que um tufão salgado apareça
		<right> para disparar uma lâmina de água de vento cortante
		'''
}

BrokenBiomeBlade: {
	DisplayName: Lâmina do Bioma Quebrada
	// See the attunement file for each attunement
	Tooltip:
		'''
		[FUNC]
		Segure <right> parado em terreno plano para sintonizar a arma com os poderes do bioma em sua volta
		Caso contrário, pressionar <right> alterna entre a sintonização atual e uma adicional armazenada
		Sintonização Principal: [ATT1]
		Sintonização Secundária: [ATT2]
		'''
	DefaultFunction: Não faz nada... ainda
}

BurningRevelation: {
	DisplayName: Relevação Ardente
	Tooltip:
		'''
		{$Common.YoyoStatsInfinite}
		Um ioiô com uma chama incessante que sempre carrega poder
		Acertos diretos aumentam muito a carga e liberam energia profana que escala com o nível da carga
		Com a carga completa, o ioiô desencadeia uma barragem de estrelas teleguiadas que causam mais dano conforme viajam
		Estrelas com o dano máximo liberam uma explosão adicional no acerto
		'Queima, mas você a mantém perto do teu coração. Claridade e propósito preenchem a tua alma'
		'''
}

BurntSienna: {
	DisplayName: Sienna Queimada
	Tooltip: Faz com que os inimigos explodam em projéteis de cura na morte
}

Carnage: {
	DisplayName: Carnificina
	Tooltip: Inimigos explodem em sangue teleguiado na morte
}

CelestialClaymore: {
	DisplayName: Claymore Celestial
	Tooltip: Invoca estrelas de energia cósmica perto do cursor
}

ClamCrusher: {
	DisplayName: Ostra Esmagadora
	Tooltip:
		'''
		Lança uma ostra enorme que [cbuff:CalamityMod/Eutrophication], atordoando os inimigos por um curto período de tempo
		Começa a ser afetado pela gravidade e causa muito mais danos depois de estar no ar por um tempo
		'''
}

CometQuasher: {
	DisplayName: Esmagador de Cometas
	Tooltip: Invoca uma chuva de meteoros do céu ao atingir o inimigo
}

CosmicDischarge: {
	DisplayName: Descarga Cósmica
	Tooltip:
		'''
		Atingir um inimigo com o chicote causa explosões glaciais e concede ao jogador o efeito [cbuffplr:CalamityMod/CosmicFreeze]
		[cbuffplr:CalamityMod/CosmicFreeze] dá ao jogador regen. de +2 de vida/s enquanto está parado e congela os inimigos perto do jogador
		'''
}

CosmicShiv: {
	DisplayName: Faca Cósmica
	Tooltip:
		'''
		Dispara uma estrela cósmica que persegue os inimigos
		Ao atingir um inimigo, uma barragem de lâminas golpeará constantemente
		Acertar mais estrelas faz com que mais lâminas ataquem
		'''
}

CrescentMoon: {
	DisplayName: Lua Crescente
	Tooltip:
		'''
		Arremessa um mangual lunar que libera luas teleguiadas no retorno
		Segurar <left> gira o mangual ao seu redor, gerando Explosões Estelares
		Com 20 Explosões Estelares, segure <left> novamente depois de arremessar o mangual para explodí-lo
		Esta explosão deixa de liberar luas para invocar Scorpius, que causa muito dano e inflige [cbuff:CalamityMod/Voidfrost]
		'Loucura derivada da genialidade'
		'''
}

DarklightGreatsword: {
	DisplayName: Montante de Umbraluz
	Tooltip: Dispara lâminas de umbraluz que cortam os inimigos e criam cortes adicionais
}

DeathsAscension: {
	DisplayName: Ascensão da Morte
	Tooltip:
		'''
		Executa golpes anímicos poderosos que criam uma fenda orbitada por foices no acerto
		<right> para lançar uma barragem de foices teleguiadas
		A fenda disparará foices com você
		'Sua empunhadura parece encaixar perfeitamente...
		[c/660066:Mas as mãos que a empunham não são tuas']
		'''
}

DefiledGreatsword: {
	DisplayName: Montante Profano
	Tooltip: Dispara lâminas ardentes, hiper e solares
}

DepthCrusher: {
	DisplayName: Triturador das Profundezas
	Tooltip:
		'''
		Lança um triturador abissal pesado que libera energia aquática ao atingir uma peça
		O triturador irá ricochetear de peças e inimigos
		'''
}

DevilsDevastation: {
	DisplayName: Devastação do Diabo
	Tooltip:
		'''
		Arremesse uma lâmina demoníaca que empala, imola e desacelera os inimigos
		Até cinco lâminas podem empalar um inimigo por vez, e acertos sucessivos lançarão as lâminas já empaladas
		Aperte <right> para assumir uma postura que permite o uso de <left> para fazer uma investida colossal e devastadora
		Na postura, você ganha regeneração de vida e tempo de voo e suas investidas têm um tempo de recarga menor
		O corte devastador deve ser recarregado após o uso
		Golpear um inimigo empalado com o corte devastador lança todas as lâminas e prepara outro corte
		Uma marca da morte é aplicada no último inimigo atingido pelo corte devastador
		Ao sair da postura, a marca da morte explode, causando muito dano
		'''
	HoldShiftTooltip:
		'''
		[c/d13ca2:A lâmina perfeita do Submundo, contendo diretamente o poder do Enxofre.]
		[c/d13ca2:Os humanos conhecem esta força como Caos, a ruptura inevitável da ordem no fogo.]
		[c/d13ca2:Talvez fosse por isso que a Elemental de Enxofre possuía uma força inigualável entre suas irmãs.]
		'''
}

DevilsSunrise: {
	DisplayName: Nascer do Sol do Diabo
	Tooltip:
		'''
		Libera uma enxurrada de golpes diabólicos
		Energia diabólica é carregada nas lâminas com o tempo, e este processo é acelerado ao atacar inimigos
		Aperte <right> enquanto balança as lâminas com energia completa para lançar as lâminas giratórias no seu cursor
		As lâminas giratórias fincam-se e cortam repetidamente o primeiro alvo encontrado, roubando sua vida
		'Bolas? Pequenas.'
		'''
}

DraconicDestruction: {
	DisplayName: Destruição Dracônica
	Tooltip:
		'''
		Dispara um feixe de espada dracônico que explode em feixes adicionais
		Feixes adicionais voam para cima e para baixo para destruir os inimigos
		'''
}

DragonPow: {
	DisplayName: Poder do Dragão
	Tooltip:
		'''
		Dispara uma cabeça de dragão que libera faíscas de [cbuff:CalamityMod/Dragonfire]
		Invoca uma barragem de pétalas e cachoeiras ao atingir o inimigo
		'''
}

DragonRage: {
	DisplayName: Raiva do Dragão
	Tooltip:
		'''
		Gira um bastão que causa explosões de [cbuff:CalamityMod/Dragonfire] atingir o inimigo
		A cada dois segundos, acertar o inimigo invoca um anel de bolas de fogo que focam o inimigo com mais vida
		'''
}

DriftwoodSword: {
	DisplayName: Espada de Madeira à Deriva
	Tooltip: Esta espada é mais forte enquanto você está molhado
}

Earth: {
	DisplayName: Terra
	Tooltip:
		'''
		Uma lâmina prismática com uma proficiência de combate corpo-a-corpo imbatível
		Fornece a você uma cura forte no acerto
		Cada segundo golpe invocará três meteoros Gaia para aniquilar inimigos próximos
		'Toda Sua prole conhecerá a beleza e a ira de sua criadora'
		'''
}

EarthenPike: {
	DisplayName: Lança Terrestre
	Tooltip: Espalha fragmentos de fóssil no uso
}

EmpyreanKnives: {
	DisplayName: Facas Empíricas
	Tooltip: Lança uma enxurrada de facas teleguiadas que ricocheteiam de peças e curam o usuário
}

EntropicClaymore: {
	DisplayName: Claymore Entrópica
	Tooltip:
		'''
		Dispara uma série de plasma vivo que nada pelo ar
		O plasma perseguirá o cursor ou os inimigos próximos dele, priorizando o mais próximo
		O plasma perfura, mas não perseguirá mais depois de atingir um inimigo
		'''
}

EssenceFlayer: {
	DisplayName: Esfolador de Essências
	Tooltip: Atira uma foice de essência que gera espíritos de cura ao matar o inimigo
}

EvilSmasher: {
	DisplayName: Esmagador do Mal
	Tooltip:
		'''
		Canaliza um golpe de martelo poderoso com a capacidade de esmagar todo o mal
		Golpear uma peça com o golpe de martelo causará uma explosão e o repelirá
		Golpear inimigos inflige [cbuff:CalamityMod/SmashedEvil] no usuário e no alvo
		Carregar um golpe aumenta o dano, raio de explosão e a duração do [cbuff:CalamityMod/SmashedEvil]
		'MAl! eSMagAR o mAL! EsmAga...DOR!'
		'''
	//All damage and kill dialogue has the capitalization randomized when said
	DamageDialogue0: esmaga!
	DamageDialogue1: mal!
	DamageDialogue2: tritura!
	DamageDialogue3: des.. trói!
	KillDialogue0: esmagar o mal!
	KillDialogue1: esmaga.. dor!
}

ExaltedOathblade: {
	DisplayName: Lâmina do Juramento Exaltada
	Tooltip:
		'''
		Arremesse uma lâmina distorcida que empala, imola e desacelera os inimigos
		Até quatro lâminas podem empalar um inimigo por vez, e acertos sucessivos lançarão as lâminas já empaladas
		Aperte <right> para assumir uma postura que permite o uso de <left> para fazer uma investida devastadora
		Na postura, você ganha regeneração de vida e tempo de voo e suas investidas têm um tempo de recarga menor
		O corte devastador deve ser recarregado após o uso
		Golpear um inimigo empalado com o corte devastador lança todas as lâminas e prepara outro corte
		'''
	HoldShiftTooltip:
		'''
		[c/b63cd1:Uma espada forjada a partir da lenda do Último Lorde Demônio.]
		[c/b63cd1:Coroado por seu poder avassalador, sua espada banhada no sangue de Demônios e nas chamas do inferno.]
		[c/b63cd1:Mesmo muito tempo depois de sua morte, ninguém se atreveu a ocupar aquele lugar.]
		[c/b63cd1:Desde então, o povo dos Demônios não conheceu mais a unidade.]
		'''
}

Exoblade: {
	DisplayName: Lâmina Exo
	Tooltip:
		'''
		<left> para liberar vários feixes de energia que seguem os inimigos e os cortam ao atingí-los
		<right> para fazer uma investida na direção do cursor com a lâmina
		Atingir inimigos com a lâmina durante a investida resulta em dano massivo e um ricochete
		<left> imediatamente após um ricochete para executar um corte poderoso
		Os cortes poderosos são maiores, te curam e criam uma explosão enorme
		Inimigos atingidos são dilacerados pela [cbuff:CalamityMod/MiracleBlight]
		'''
}

FallenPaladinsHammer: {
	DisplayName: Martelo do Paladino Caído
	Tooltip:
		'''
		Lança um martelo pesado afetado pela gravidade que retornará para você após atingir um inimigo
		Depois de retornar três vezes, um martelo espectral teleguiado é invocado com impacto devastador
		'''
}

FaultLine: {
	DisplayName: Linha de Colapso
	Tooltip:
		'''
		{$Common.YoyoStatsInfinite}
		Explode ao atingir o inimigo
		'''
}

FeralthornClaymore: {
	DisplayName: Claymore de Espinhos Selvagens
	Tooltip: Invoca espinhos ao atingir o inimigo
}

FlarefrostBlade: {
	DisplayName: Lâmina Quente-fria
	Tooltip: Dispara um orbe quente-frio teleguiado
}

Floodtide: {
	DisplayName: Maré Inundante
	Tooltip: Dispara tubarões, porque tubarões são fantásticos!
}

ForbiddenOathblade: {
	DisplayName: Lâmina do Juramento Proibído
	Tooltip:
		'''
		Arremesse uma lâmina afiada que empala, queima e desacelera os inimigos
		Até três lâminas podem empalar um inimigo por vez, e acertos sucessivos lançarão as lâminas já empaladas
		<right> para assumir uma postura que permite o uso de <left> para fazer uma investida poderosa
		O corte poderoso deve ser recarregado após o uso
		Golpear um inimigo empalado com o corte poderoso lança todas as lâminas e prepara outro corte
		'''
	HoldShiftTooltip:
		'''
		[c/b63cd1:Uma lâmina forjada à imagem daquela concedida ao Lorde dos Demônios.]
		[c/b63cd1:O título era cobiçado por toda a raça demoníaca. Apenas um pode existir por vez.]
		[c/b63cd1:Qualquer pretendente ao trono tem um objetivo simples: a cabeça do antigo Lorde.]
		'''
}

ForsakenSaber: {
	DisplayName: Sabre Abandonado
	Tooltip: Dispara duas lâminas de areia que alteram a velocidade à medida que viajam
}

FourSeasonsGalaxia: {
	DisplayName: Galáxia
	// See the attunement file for each attunement
	Tooltip:
		'''
		[FUNC]
		Livre das algemas terrestres e fluindo com poder cósmico
		Tem acesso a todas as sintonizações a todo momento
		<right> para alternar a sintonização da espada dependendo da posição do cursor
		Sintonização Ativa: [ATT]
		'''
}

FracturedArk: {
	DisplayName: Arca Fraturada
	Tooltip:
		'''
		[PARRY]
		Uma lâmina desgastada e enferrujada uma vez empunhada contra o mal deste mundo, pronta para ser usada mais uma vez
		'''
	ParryInfo:
		'''
		<right> para estender a Arca à sua frente
		Atingir um inimigo com ela aparará-lo, concedendo-lhe um curto período de invulnerabilidade
		Aparar fortalecerá os próximos 10 ataques da espada, aumentando o dano e permitindo que ela lance projéteis
		'''
}

GaelsGreatsword: {
	DisplayName: Montante de Gael
	Tooltip:
		'''
		O primeiro balanço dispara crânios teleguiados
		O segundo balanço atira um crânio gigante e poderoso
		O terceiro balanço não tem projéteis
		Gera fúria constantemente quando em uso
		Ataques deixam trilhas de sangue quando estiver com menos de 50% de vida
		Ocasionalmente invoca uma barragem de relâmpagos quando estiver com menos de 50% de vida
		Substitui o Modo Fúria com uma barragem enorme de crânios
		Esse ataque tem um tempo de recarga de 30 segundos
		'Passe para cá, essa coisa. Sua alma sombria'
		'''
}

GalactusBlade: {
	DisplayName: Lâmina de Galactus
	Tooltip:
		'''
		Lança uma barragem de cometas do céu
		Forjada com a fúria do caos nuclear
		'''
}

GalaxySmasher: {
	DisplayName: Esmagador de Galáxias
	Tooltip:
		'''
		Lança um martelo pesado afetado pela gravidade que retornará para você após atingir um inimigo
		Acertos consecutivos invocam mais martelos cósmicos
		Depois de atingir oito vezes, o martelo se sobrecarrega com energias galácticas,
		liberando um ataque apocalíptico que reverbera através do espaço e do tempo
		'''
}

GalileoGladius: {
	DisplayName: Galileo Gladius
	Tooltip:
		'''
		Golpeia rapidamente na frente do jogador, gerando Explosões Estelares no acerto
		<right> para lançar o gládio em uma corrente de constelações, empalando inimigos e infligindo [cbuff:CalamityMod/Voidfrost]
		Quando a lâmina é empalada, use <left> ou <right> para liberá-la
		<left> arranca a lâmina e causa muito dano, consumindo 10 Explosões Estelares
		<right> puxa você à lâmina, permitindo que pule do inimigo
		Pular de um inimigo consome 20 Explosões Estelares e fornece invencibilidade
		'Fígaro, magnífico'
		'''
}

GeliticBlade: {
	DisplayName: Espada Gelítica
	Tooltip: Dispara uma onda de gel veloz que acelera ao atingir um inimigo e o cobre com [cbuff:Slimed]
}

GildedProboscis: {
	DisplayName: Probóscide Dourada
	Tooltip:
		'''
		Rouba vida proporcional ao dano causado ao inimigo
		<left> para carregar um golpe preciso
		O golpe começa fraco, mas se torna mais forte conforme é segurado
		<right> para fazer uma investida para frente e golpear para cima
		A distância da sua investida depende da direção segurada durante a execução
		{$Mods.CalamityModPTBR.Common.AlwaysCriticalStrike}
		'''
}

GoldplumeSpear: {
	DisplayName: Lança de Plumas Douradas
	Tooltip: Dispara penas que caem
}

GrandDad: {
	DisplayName: Paizão
	Tooltip: "[GFB]"
	TooltipNormal:
		'''
		Uma lâmina de peso inimaginável que rasga os inimigos com sua enorme massa
		Fornece cura com o tempo a você e a todos os aliados próximos no acerto
		Atingir inimigos que estão com vida baixa os lançará com uma força enorme
		Inimigos lançados morrem na hora do impacto com paredes e chãos
		[c/00B8DF:'Como que você tá balançando essa coisa com metade da massa de uma estrela?']
		'''
	TooltipGFB:
		'''
		Uma lâmina antiga que continua funcionando porque antigamente faziam direito
		Atingir inimigos com pouca vida fará eles voarem mais longe que uma ida para a escola antigamente
		Inimigos lançados aprenderão uma lição quando encontrarem uma parede ou o chão
		[c/00B8DF:'Confia no pai.']
		'''
}

GrandGuardian: {
	DisplayName: Grande Guardião
	Tooltip:
		'''
		Uma lâmina alada e ornamentada que corta facilmente os inimigos
		Cria explosões cósmicas e fornece uma cura leve no acerto
		'''
}

GreatswordofJudgement: {
	DisplayName: Montante do Julgamento
	Tooltip:
		'''
		Dispara uma onda de energia perfurante que libera estrelas teleguiadas conforme voa
		Acertos com a lâmina invocam duas estrelas mais fortes atrás de você
		'''
}

Greentide: {
	DisplayName: Maré Verde
	Tooltip:
		'''
		Lança uma série de quatro dentes com um dente poderoso e perfurante no centro
		Acertos com a lâmina criam duas mandíbulas cheias de dentes que mordem o inimigo mais próximo do cursor
		'''
}

HellfireFlamberge: {
	DisplayName: Flamberge do Fogo Infernal
	Tooltip: Dispara uma série de bolas de fogo vulcânicas
}

HellionFlowerSpear: {
	DisplayName: Lança da Flor Selvagem
	Tooltip:
		'''
		Dispara uma ponta de lança de flores
		Invoca pétalas do céu em acertos críticos
		'''
}

Hellkite: {
	DisplayName: Espada do Fogo Cruel
	Tooltip: "[GFB]"
	TooltipNormal:
		'''
		Uma espada antiga criada durante a Era Dracônica pelo mestre ferreiro mais habilidoso de Azafure
		Balança uma espada pesada e lenta que conta com um recuo poderoso
		Segurar <right> começará a carregar um golpe fortalecido
		Soltar <right> com a carga completa liberará um corte devastador que sempre causa um acerto crítico
		[c/E1B65F:'Sinta a força de uma lâmina forjada através da paixão']
		'''
	TooltipGFB:
		'''
		Uma espada antiga criada durante a Era Dracônica pelo mestre ferreiro mais habilidoso de Azafure
		Balança uma espada pesada e lenta que conta com um recuo poderoso
		Segurar <right> começará a carregar um golpe fortalecido
		Soltar <right> com a carga completa liberará um corte devastador que sempre causa um acerto crítico
		[c/0C507F:'Minha Amada <3' -Xyk]
		'''
}

HolyCollider: {
	DisplayName: Colisor Sagrado
	Tooltip:
		'''
		Balança um montante sagrado que pode ser carregado para causar mais dano
		Golpes carregados criam quatro chamas duradouras que flutuam ao redor do ponto de impacto
		Atingir uma chama com um golpe não carregado a empurrará e estenderá seu tempo de vida
		Golpes carregados podem transformar as chamas em bolas de fogo enormes que são lançadas ao cursor
		'''
}

IllustriousKnives: {
	DisplayName: Facas Ilustres
	Tooltip: Lança uma série de facas velozes e teleguiadas que curam o usuário
}

InsidiousImpaler: {
	DisplayName: Empalador Insidioso
	Tooltip:
		'''
		Lança arpões radioativos autopropulsados que perseguem os inimigos
		Os arpões ricocheteiam em queima-roupa para atingir mais vezes
		'''
}

Lacerator: {
	DisplayName: Dilacerador
	Tooltip:
		'''
		{$Common.YoyoStatsInfinite}
		Conjura uma serra sangrenta para triturar o inimigo atingido
		A serra causa mais dano conforme o ioiô atinge mais vezes, e desaparece quando deixa de atacar o inimigo
		Inimigos que enconstam nos cantos da serra têm orbes de sangue arrancados deles
		{$Mods.CalamityModPTBR.Common.CollectBloodOrbs}
		A direção de rotação da serra depende da direção que o ioiô foi lançado originalmente[GFB]
		'''
	GFBFlavor: "[c/ff0a0a:Talvez seja viável contra o Devorador de Deuses...]"
}

LifehuntScythe: {
	DisplayName: Foice Caça-à-vida
	Tooltip: Dispara uma foice energizada que fornece cura no acerto
}

Lightspeed: {
	DisplayName: Vapite-vupite
	Tooltip:
		'''
		[c/c7f5ff:Libere uma enxurrada de golpes que acumulam Maestria Elemental no acerto]
		[c/c2fff2:A Maestria Elemental é perdida com o tempo se não for acumulada em alguns segundos]
		[c/ffdfba:<right> com a Maestria Elemental completa para fazer uma investida na direção do cursor]
		[c/ffc7c7:Atingir um inimigo durante a investida recupera um pouco de Maestria Elemental]
		'''
}

LionHeart: {
	DisplayName: Coração de Leão
	Tooltip:
		'''
		Invoca uma explosão de energia no acerto
		<right> para invocar um escudo de energia por alguns segundos que corta todas as fontes de dano pela metade
		Isto tem um tempo de recarga de 45 segundos
		'''
}

Lucrecia: {
	DisplayName: Lucrecia
	Tooltip:
		'''
		[c/9370db:Dispara um fragmento de luz sombria quando balançada]
		[c/837ce4:Acertos com a espada acumulam Energia Umbraluminosa]
		[c/7489ee:A Energia Umbraluminosa é perdida com o tempo se não for recebida em alguns segundos]
		[c/6495f7:<right> com energia completa para disparar um cometa em forma de dupla hélice]
		'''
}

MajesticGuard: {
	DisplayName: Guarda Majestosa
	Tooltip:
		'''
		Uma lâmina complexa, pesada o suficiente para esmagar tudo o que não conseguir cortar
		      Repele os inimigos com força e te cura um pouco no acerto
		'''
}

MantisClaws: {
	DisplayName: Garras de Tamarutaca
	Tooltip:
		'''
		Balance rapidamente uma garra de tamarutaca que corta alvos no corpo-a-corpo
		<right> para formar uma bolha pressurizada na sua frente
		Quando formada por completo, a bolha é esmagada, esguichando alvos com um jato d'água
		'Camarão que dorme, a onda leva'
		'''
}

MawOfInfinity: {
	DisplayName: Mandíbula da Eternidade
	Tooltip:
		'''
		Balança uma lâmina forjada da mandíbula do Devourador em um combo de três golpes
		O primeiro golpe atinge corpo-a-corpo
		O segundo golpe lança um [ceffect/dog:Incinerador da Fé]
		O terceiro golpe libera o [ceffect/dog:Devorador de Divindades] no cursor, explodindo e causando muito dano
		'''
}

MirrorBlade: {
	DisplayName: Lâmina Espelhada
	Tooltip:
		'''
		Golpear um inimigo ou projétil hostil invoca até 10 fragmentos de espelho em órbita
		Fragmentos adicionais perseguem os inimigos
		Segurar o <right> faz os fragmentos de espelho em órbita se unirem em forma de escudo
		'''
	HoldShiftTooltip:
		'''
		[c/aab7f1:Cada fragmento reduz o dano de um projétil que atingiu o escudo em 10%]
		[c/aab7f1:O escudo se despedaça depois de um projétil, lançando os fragmentos em inimigos com dano adicional]
		[c/aab7f1:Com todos os 10 fragmentos, você receberá um breve período de invencibilidade quando o escudo se despedaçar]
		'''
	FlavorTooltip: "[c/7b6d8d:'Uma lâmina tomada de seu reflexo dentro do Vazio Incessante']"
}

MonolithSword: {
	DisplayName: Espada de Monólito
	Tooltip: "{$Common.ArmorPenetration}"
}

MonstrousKnives: {
	DisplayName: Facas Monstruosas
	Tooltip: Lança uma série de facas que podem curar o usuário
}

Mourningstar: {
	DisplayName: Chicote do Luto
	Tooltip: Lança duas espadas de chicote solares que explodem no acerto
}

Murasama: {
	DisplayName: Murasama
	Tooltip:
		'''
		Uma lâmina de alta frequência que pode cortar até mesmo o inimigo mais poderoso
		Cada terceiro golpe causa muito dano
		Prove seu valor matando o Devorador de Deuses para desembainhar essa espada
		[c/F41A31:'Haverá sangue!']
