GrandGuardian: {
	DisplayName: Grande Guardião
	Tooltip:
		'''
		Diminui a defesa do inimigo em 1 com cada ataque
		Se a defesa do inimigo for 0 ou inferior, seus ataques irão te curar
		Atacar os inimigos causa uma grande explosão
		Atacar inimigos que têm menos que metade da vida fará com que você solte raios de arco-íris
		Inimigos geram orbes de cura na morte
		'''
}

GreatswordofJudgement: {
	DisplayName: Montante do Julgamento
	Tooltip:
		'''
		Dispara um orbe branco que emite chuva branca na morte por um tempo
		Uma espada branca pálida de uma terra esquecida
		Você pode ouvir sussurros fracos, mas reconfortantes, emanando da lâmina
		'Não importa onde você esteja, você nunca está sozinho
		Eu estarei sempre ao seu lado, meu senhor'
		'''
}

Greentide: {
	DisplayName: Maré Verde
	Tooltip: Invoca dentes do céu no acerto
}

HellfireFlamberge: {
	DisplayName: Flamberge do Fogo Infernal
	Tooltip: Dispara uma série de bolas de fogo vulcânicas
}

HellionFlowerSpear: {
	DisplayName: Lança da Flor Selvagem
	Tooltip:
		'''
		Dispara uma ponta de lança de flores
		Invoca pétalas do céu em acertos críticos
		'''
}

Hellkite: {
	DisplayName: Espada do Fogo Cruel
	Tooltip: "[GFB]"
	TooltipNormal:
		'''
