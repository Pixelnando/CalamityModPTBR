}

Quagmire: {
	DisplayName: Pântano
	Tooltip:
		'''
		{$Common.YoyoStatsInfinite}
		Dispara nuvens de esporo
		'''
}

RedSun: {
	DisplayName: Sol Vermelho
	Tooltip:
		'''
		Lança uma barragem de erupções solares do céu
