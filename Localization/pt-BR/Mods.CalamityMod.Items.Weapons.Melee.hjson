		'''
}

Nebulash: {
	DisplayName: Chicote de Nébula
	Tooltip: Dispara uma espada de chicote que emite explosões de partículas no acerto e espalha a [cbuff:CalamityMod/AstralInfectionDebuff]
}

NeptunesBounty: {
	DisplayName: Presente de Netuno
	Tooltip:
		'''
		Dispara uma espada abissal giratória que libera energia aquática constantemente
		Quando a lâmina parar de girar, ela se redirecionará a inimigos próximos com uma velocidade maior e 2x o dano
