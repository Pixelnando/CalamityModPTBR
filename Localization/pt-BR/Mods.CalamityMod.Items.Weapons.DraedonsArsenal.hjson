FrequencyManipulator: {
	DisplayName: Manipulador de Frequências
	Tooltip:
		'''
		Balança uma lança e a arremessa
		Na colisão, a lança libera uma rajada de energia teleguiada
		Ataques furtivos liberam mais energia e explodem na colisão
		[c/1FFBFF:'Um longo dispositivo originalmente usado para afinação mecânica.']
		'''
}

GalvanizingGlaive: {
	DisplayName: Gládio de Galvanização
	Tooltip:
		'''
		Balança uma lança que envolve os inimigos atingidos em um campo de energia
		Quando termina de balançar, a lança descarrega um pulso extra de energia
		[c/1FFBFF:'Uma ferramenta que divide um objeto em dois de maneira rápida e precisa.]
		[c/1FFBFF:Sua eficiência e confiabilidade como arma são inconfundíveis.']
		'''
}

GatlingLaser: {
	DisplayName: Metralhadora de Plasma
	Tooltip:
		'''
		Dispara uma barragem rápida de lasers acelerados para aniquilar os inimigos
		[c/1FFBFF:'Desenvolvida para ser usada principalmente pela frota e força de defesa da base de Yharim.']
		'''
}

GaussDagger: {
	DisplayName: Adaga de Gauss
	Tooltip:
		'''
		Corta os inimigos com força magnética turbulenta
		Ataques repetidos envolvem os inimigos em um fluxo magnético que causam danos
		'''
}

GaussPistol: {
	DisplayName: Pistola de Gauss
	Tooltip:
		'''
		Dispara um raio devastador de alta velocidade com recuo extremamente forte
		[c/1FFBFF:'Embora esta pistola arcana possa parecer mundana, ela é enganosamente poderosa.]
		[c/1FFBFF:Uma das várias vantagens das armas de fogo mágicas é que tamanho não é documento.']
		'''
}

GaussRifle: {
	DisplayName: Rifle de Gauss
	Tooltip: Dispara uma raio devastador de alta velocidade com recuo absurdo
}

HeavyLaserRifle: {
	DisplayName: Rifle à Laser Pesado
	Tooltip:
		'''
		Dispara um par incrivelmente preciso de feixes laser destrutivos
		[c/1FFBFF:'Embora a maioria dos Cavaleiros Caça-Deuses sejam brutais, nem todos preferem o combate físico.]
		[c/1FFBFF:Como tal, Yharim solicitou pessoalmente que eu criasse armamento pesado para eles, apesar de serem poucos.']
		'''
}

HydraulicVoltCrasher: {
	DisplayName: Esmagador de Tensão Hidráulica
	Tooltip:
		'''
		Uma britadeira eletricamente carregada que choca todos os inimigos próximos ao atingí-los
		[c/1FFBFF:'Um dispositivo feito para estampar eletricamente placas de metal, fundindo-as instantaneamente.]
		[c/1FFBFF:Naturalmente, também pode funcionar como uma arma devastadora.']
		'''
}

MatterModulator: {
	DisplayName: Modulador de Matéria
	Tooltip:
		'''
		Dispara um raio de matéria instável que perfura infinitamente mas causa pouco dano
		Depois de atingir uma peça, a matéria terá seu dano aumentado e não perfurará mais
		'''
}

MountedScanner: {
	DisplayName: Escaneador Montado
	Tooltip: Invoca um módulo escaneador poderoso sobre sua cabeça que dispara lasers nos inimigos próximos
}

Phaseslayer: {
	DisplayName: Exterminador Fásico
	Tooltip:
		'''
		Projeta uma lâmina laser colossal que é controlada pelo cursor
		Movimente o cursor para balançar a lâmina e rasgar completamente os inimigos
		Balanços mais rápidos causam mais danos e liberam raios de espada
		Quando estiver com carga baixa, a lâmina é menor e mais fraca
		'''
}

PlasmaCaster: {
	DisplayName: Lançador Plasmático
	Tooltip:
		'''
		Pressione <left> para disparar um raio de plasma explosivo enorme
		Pressione <right> para disparar no modo turbo, aumentando a taxa de disparo em troca de precisão
		'''
}

PlasmaGrenade: {
	DisplayName: Granada de Plasma
	Tooltip:
		'''
		Arremessa uma granada que explode em plasma no impacto
		Golpes furtivos explodem violentamente no impacto, causando uma explosão vaporizante
		[c/1FFBFF:'Cada granada contém uma unidade altamente condensada e aquecida. Utilize com extrema cautela']
		'''
}

PoleWarper: {
	DisplayName: Torcedor de Polos
	Tooltip:
		'''
		Invoca um par de ímãs flutuantes que se repelem e atacam incessantemente os inimigos
		Dispositivos magnéticos que rasgam seus inimigos impulsionando-se contra suas contrapartes opostas
		'''
}

PulseDragon: {
	DisplayName: Dragão Pulsante
	Tooltip:
		'''
		Arremessa duas cabeças de dragão mecânicas que emitem campos elétricos que causam danos
		[c/1FFBFF:'Yharim solicitou especificamente que esta arma fosse modelada com base nos Dragões de antigamente.]
		[c/1FFBFF:Que banal.']
		'''
}

PulsePistol: {
	DisplayName: Pistola de Pulso
	Tooltip: Dispara um pulso que arqueia em direção a um novo alvo ao atingir o inimigo
}

PulseRifle: {
	DisplayName: Rifle de Pulso
	Tooltip:
		'''
		Dispara um feixe de pulso fortalecido que se dissipa em quatro orbes de pulso de alta frequência ao atingir o inimigo
		Orbes de pulso seguem agressivamente inimigos próximos, seguindo mais rapidamente conforme atingem mais inimigos
		A perfuração do orbe de pulso não será reduzida ao matar inimigos ou ao causar pouco dano
		[c/1FFBFF:'Minha arma pessoal, usada para eliminar criações fracassadas.]
		[c/1FFBFF:Fiz uma cópia de segurança das esquemáticas para caso o original seja destruído.']
		'''
}

PulseTurretRemote: {
	DisplayName: Controle Remoto da Torreta de Pulso
	Tooltip:
		'''
		{$CommonItemTooltip.Sentry}
		Invoca uma torreta para disparar rajadas de pulso explosivas nos inimigos
		Apenas uma torreta de pulso pode existir por vez
		'''
}

SnakeEyes: {
	DisplayName: Olhos de Cobra
	Tooltip:
		'''
		Invoca um drone flutuante que dispara rajadas de energia perfurantes e altamente calibradas
		Se uma rajada atingir um inimigo, o drone será teletransportado no seu caminho e refletirá a rajada
		Rajadas refletidas são teleguiadas e explodem no impacto
		[c/1FFBFF:'Equipados com sensores de última geração, poucos conseguem escapar deles. Menos ainda conseguem fugir de seus olhares sempre vigilantes.]
		[c/1FFBFF:Uma ponte excelente entre meus experimentos com máquinas movidas a alma baseadas na visão e meu projeto mais recente.']
		'''
}

StarSwallowerContainmentUnit: {
	DisplayName: Unidade de Contenção do Engolidor de Estrelas
	Tooltip:
		'''
		Invoca um sapo biomecânico que vomita plasma nos inimigos
		[c/1FFBFF:'Estas criaturas simplistas foram mecanizadas para transportar plasma de forma autônoma.]
		[c/1FFBFF:Eles são muito mais úteis do que suas contrapartes orgânicas comuns.']
		'''
}

SystemBane: {
	DisplayName: Praga do Sistema
	Tooltip:
		'''
		Arremessa um dispositivo instável que gruda no chão e eletrocuta inimigos próximos com raios
		Golpes furtivos fazem o dispositivo emitir um campo eletromagnético danoso enorme
		'''
}

Taser: {
	DisplayName: Taser
	Tooltip:
		'''
		Dispara um gancho que se prende nos inimigos e os eletrocuta antes de retornar
		Uma arma elétrica simples e lenta, destinada apenas a guardas de baixo escalão
		'''
}

TeslaCannon: {
	DisplayName: Canhão Tesla
	Tooltip:
		'''
		Um canhão de energia leve que dispara um feixe elétrico intenso que explode
		O feixe pode arquear em direção a alvos próximos
		'''
}

TheAnomalysNanogun: {
	DisplayName: A Nanoarma da Anomalia
	Tooltip:
		'''
		Pressione <left> para carregar 5 feixes de plasma de disparo rápido
		Pressione <right> para lançar 3 bombas de fissão
		'Bem-vindo à festa, amigo'
		'''
}

TrackingDisk: {
	DisplayName: Disco Perseguidor
	Tooltip:
		'''
		Libera um disco voador que dispara lasers em inimigos próximos
		Este disco ganha aceleração conforme retorna ao jogador
		Golpes furtivos disparam lasers com uma taxa e distância maiores, e podem disparar em vários alvos diferentes
		'''
}

WavePounder: {
	DisplayName: Batedor de Ondas
	Tooltip:
		'''
		Arremessa uma bomba que explode numa onda de choque agonizantemente forte
		Golpes furtivos emitem ondas de choque absurdamente poderosas
		'''
}
