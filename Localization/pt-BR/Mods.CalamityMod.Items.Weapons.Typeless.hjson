Aestheticus: {
	DisplayName: Estéticus
	Tooltip:
		'''
		Dispara cristais que explodem e infligem [cbuff:CalamityMod/Vaporfied]
		{$Common.AverageDamageInfo}
		'''
}

ClaretCannon: {
	DisplayName: Canhão de Claretes
	Tooltip:
		'''
		Dispara um tiro de clarete hipercondensado
		O tiro explode ao atingir um inimigo e libera orbes de sangue
		A explosão dilacera os inimigos, reduzindo muito a defesa deles
		Coletar orbes de sangue reduzirá o [cbuffplr:PotionSickness] quando possível
		Se não houver [cbuffplr:PotionSickness], sua regen. natural será melhorada
		Só pode ser disparado a cada 10 segundos
		{$Common.AverageDamageInfo}
		'''
}

ColdheartIcicle: {
	DisplayName: Pingente do Coração Gélido
	Tooltip: "'Para aqueles que são pé frio'"
}

EyeofMagnus: {
	DisplayName: Olho de Magnus
	Tooltip:
		'''
		Dispara massas cósmicas teleguiadas que recuperam vida e mana no acerto
		Explode em uma nuvem de nébola que inflige os inimigos com [cbuff:CalamityMod/MarkedforDeath]
		{$Common.AverageDamageInfo}
		'''
}

LunicEye: {
	DisplayName: Olho Lúnico
	Tooltip:
		'''
		Dispara feixes de energia teleguiados que inflige os inimigos com [cbuff:CalamityMod/MarkedforDeath]
		{$Common.AverageDamageInfo}
		'''
}

RelicOfDeliverance: {
	DisplayName: Relíquia da Libertação
	Tooltip:
		'''
		Usar <left> faz você montar na lança; segurar <left> carrega a lança, desacelerando-o
		Solte o botão para se lançar em alta velocidade, com uma velocidade menor quando um chefe estiver vivo
		Perder muita velocidade enquanto carrega interromperá o carregamento, redefinindo sua velocidade
		A investida permite que você atravesse inimigos e peças
		Ficar dentro de peças por muito tempo fará com que você seja teletransportado ao lugar por onde entrou
		<right> para desmontar
		Segurar a lança reduz muito o dano de todas as invocações
		{$Common.AverageDamageInfo}
		[c/FF8C00:A vingança me impulsionava; eu não pensava em nada além de me vingar.]
		[c/FF8C00:O dragão tirou tudo de mim, deixando meus pedaços quebrados espalhados pelo chão.]
		[c/FF8C00:Mas quando dancei ao lado dEla, soube que ainda havia algo pelo qual valia a pena lutar.]
		'''
}

Skynamite: {
	DisplayName: Dinamite Celestial
	Tooltip:
		'''
		Arremessa um explosivo flutuante que desafia a gravidade
		'Você não precisa ser formado em aerodinâmica para usar isso...'
		'''
}

StarStruckWater: {
	DisplayName: Água Estrelada
	Tooltip: Espalha a Infecção Astral a alguns blocos
}

StratusSphere: {
	DisplayName: Estratoesfera
	Tooltip:
		'''
		Lança uma singularidade que exerce influência sobre todas as entidades em uma área ao seu redor
		Jogadores influenciados recebem Explosões Estelares com o tempo e as consumirão para voar quando esgotarem seu tempo de voo
		<right> para criar uma barreira de Explosões Estelares, fazendo com que você os perca no lugar da vida
		Lançar a singularidade desativa a barreira e criar uma barreira desativa a singularidade
		{$Common.AverageDamageInfo}
		'Canalizando almas em estrelas, um conceito absurdo'
		'''
}
