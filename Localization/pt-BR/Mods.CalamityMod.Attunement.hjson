// Broken Biome Blade
DefaultAttunement: {
	Name: Claridade Pura
	Function: Dispara um feixe de espada fraco que esmaga as defesas inimigas
}

HotAttunement: {
	Name: Grandeza Árida
	Function:
		'''
		Conjure lâminas abrasadoras à sua frente que ficam maiores conforme você atinge o inimigo
		As lâminas também rebatem em peças quando você estiver no ar
		'''
}

ColdAttunement: {
	Name: Abraço Mordaz
	Function: Execute um combo de 3 golpes com uma lâmina glacial, com um golpe final que congela os inimigos por uma fração de segundo
}

EvilAttunement: {
	Name: Retorta da Decadência
	Function:
		'''
		Invista para frente com um florete fantasma, saltando para longe dos inimigos atingidos e roubando a vida deles
		'''
}

// Mended Biome Blade
TrueDefaultAttunement: {
	Name: Claridade Pura
	Function:
		'''
		Dispara um feixe de espada fraco que esmaga a defesa do inimigo
		Acertar três golpes físicos verdadeiros carrega uma investida poderosa que é liberada quando você parar de balançar a espada
		Inimigos atingidos pela investida são marcadas com um sigilo que atrairá os feixes de espada
		'''
}

TrueHotAttunement: {
	Name: Grandeza Árida
	Function:
		'''
		Conjure lâminas abrasadoras à sua frente que ficam maiores conforme você atinge o inimigo
		As lâminas também rebatem em peças quando você estiver no ar
		Solte depois que as lâminas estiverem totalmente carregadas para as lançar para frente para destruir seus inimigos
		'''
}

TrueColdAttunement: {
	Name: Abraço Mordaz
	Function:
		'''
		Execute um combo de 3 golpes com uma lâmina glacial, com um golpe final que congela os inimigos por uma fração de segundo
		Uma névoa glacial danosa e persistente é liberada em cada balanço
		'''
}

TrueTropicalAttunement: {
	Name: Toque do Guarda-florestal
	Function:
		'''
		Lance a espada usando um chicote de vinha
		Atingir inimigos com a ponta do chicote enquanto ele estala garante um acerto crítico
		Videiras que se espalham brotam de acertos críticos, estas videiras podem atingir até três alvos
		'''
}

TrueEvilAttunement: {
	Name: Retorta da Decadência
	Function:
		'''
		Invista para frente com um florete fantasma, saltando para longe dos inimigos atingidos e roubando a vida deles
		Acertar três golpes sem tocar no chão transforma seu próximo ataque em um impulso fortalecido
		'''
}

HolyAttunement: {
	Name: Poder Celestial
	Function:
		'''
		Balance a espada ao seu redor, acelerando e causando mais dano com o tempo
		Quando for balançada o suficiente, soltar o ataque a arremessará na direção do cursor por um curto período de tempo
		Atingir um inimigo com a espada arremessada com seu poder máximo faz com que um monólito astral irrompa na posição dele
		'''
}

// True Biome Blade
WhirlwindAttunement: {
	Name: Orgulho do Espadachim
	Function:
		'''
		Segure <left> para balançar a espada ao seu redor, acelerando e causando mais dano com o tempo
		Energias astrais são liberadas descontroladamente ao seu redor enquanto balança a espada
		Quando for balançada o suficiente, soltar o ataque a arremessará na direção do cursor
		A espada arremessada irrompe em monólitos astrais ao atingir o inimigo
		'''
	PassiveDesc: Atingir inimigos pode invocar bombardeiros astrais que espalham a Infecção Astral
}

FlailBladeAttunement: {
	Name: Lamentações dos Acorrentados
	Function:
		'''
		Ataque com uma enxurrada de lâminas acorrentadas
		Atingir os inimigos com a ponta de lâminas garante um acerto crítico
		Acertos críticos enviam correntes extras que se prendem a vários alvos
		'''
	PassiveDesc: Um gancho de corrente encantado flutua perto de você e gira e congela inimigos conforme você causa danos
}

SuperPogoAttunement: {
	Name: Fúria Sanguínea
	Function:
		'''
		Conjure lâminas derretidas à sua frente que ficam maiores conforme você atinge o inimigo
		AAs lâminas também rebatem em peças quando você estiver no ar
		Solte para lançar as lâminas carregadas para frente como uma roda
		Atacar imediatamente após arremessar a lâmina te lança na direção dela, rasgando os inimigos e curando você
		'''
	PassiveDesc: Energia vital pode raramente surgir de golpes infligidos
}

ShockwaveAttunement: {
	Name: Marés Terrestres
	Function:
		'''
		Carregue uma investida avassaladora, solte para liberar um golpe devastador
		Feixes de espada teleguiados são emitidos conforme o golpe é carregado
		Golpear um inimigo com a investida cria uma onda de choque e marca-o com um sigilo de esmagamento de armadura que atrai teleguiadamente os feixes de espada
		Golpear a terra com a investida fará com que diversas explosões de poeira irrompam em sua volta
		'''
	PassiveDesc: Emite ondas de choque enormes periodicamente enquanto ataca
}

// Galaxia
PhoenixAttunement: {
	Name: Orgulho da Fênix
	Function:
		'''
		Balance a espada ao seu redor, acelerando com o tempo
		A nébula rodopiante constantemente emite raios cósmicos teleguiados
		Solte para arremessar Galaxia na direção do cursor junto de uma rajada de 6 raios cósmicos gigantescos
		'''
	PassiveName: Bênção do Capricórnio
	PassiveDesc:
		'''
		Periodicamente libera um anel de estrelas enfraquecedoras ao redor do seu cursor conforme você ataca
		O anel começa distanciando-se de você, e então desacelera com o tempo
		'''
}

AriesAttunement: {
	Name: Ira de Áries
	Function:
		'''
		Vincula a espada ao seu cursor por meio de uma corrente de constelações
		Golpear inimigos causa explosões nebulosas que invocam raios cósmicos teleguiados
		'''
	PassiveName: Bênção do Capricórnio
	PassiveDesc:
		'''
		Periodicamente libera um anel de estrelas enfraquecedoras ao redor do seu cursor conforme você ataca
		O anel começa distanciando-se de você, e então desacelera com o tempo
		'''	
}

PolarisAttunement: {
	Name: Olhar Polar
	Function:
		'''
		Canalize o poder da Galáxia em um vórtice de energias celestiais
		O vórtice aumenta ao longo do tempo e ao atingir os inimigos
		Solte para disparar uma estrela poderosa diretamente ao cursor que bombardeia inimigos próximos com raios
		Atacar logo após lançar a estrela lança-o na direção dela, causando dano nos inimigos
		'''
}

AndromedaAttunement: {
	Name: Passo de Andrômeda
	Function:
		'''
		Carregue uma investida espacial, solte para liberar um ataque galáctico
		A espada libera raios teleguiados periodicamente enquanto o ataque é carregado
		Investir nos inimigos faz chover estrelas teleguiadas enormes dos céus
		'''
}
