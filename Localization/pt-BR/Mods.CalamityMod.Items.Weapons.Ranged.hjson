		Utiliza gel como munição
		{$CommonItemTooltip.PercentChanceToSaveAmmo}
		'''
}

WulfrumBlunderbuss: {
	DisplayName: Bacamarte de Vulfrúmio
	Tooltip:
		'''
		Consome sucata de vulfrúmio ou moedas de prata para disparar
		A propagação dos tiros pode ser diminuída mirando de mais longe, ao custo de menos dano
		{$Common.ArmorPenetration}
		[c/83B87E:'O bom do Vulfrúmio é que, embora quebre rápido, ele pode ser reutilizado ainda mais rápido"]
