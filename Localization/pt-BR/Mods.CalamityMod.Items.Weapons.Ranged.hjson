		{$Mods.CalamityModPTBR.Common.CollectBloodOrbs}
		'''
}

AstralBlaster: {
	DisplayName: Detonador Astral
	Tooltip: Converte bolas de mosquete em tiros astrais teleguiados que espalham a [cbuff:CalamityMod/AstralInfectionDebuff]
}

AstrealDefeat: {
	DisplayName: Derrota Astral
	Tooltip: Todas as flechas são convertidas em Flechas Astrais que emitem chamas enquanto caminham
}

Auralis: {
	DisplayName: Auralis
	Tooltip:
		'''
		Dispara um projétil brilhante de alta velocidade que torna o inimigo [cbuff:CalamityMod/MarkedforDeath]
		<right> para afastar
		Ficar parado fornece um bônus de dano crescentes em até 25%
		Ficar parado por 5 ou mais segundos usando a habilidade de mira invocará uma aurora
		A aurora reduz o dano do próximo projétil atingido em 100
		Este efeito dura até 20 segundos e tem um tempo de recarga de 30 segundos
		'''
}

AuroraBlazer: {
	DisplayName: Incendiário de Aurora
	Tooltip:
		'''
		Lança um fluxo de nébula que forma um padrão em forma de estrela e espalha a [cbuff:CalamityMod/AstralInfectionDebuff]
