		{$CommonItemTooltip.PercentChanceToSaveAmmo}
		'''
}

UniversalGenesis: {
	DisplayName: Gênese Universal
	Tooltip:
		'''
		Dispara projéteis em várias direções da arma e uma enxurrada de estrelas para chover no cursor
		Converte bolas de mosquete em tiros chamadores de estrelas que invocam estrelas adicionais ao atingir o inimigo
		'Deixe o céu estrelado cair sobre seus inimigos'
		'''
}

VernalBolter: {
	DisplayName: Feixador Vernal
	Tooltip:
		'''
		Dispara uma coluna estreita de três flechas
		Converte flechas de madeira em feixes de energia deslizantes
		'''
}

Voidragon: {
	DisplayName: Dragão do Vazio
	Tooltip:
