		Loads a 50 round magazine of alternating bullets and concentrated void blasts
		When all bullets are fired, the gun unleashes an enormous jet of abyssal fire
		The power of the abyssal fire scales with the amount of shots hit
		{$CommonItemTooltip.PercentChanceToSaveAmmo}
		[c/620BB0:'Fade to black']
		'''
}

Vortexpopper: {
	DisplayName: Estouradora do Vórtice
	Tooltip: Dispara bolhas para todos os lados que estouram em projéteis
}

WildfireBloom: {
