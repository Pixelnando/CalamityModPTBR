// Permanent Boosters
AdrenalineBoosterTooltip: Aumenta permanentemente a o dano da {$Buffs.AdrenalineMode.DisplayName} em {0}% e a redução dos danos em {1}%
RageBoosterTooltip: Aumenta permanentemente a duração da {$Buffs.RageMode.DisplayName} em {0} segundo

CelestialOnion: {
	DisplayName: Cebola Celestial
	Tooltip:
		'''
		Aumenta permanentemente a quantidade de espaços de acessório
		No Modo Mestre, o item ativa o espaço de acessório do Coração do Demônio no lugar
		Poder alienígena pulsa dentro de suas camadas
		'''
}

CometShard: {
	DisplayName: Fragmento de Cometa
	Tooltip:
		'''
		Aumenta a mana máxima permanentemente em {0}
		Só pode ser usada uma vez e requer que a quantidade máxima de Cristais de Mana seja consumida
		'''
}

