AstralHelm: {
	DisplayName: Elmo Astral
	Tooltip:
		'''
		{$CommonItemTooltip.PercentIncreasedDamage} e {$CommonItemTooltip.PercentIncreasedCritChance@1}
		Detecta criaturas, projéteis inimigos, fontes de perigo e tesouro próximos
		[c/aaaaaa:Segure Shift e <right> no seu inventário para alternar o efeito da] [cbuffplr:CalamityMod/Omniscience]
		'''
	SetBonus:
		'''
		{$CommonItemTooltip.IncreasesMaxMinionsBy}
		{$CommonItemTooltip.PercentIncreasedDamageCritChance@1}
		Sempre que você atingir um acerto crítico em um inimigo, uma barragem de estrelas cairá dos céus
		Este efeito tem um tempo de recarga de {2} {^2:segundo;segundos} antes que possa ser ativado novamente
		'''
}

