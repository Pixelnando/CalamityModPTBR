AbyssalTome: {
	DisplayName: Tomo Abissal
	Tooltip: Conjura uma lenta esfera de energia escura
}

AbyssShocker: {
	DisplayName: Eletrocutor do Abismo
	Tooltip: Dispara um raio errático que se movimenta em um arco e ricocheteia entre inimigos
}

AcidGun: {
	DisplayName: Pistola Ácida
	Tooltip: Libera três fluxos de ácido
}

AetherfluxCannon: {
	DisplayName: Canhão Fluxetéreo
	Tooltip: Dispara uma hélice de fótons que atravessa tudo
}

AethersWhisper: {
	DisplayName: Sussurro de Éter
	Tooltip: Dispara feixes do vazio que recebem mais dano conforme viajam e se dividem ao atingir peças
}

AlulaAustralis: {
	DisplayName: Alula Australis
	Tooltip: Dispara uma linda aurora que inflige [cbuff:CalamityMod/AstralInfectionDebuff] trilhada por uma chuva de estrelas
}

AlphaDraconis: {
	DisplayName: Alpha Draconis
	Tooltip:
		'''
		Chama uma chuva de meteoros na posição do cursor
		Acertos bem-sucedidos ocasionalmente criam Explosões Estelares que podem ser coletadas
		<right> com Explosões Estelares suficientes para invocar Draco para te proteger
		Draco consome Explosões Estelares conforme o tempo passa, e pode ser desfeito com <right>
		Draco inflige [cbuff:CalamityMod/Voidfrost]
		'Uma imitação da insanidade'
		'''
}

AnahitasArpeggio: {
	DisplayName: Arpejo da Anahita
	Tooltip: "[GFB]"
	TooltipNormal:
		'''
		Segure <left> para conjurar seis claves de sol que orbitam o jogador
		Soltar <left> faz com que as claves de sol se aproximem do cursor 
		Depois de se aproximarem, as claves de sol seguem o cursor
		'''
	TooltipGFB:
		'''
		"NÃOOOOOOO!! Vocês deviam me obedecer!!!!"
		As sete almas de clave de sol:
		'''
}

Apathanull: {
	DisplayName: Apatanulo
	Tooltip:
		'''
		Lança uma rajada de tentáculos cósmicos sombrios para empalar seus inimigos
		Os tentáculos mirarão no seu cursor e atacarão três vezes antes de desaparecerem
		'''
}

ApoctosisArray: {
	DisplayName: Matriz Apoctótica
	Tooltip:
		'''
		Dispara raios de íons que aceleram, penetram profundamente as defesas do inimigo e explodem
		<right> para carregar o detonador, recuperando sua mana até atingir o máximo
		O tamanho da flecha aumenta de acordo com a mana recuperada
		O poder máximo da carga é equivalente à recuperação de 90% da sua mana máxima
		Segurar este item desativa a coleta de estrelas
		'''
}

Apotheosis: {
	DisplayName: Apoteose
	Tooltip:
		'''
		Libera uma magia de projeção interdimensional
		Engula vermes
		'''
}

AquamarineStaff: {
	DisplayName: Cajado de Água-marinha
	Tooltip: Dispara dois raios azuis
}

ArchAmaryllis: {
	DisplayName: Arqui-amarílis
	Tooltip: Conjura uma flor radiante que explode em pétalas teleguiadas
}

ArcticBearPaw: {
	DisplayName: Pata de Urso Ártico
	Tooltip:
		'''
		Dispara garras espirituais que ignoram paredes
		'A surra selvagem que cabe no seu bolso'
		'''
}

ArtAttack: {
	DisplayName: Ataque Artístico
	Tooltip:
		'''
		Conjura uma estrela que segue o mouse e cria um rastro arco-íris conforme viaja
		Quando uma forma inteira for criada com o rastro, todos os inimigos dentro dela sofrerão dano proporcional ao tempo levado para desenhá-la
		'E a plateia vai à loucura!'
		'''
}

AstralachneaStaff: {
	DisplayName: Cajado Astralacneia
	Tooltip: Dispada uma série de presas de aranha astrais teleguiadas que espalham a [cbuff:CalamityMod/AstralInfectionDebuff]
}

AstralStaff: {
	DisplayName: Cajado Astral
	Tooltip: Invoca um grande cristal dos céus que possui uma enorme área de efeito no impacto
}

Atlantis: {
	DisplayName: Atlântida
	Tooltip: Conjura lanças aquáticas que se dividem conforme viajam
}

AuguroftheVoid: {
	DisplayName: Augúrio do Vazio
	Tooltip: Conjura uma série de tentáculos elementais para empalar seus inimigos
}

BelchingSaxophone: {
	DisplayName: Saxofone Arrotante
	Tooltip:
		'''
		Dispara uma série de juncos sujos, notas musicais e bolhas sulfúricas
		Doot
		'''
}

Biofusillade: {
	DisplayName: Biofuzilaria
	Tooltip: Libera um feixe de energia vital concentrada
}

BlackAnurian: {
	DisplayName: Anuro Preto
	Tooltip: Vomita bolhas e plânctons teleguiados
}

BloodBath: {
	DisplayName: Banho de Sangue
	Tooltip: Encharca seus inimigos de sangue
}

BrimroseStaff: {
	DisplayName: Cajado da Rosa de Enxofre
	Tooltip: Dispara feixes de enxofre espalhadamente
}

BurningSea: {
	DisplayName: Mar Ardente
	Tooltip:
		'''
		Conjura uma bola de fogo enorme que flutua em sua vicinidade e incinera inimigos com [cbuff:CalamityMod/BrimstoneFlames]
		Segurar a bola de fogo por muito tempo fará com que ela se apague
		Isso incinera você com [cbuffplr:CalamityMod/BrimstoneFlames] e torna a bola de fogo inconjurável por um tempo
		'''
}

ChronomancersScythe: {
	DisplayName: Foice do Cronomante
	Tooltip:
		'''
		Dispara pedaços de gelo que causam [cbuff:CalamityMod/TimeDistortion] nos inimigos
		<right> para balançar a foice ao seu redor, criando um padrão de relógio de gelos teleguiados
		Acertos diretos com a foice podem invocar relógios
		Coletar os relógios aumenta a velocidade de movimento e aceleração em 5% para cada relógio coletado
		Isso acumula até 3 vezes e desaparece gradualmente após 5 segundos
		'''
}

ClothiersWrath: {
	DisplayName: Ira do Alfaiate
	Tooltip: Atira três caveiras de chamas das sombras
}

CoralSpout: {
	DisplayName: Bico Coralino
	Tooltip:
		'''
		Conjura uma rajada espalhada de fragmentos de corais
		Segure o botão de ataque para diminuir a dispersão
		Fragmentos de coral ignoram 5 pontos de defesa do inimigo
		Carregar o ataque até o final libera um pedaço maior de coral que gruda nos inimigos
		Pegar o pedaço de coral depois que ele cair do inimigo recupera 150 de mana
		O coral carregado de mana também fornece o efeito [cbuffplr:CalamityMod/CoralSymbiosis]
		[c/5C95A1:'O conhecimento é importante, e os muitos escribas do Velho Reino do Mar sabiam que ele precisava ser preservado a qualquer custo.]
		[c/5C95A1:Suas bibliotecas eram muito maiores do que a maioria, graças às tábuas de pedra à prova d'água que as ocupavam.']
		'''
}

CosmicRainbow: {
	DisplayName: Arco-íris Cósmico
	Tooltip: Libera uma barragem de árcos-íris
}

Cryophobia: {
	DisplayName: Criofobia
	Tooltip:
		'''
		Dispara uma onda gelada que se divide diversas vezes e explode em fragmentos
		'Fica frio aí'
		'''
}

DarkSpark: {
	DisplayName: Faísca Negra
	Tooltip:
		'''
		'E tudo sob o Sol está em perfeita sintonia,
		Mas o Sol está coberto pela Lua.'
		'''
}

DeathValleyDuster: {
	DisplayName: Espanador do Vale da Morte
	Tooltip:
		'''
		Conjura uma rajada de poeira encantada que atravessa inimigos e peças
		Conjurar este feitiço com a mana máxima e sem o enjoo por mana concederá ao portador e a jogadores atingidos o efeito [cbuffplr:CalamityMod/SandsWindBuff]
		'''
}

Downpour: {
	DisplayName: Aguaceiro
	Tooltip:
		'''
		Dispara uma fluxo de areia explosivo que cai ao atingir um inimigo
		A explosão ocorre apenas quando o projétil expirar
		'''
}

Effervescence: {
	DisplayName: Efervescência
	Tooltip: Dispara uma vasta rajada de bolhas
}

EidolicWail: {
	DisplayName: Uivo Eidólico
	Tooltip:
		'''
		Dispara uma série de ondas sonoras que ficam mais fortes conforme viajam
		Descansem em paz, usuários de fones de ouvido
		'''
}

EidolonStaff: {
	DisplayName: Cajado Eidolon
	Tooltip: Dispara uma rajada de luz antiga e um aglomerado de gelo giratório
}

EldritchTome: {
	DisplayName: Tomo Sobrenatural
	Tooltip: Conjura tentáculos sobrenaturais para empalar seus inimigos
}

Eternity: {
	DisplayName: Eternidade
	// Color changes at the second line of tooltip via ModifyTooltips.
	Tooltip:
		'''
		Enfeitiça um possível inimigo próximo, prendendo-o em uma brilhante demonstração de destruição
		'Há fotos de pôneis no livro'
		'''
}

EventHorizon: {
	DisplayName: Horizonte de Eventos
	Tooltip:
		'''
		Dispara um anel de estrelas que são teleguiadas aos inimigos próximos
		As estrelas invocam buracos negros ao atingir um inimigo
		'Nada, nem mesmo a luz, pode retornar'
		'''
}

EvergladeSpray: {
	DisplayName: Jato do Pântano
	Tooltip: Dispara um fluxo de icor verde ardente
}

FaceMelter: {
	DisplayName: Derrete-rostos
	Tooltip:
		'''
		Dispara notas musicais
		<right> para invocar um amplificador que dispara na direção do seu mouse
		'WOOO!! MUUUUUUUUUUUUNDOO FANTÁSTICOOOOO!'
		'''
}

FatesReveal: {
	DisplayName: Revelação do Destino
	Tooltip: Invoca bolas de fogo fantasmagóricas que seguem o jogador
}

FlareBolt: {
	DisplayName: Raio de Fogo
	Tooltip:
		'''
		Conjura uma bola de fogo
		As bolas de fogo colapsam em uma corrente de ar em redemoinho que puxa os inimigos
		'''
}

ForbiddenSun: {
	DisplayName: Sol Proibido
	Tooltip: Conjura um orbe de fogo que emite uma explosão enorme no acerto
}

FrigidflashBolt: {
	DisplayName: Raio do Clarão Gélido
	Tooltip:
		'''
		Conjura uma bola de magma congelante que se move rapidamente e rebate em peças
		Produz uma explosão de chamas geladas ao colidir com uma peça
		<right> para conjurar uma bola empoderada que cria um vórtice explosivo de chamas geladas
		'''
}

FrostBolt: {
	DisplayName: Raio Congelante
	Tooltip:
		'''
		Conjura uma bola de gelo que rebate em peças
		Produz uma pequena explosão de gelo ao colidir com uma peça
		Os projéteis de gelo cairão ao chão depois de algum tempo
		'''
}

Genesis: {
	DisplayName: Gênese
	Tooltip:
		'''
		Dispara uma matriz de lasers com o raio de dispersão reduzido a cada tiro
		Cada sexto tiro dispara um Feixe Gênese que se divide e redefine a dispersão da arma
		Atingir um inimigo antes que o Feixe Gênese se divida causa um dano maior
		'''
}

GhastlyVisage: {
	DisplayName: Visagem Fantasmagórica
	Tooltip: Dispara energia fantasmagórica teleguiada que explode
}

GleamingMagnolia: {
	DisplayName: Magnólia Cintilante
	Tooltip: Conjura uma flor cintilante que explode em pétalas
}

GloriousEnd: {
	DisplayName: Final Glorioso
	Tooltip:
		'''
		Conjura uma estrela cadente que pode ser montada e viaja na direção do cursor
		A estrela cadente explode após atingir um inimigo, uma parede, ou após 6 segundos
		Esta explosão machuca os inimigos e o jogador
		Soltar o ataque antes da estrela explodir fará com que ela exploda prematuramente, causando menos dano
		Montarias não funcionam enquanto esta arma está sendo usada
		'''
}

GruesomeEminence: {
	DisplayName: Eminência Macabra
	Tooltip:
		'''
		Invoca um aglomerado gasoso de espíritos que voam descontroladamente perto do cursor
		Com o tempo, eles começarão a se acumular para criar uma monstruosidade única que pode ser controlada
		'''
	Calamitas:
		'''
		'Muitos dirão que Yharim caiu Muitos dirão que Yharim perdeu a graça à medida que sua Cruzada avançava, mas isso está longe de ser verdade.
		      Claro, ele era um homem bom quando matava assassinos embriagados pelo poder, mas, mesmo enquanto destronava ditadores, reinos inteiros eram arrasados junto com eles.
		      Gostaria que mais pessoas pudessem testemunhar esse "Polterghast". Talvez assim elas compreendessem a dor que ele causou ao mundo.'
		'''
}

HadalUrn: {
	DisplayName: Urna Hadal
	Tooltip:
		'''
		Dispara diversas criaturas do oceano
		'Não há como dizer quanto tempo isto esteve lá embaixo... ou o que se esconde dentro'
		'''
}

HeliumFlash: {
	DisplayName: Clarão de Hélio
	Tooltip:
		'''
		Lança núcleos de estrela voláteis que irrompem em explosões de fusão enormes
		Sempre causa acertos críticos, e a chance de acerto crítico aumenta o dano por acerto crítico
		'O poder e uma galáxia, mesmo que apenas por alguns instantes'
		'''
}

HellwingStaff: {
	DisplayName: Cajado de Asas do Inferno
	Tooltip: Conjura morcegos em chamas
}

Hematemesis: {
	DisplayName: Hematêmese
	Tooltip: Conjura uma barragem de gêiseres de sangue por baixo
}

Heresy: {
	DisplayName: Heresia
	Tooltip:
		'''
		Libera fogo e almas para cima de um livro em suas mãos
		O poder de ambos aumenta conforme o livro é segurado
		'''
}

HyperdeathRiftScepter: {
	DisplayName: Cetro da Fenda da Hipermorte
	Tooltip: Divide o espaço ao meio com o [ceffect/dog:Rasgador de Fendas da Hipermorte]
}

HyphaeRod: {
	DisplayName: Cajado de Hifas
	Tooltip: Cria esporos de cogumelo perto do jogador
}

IceBarrage: {
	DisplayName: Barragem de Gelo
	Tooltip:
		'''
		Conjura um feitiço de gelo poderoso e mortal na posição do cursor
		Este feitiço de gelo se fixa na posição de inimigos próximos
		Consome 2 Runas de Sangue toda vez que é usado
		'Ah, que pena, você está morto!'
		'''
}

IcicleStaff: {
	DisplayName: Cajado de Gelo
	Tooltip: Conjura gelo do céu
}

IcicleTrident: {
	DisplayName: Tridente de Gelo
	Tooltip: Dispara gelos perfurantes
}

InfernalRift: {
	DisplayName: Fenda Infernal
	Tooltip: Invoca lâminas infernais que invocam mais lâminas ao atingir um inimigo
}

IonBlaster: {
	DisplayName: Detonador de Íons
	Tooltip:
		'''
		Dispara raios de íons que aceleram, penetram profundamente as defesas do inimigo e explodem
		<right> para carregar o detonador, recuperando sua mana até atingir o máximo
		A força da explosão aumenta de acordo com a mana recuperada
		O poder máximo da carga é equivalente à recuperação de 90% da sua mana máxima
		Segurar este item desativa a coleta de estrelas
		'''
}

Keelhaul: {
	DisplayName: Quilha
	Tooltip:
		'''
		Invoca um gêiser ao atingir um inimigo
		Só pode haver um gêiser por vez
		'Esmague-os que nem papel'
		'''
}

LashesofChaos: {
	DisplayName: Açoite do Caos
	Tooltip:
		'''
		Alterna entre bolas de fogo do inferno explosivas e explosões do inferno perfurantes
		'Observe o mundo pegar fogo...'
		'''
}

LightGodsBrilliance: {
	DisplayName: Brilho do Deus da Luz
	Tooltip: Conjura pequenas lágrimas de luz teleguiadas e bolas de luz explosivas
}

MadAlchemistsCocktailGlove: {
	DisplayName: Luva de Coquetel do Alquimista Maluco
	Tooltip:
		'''
		Dispara uma variedade de frascos de alta velocidade
		<right> para disparar um frasco prismático que inflige [cbuff:CalamityMod/ElementalMix]
		Frascos vermelhos explodem violentamente
		Frascos azuis contêm gás venenoso
		Frascos verdes invocam chamas da lua
		Frascos roxos explodem em estilhaços teleguiados
		'''
}

MagneticMeltdown: {
	DisplayName: Colapso Magnético
	Tooltip: Lança uma cruz em diamante de esferas magnéticas sobrecarregadas
}

ManaRose: {
	DisplayName: Rosa de Mana
	Tooltip: Conjura uma flor de mana que explode em pétalas
}

Miasma: {
	DisplayName: Miasma
	Tooltip: Dispara espalhadamente núvens de gás que desaceleram ao atingir um inimigo
}

Mistlestorm: {
	DisplayName: Tempestade Herbal
	Tooltip: Conjura uma tempestade de espinhos e folhas
}

NanoPurge: {
	DisplayName: Nanoexpurgo
	Tooltip:
		'''
		Dispara uma barragem de nanolasers
		Rebate em direção ao inimigo mais próximo depois de acertar uma parede
		'''
}

NebulousCataclysm: {
	DisplayName: Cataclismo Nebuloso
	Tooltip: "'O verdadeiro poder do Mago da Nébula reside em suas mãos...'"
}

NightsRay: {
	DisplayName: Raio da Noite
	Tooltip:
		'''
		Dispara um raio de escuridão pura e concentrada
		Ao atingir um inimigo, ele será atingido por diversos outros raios vindos de seus lados
		'''
}

NuclearFury: {
	DisplayName: Fúria Nuclear
	Tooltip: Conjura uma torrente de tufões cósmicos
}

Nucleosynthesis: {
	DisplayName: Nucleossíntese
	Tooltip:
		'''
		Conjura quatro feixes celestiais perto do jogador
		Feixes do sol explodem em fogo ao atingir o inimigo
		Feixes de nébula se espalham com o tempo
		Feixes do vórtice agem como relâmpagos velozes e eletrificam os inimigos
		Feixes de pó das estrelas liberam pequenas estrelas teleguiadas ao atingir o inimigo
		'''
}

Omicron: {
	DisplayName: Ômicron
	Tooltip:
		'''
		Dispara uma barragem contínua de lasers e invoca dois Braços-Direitos que orbitam você e disparam lasers na direção do cursor
		<right> enquanto dispara para atirar um Feixe Ômicron que se divide ao atingir um inimigo
		Depois de disparar um Feixe Ômicron, seus Braços-Direitos lançarão um par de granadas
		Atingir um inimigo com um Feixe Ômicron logo após ser disparado aumentará muito o dano causado e evitará a divisão do feixe
		'''
}

ParasiticSceptor: {
	DisplayName: Cetro Parasítico
	Tooltip:
		'''
		Dispara uma barragem de sanguessugas que grudam nos inimigos
		Causa danos acumulados com [cbuff:CalamityMod/Irradiated] ao longo do tempo para cada sanguessuga
		'''
}

PhantasmalFury: {
	DisplayName: Fúria Fantasmagórica
	Tooltip: Conjura um raio fantasmagórico que explode em mais raios
}

PhoenixFlameBarrage: {
	DisplayName: Barragem de Chamas da Fênix
	Tooltip:
		'''
		Conjura uma barragem de [cbuff:CalamityMod/Dragonfire] dos céus
		'Batismo por fogo dracônico'
		'''
}

Photosynthesis: {
	DisplayName: Fotossíntese
	Tooltip: Conjura um raio brilhante que dissolve em energia ao atingir um inimigo
}

PlagueStaff: {
	DisplayName: Cajado da Praga
	Tooltip: Dispara uma sequência de 4 presas da [cbuff:CalamityMod/Plague]
}

PlasmaRifle: {
	DisplayName: Rifle de Plasma
	Tooltip:
		'''
		Dispara uma rajada de plasma que explode
		<right> para disparar rapidamente raios de plasma
		'''
}

PlasmaRod: {
	DisplayName: Bastão de Plasma
	Tooltip:
		'''
		Conjura um raio de plasma fraco
		Atingir uma peça dispersará diversos raios com dano de fogo aumentado
		Atingir um inimigo infligirá [cbuff:CalamityMod/Shadowflame]
		'''
}

Poseidon: {
	DisplayName: Poseidon
	Tooltip: Conjura um tufão de Poseidon
}

PrimordialAncient: {
	DisplayName: Antiguidade Primordial
	Tooltip:
		'''
		Conjura cinco explosões de areia promordial que logo convergem no cursor e criam uma explosão enorme
		Conjurar este feitiço com a mana máxima e sem o enjoo por mana concederá ao portador e a jogadores atingidos o efeito [cbuffplr:CalamityMod/AeolianEarthBuff]
		'''
}

PrimordialEarth: {
	DisplayName: Terra Primordial
	Tooltip:
		'''
		Conjura duas explosões de areia encantadas que convergem entre si e explodem
		Conjurar este feitiço com a mana máxima e sem o enjoo por mana concederá ao portador e a jogadores atingidos o efeito [cbuffplr:CalamityMod/SandsWindBuff]
		'''
}

PurgeGuzzler: {
	DisplayName: Beberrão da Purificação
	Tooltip:
		'''
		Dispara uma barragem de feixes sagrados que convergem em dois raios varredores enormes
		'Batismo por fogo sagrado'
		'''
}

RainbowPartyCannon: {
	DisplayName: Canhão de Festa Arco-íris
	// Color changes at the first line of tooltip via ModifyTooltips.
	Tooltip: "'Deixe o arco-íris te lembrar que juntos sempre iremos brilhar...'"
}

Rancor: {
	DisplayName: Rancor
	Tooltip:
		'''
		Conjura um círculo mágico que carrega energia e eventualmente libera uma explosão poderosa de lasers com magia maléfica controlada
		Os lasers fazem com que braços e lava ardente apareçam em superfícies que eles tocam
		'''
	Calamitas:
		'''
		"Yharim me disse que foi Otonilou quem soltou a Elemental de Enxofre em Azafure.
		      Na época, acreditei nele, pois era uma criança procurando alguém para culpar por todos os seus infortúnios.
		      Então, descarreguei sobre todos eles toda a fúria e o desprezo que achava que mereciam, e só quando já era tarde demais é que percebi que ele estava mentindo."
		'''
}

RecitationoftheBeast: {
	DisplayName: Recitação da Besta
	Tooltip:
		'''
		Invoca foices da besta em volta do jogador em um círculo pequeno
		As foices são disparadas na direção do cursor e perseguem inimigos próximos
		'''
}

RelicofRuin: {
	DisplayName: Relíquia da Ruína
	Tooltip: Conjura uma série de lâminas de areia
}

RougeSlash: {
	DisplayName: Corte Escarlate
	Tooltip: Dispara uma onda de 3 cortes aéreos escarlates
}

SandstreamScepter: {
	DisplayName: Cetro do Fluxo de Areia
	Tooltip:
		'''
		Dispara um fluxo de areia explosivo que cai ao atingir um inimigo
		A explosão ocorre apenas quando o projétil expira
		'''
}

SanguineFlare: {
	DisplayName: Chama Sanguinária
	Tooltip:
		'''
		Prepara uma chama sanguinária que ganha mais poder conforme é carregada
		Ao atingir um inimigo, esta chama causa uma explosão de sangue e se divide em orbes de sangue
		Coletar estes orbes de sangue reduz a duração do [cbuffplr:PotionSickness]
		'''
}

SeethingDischarge: {
	DisplayName: Descarga Fervente
	Tooltip:
		'''
		Dispara um arco de explosões do inferno de enxofre que acelera gradualmente
		Cada terceiro ataque invoca um anel de dardos de enxofre que persegue os inimigos
		'''
}

Serpentine: {
	DisplayName: Serpentina
	Tooltip:
		'''
		Conjura uma serpente que segue o cursor
		{$Common.ArmorPenetration}
		'''
}

ShadecrystalBarrage: {
	DisplayName: Barragem de Cristais Sombrios
	Tooltip: Invoca rajadas de cristais sombrios que perseguem os inimigos
}

ShaderainStaff: {
	DisplayName: Cajado da Chuva Sombria
	Tooltip: Dispara nuvens e chuvas malignas em um arco
}

ShadowboltStaff: {
	DisplayName: Cajado do Raio Sombrio
	Tooltip: Dispara um feixe das sombras que cria uma plataforma para se redirecionar aos inimigos, causando mais dano
}

ShiftingSands: {
	DisplayName: Cajado da Areia Movediça
	Tooltip: Conjura um fragmento de areia que segue o cursor
}

SHPC: {
	DisplayName: CPSA
	Tooltip: "[GFB]"
	TooltipNormal:
		'''
		Consome Almas como munição
		Ejeta orbes de poder anímico concentrado, porém instável que perduram e explodem
		Os orbes emitem almas teleguiadas e almas coletáveis persistentes ao colidirem
		Os orbes têm vários efeitos dependendo do tipo de alma usado
		{0}
		<right> para usar a máquina como um aspirador, puxando almas coletáveis
		Ao soltar, é disparada uma barragem de lasers anímicos, cuja força escala com a quantidade de almas puxadas
		Segure Shift e <right> neste item em seu inventário para ejetar a Alma carregada
		'''
	// These are the soul effect descriptions, the number is the item ID of the soul
	NoSoul: "[c/808080:Não há nenhuma alma injetada na arma]"
	SoulDesc520: "[c/F01DC4:Orbes infundidos com a Luz criam explosões maiores]"
	SoulDesc521: "[c/7B1DDC:Orbes infundidos com a Noite criam explosões mais duradouras]"
	SoulDesc575: "[c/6AF0FA:Orbes infundidos com o Voo viajam mais rápido e restauram o tempo de voo no acerto direto]"
	SoulDesc548: "[c/0433DE:Orbes infundidos com a Força aplicam um recuo poderoso aos inimigos]"
	SoulDesc549: "[c/4FFF7C:Orbes infundidos com a Visão perseguem os inimigos próximos]"
	SoulDesc547: "[c/FF6014:Orbes infundidos com o Medo causam dano fixo adicional com seu ódio]"
	LegendaryText:
		'''
		'Embora as máquinas movidas a almas tenham sido quase um fracasso, as almas ainda mostravam potencial como combustível.
		Para evitar a principal falha dos meus últimos testes, o Canhão de Plasma de Sifonamento de Almas foi criado para disparar almas antes que elas assumam o controle da arma.
		Cada tipo de alma reage de forma diferente ao plasma básico. Porém, a falta de voluntários torna muito difícil obter munição para novos testes.
		É uma pena, pois essa arma poderia ter munição quase ilimitada no campo de batalha. Talvez um dia seu verdadeiro potencial seja testado.'
		'''
	TooltipGFB: Ele escala novamente :)
}

SkyGlaze: {
	DisplayName: Brilho Celeste
	Tooltip: Dispara penas dos céus que grudam nos inimigos e peças e explodem
}

SlitheringEels: {
	DisplayName: Enguias Rastejantes
	Tooltip: Conjura uma enguia ácida mágica que libera ácido conforme viaja
}

SnowstormStaff: {
	DisplayName: Cajado da Nevasca
	Tooltip:
		'''
		Dispara flocos de neve que seguem o cursor
		Os flocos de neve se dividem em estrelas de gelo no acerto
		'''
}

SoulPiercer: {
	DisplayName: Perfurador de Almas
	Tooltip: Conjura um raio poderoso que invoca mais raios no primeiro acerto
}

StaffofBlushie: {
	DisplayName: Cajado de Blushie
	Tooltip: Segure o botão esquerdo, espere, espere, espere, e confie no poder da magia azul
}

StarShower: {
	DisplayName: Chuva de Estrelas
	Tooltip: Conjura uma série de estrelas astrais dos céus que convergem no cursor
}

SubsumingVortex: {
	DisplayName: Vórtice Subsumidor
	Tooltip:
		'''
		<left> para liberar uma barragem de vórtices que correm atrás dos inimigos
		<right> para conjurar um vórtice enorme na sua frente que tende a seguir o mouse
		Quando os inimigos estiverem próximos ao vórtice, ele lança diversos vórtices menores e mais rápidos na direção deles
		Soltar o <right> dispara o vórtice em direção ao mouse se tempo suficiente tiver passado
		O dano aumenta de acordo com o tempo de carregamento do vórtice
		Inimigos atingidos são consumidos por completo pela [cbuff:CalamityMod/MiracleBlight]
		'''
}

Sylvestaff: {
	DisplayName: Cajado Silvestre
	Tooltip:
		'''
		Conjura um feixe que rebate em paredes e se divide quando inimigos estão próximos
		'Também conhecido como o Cajado do Carma!'
		'''
}

TacticiansTrumpCard: {
	DisplayName: O Trunfo do Estrategista
	Tooltip:
		'''
		Dispara um feixe de lâmina [cbuff:Electrified]
		'Lembranças vagas de uma princesa do futuro cruzam sua mente...'
		'''
}

TearsofHeaven: {
	DisplayName: Lágrimas do Céu
	Tooltip: Conjura bolas de luz celestiais lentas que perseguem o inimigo
}

Teslastaff: {
	DisplayName: Cajado de Tesla
	Tooltip:
		'''
		Dispara um feixe canalizado de relâmpagos precisos
		O feixe tem uma capacidade de rotação limitada
		Cada acerto sucessivo no mesmo inimigo aumenta o dano causado
		O dano aumenta em 10% por acerto até um máximo de 500% de dano
		Este dano cairá rapidamente depois que o inimigo parar de ser atingido
		'''
}

TheCauldron: {
	DisplayName: O Caldeirão
	Tooltip:
		'''
		Lança bombas de lava que explodem em mais bombas de lava
		80% de redução no custo de mana enquanto estiver submergido em lava ou no submundo
		'Acredite se quiser, mas seu portador original tinha apenas alguns centímetros de altura!'
		'''
}

TheDanceofLight: {
	DisplayName: A Dança da Luz
	Tooltip:
		'''
		Barragens de inimigos com uma geada de Lâminas da Luz
		'E num clarão de luz, nada resta'
		'''
}

ThePrince: {
	DisplayName: O Príncipe
	Tooltip:
		'''
		Conjura uma bola de fogo sagrada que explode em seis chamas teleguiadas
		'Então você tá me dizendo que o príncipe explodiu... e depois virou uma flor?'
		-Dain, o druida marinheiro
		'''
}

TheSwarmer: {
	DisplayName: O Enxameador
	Tooltip: Dispara um enxame de abelhas e vespas
}

TheWand: {
	DisplayName: A Varinha
	Tooltip: A varinha suprema
}

ThornBlossom: {
	DisplayName: Flor-de-espinho
	Tooltip:
		'''
		Conjura uma flor radiante que explode em pétalas teleguiadas junto de um espinho mortal
		Custa 3 de vida para disparar
		'Nem tudo é um mar de rosas'
		'''
}

Tradewinds: {
	DisplayName: Alísios
	Tooltip: Conjura penas de luz solar que se movem rapidamente
}

UltraLiquidator: {
	DisplayName: Ultra Liquidador
	Tooltip: Invoca lâminas de liquidação que invocam mais lâminas ao atingir um inimigo
}

UndinesRetribution: {
	DisplayName: Retribuição de Undine
	Tooltip: Conjura uma barragem de lanças teleguiadas
}

UnstableCastersGauntlet: {
	DisplayName: Manopla do Conjurador Instável
	Tooltip:
		'''
		<left> para disparar agulhas perfurantes
		<right> para invocar um anel de símbolos, cada um representando um elemento primordial
		Segure <left> com símbolos disponíveis para consumir símbolos aleatórios, cada um desencadeando um ataque
		<right> novamente enquanto o anel elemental está ativo para substituir todos os espaços livres com símbolos [c/DD84E8:Distorcidos]
		Símbolos [c/DD84E8:distorcidos] disparam automaticamente uma série de projéteis roxos imprecisos
		Todas as ações exigem [c/EADAF5:Vis] o suficiente para serem executadas
		[c/EADAF5:Vis] é recuperado com o tempo
		'''
	HoldShiftTooltip:
		'''
		Símbolos [c/DBD7CA:Ordo] sempre causam um acerto crítico
		Símbolos [c/ABB6D4:Perdito] ignoram 25 pontos de defesa do inimigo
		Símbolos [c/E89B8E:Ignis] infligem [cbuff:CalamityMod/Daybroken]
		Símbolos [c/8ECBE8:Aqua] infligem [cbuff:CalamityMod/CrushDepth]
		Símbolos [c/E1E88E:Aer] têm um recuo muito maior
		Símbolos [c/ACCF9F:Terra] se dividem em pedras pontiagudas
		'''
}

ValkyrieRay: {
	DisplayName: Raio da Valquíria
	Tooltip: Conjura um raio devastador de poder sagrado
}

VeeringWind: {
	DisplayName: Ventomoinho
	Tooltip:
		'''
		Conjura uma barragem circular de ondas de vento com um alto recuo
		<right> para conjurar uma barragem circular de ondas de frio
		'''
}

Vehemence: {
	DisplayName: Veemência
	Tooltip: Conjura raios intensos de poder infernal que explodem em crânios
}

VenusianTrident: {
	DisplayName: Tridente Venusiano
	Tooltip:
		'''
		Conjura um tridente infernal que irrompe em uma explosão gigantesca de fogo e fragmentos de magma
		Sempre causa acertos críticos, e a chance de acerto crítico aumenta o dano por acerto crítico
		'''
}

Vesuvius: {
	DisplayName: Vesúvio
	Tooltip:
		'''
		Invoca uma barragem de asteróides derretidos
		<right> para disparar uma barragem de asteróides derretidos do cajado
		'''
}

Viscera: {
	DisplayName: Víscera
	Tooltip:
		'''
		Dispara uma barragem rápida de feixes de sangue perfurantes
		O primeiro inimigo atingido por cada feixe explodirá em orbes de sangue
		Coletar estes orbes de sangue reduz a duração do [cbuffplr:PotionSickness]
		Cada feixe sucessivo na barragem causa mais dano
		O último feixe da barragem causa uma explosão ao atingir um inimigo
		'''
}

VitriolicViper: {
	DisplayName: Víbora Vitriólica
	Tooltip:
		'''
