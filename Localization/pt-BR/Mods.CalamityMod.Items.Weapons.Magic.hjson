		'''
}

VividClarity: {
	DisplayName: Clareza Vívida
	Tooltip:
		'''
		Dispara cinco raios aleatórios de energia exo na direção do cursor
		Inimigos e peças atingidas podem causar um clarão enorme, invocar um laser dos céus, ou se dividirem em energia
		Inimigos atingidos são liquidados com a [cbuff:CalamityMod/MiracleBlight]
		'Sua majestade inspira um golpe de gênio incomparável'
		'''
}

VoidVortex: {
	DisplayName: Vórtice do Vazio
	Tooltip: Conjura um vórtice giratório de esferas magnéticas supercarregadas ao redor do cursor que explode em uma tempestade de mini esferas teleguiadas
}

VoltaicClimax: {
	DisplayName: Clímax Voltaico
	Tooltip: Conjura um anel de esferas magnéticas supercarregadas ao redor do cursor
}

Volterion: {
	DisplayName: Volterion
	Tooltip:
		'''
		Descarrega um fluxo de alta voltagem que explode em cinco bolas-relâmpago no acerto
		Cada bola-relâmpago emite mais dois relâmpagos antes de explodir
		'''
}

Waywasher: {
	DisplayName: Lava-caminhos
