		'''
		Invoca dois Braços-direitos que orbitam você e disparam lasers na direção do cursor
		<right> enquanto dispara para mandar os Braços-direitos dispararem granadas
		As granadas têm um tempo de recarga que é reduzido se os Braços-Direitos estiverem totalmente aquecidos 
		'''
}

WintersFury: {
	DisplayName: Fúria do Inverno
	Tooltip:
		'''
		Dispara uma série de orbes de gelo e uma barragem de estilhaços de gelo na direção do cursor
		'As páginas estão congelantes ao toque'
		'''
}

WulfrumProsthesis: {
	DisplayName: Prótese de Vulfrúmio
	Tooltip:
		'''
		Conjura um raio de vulfrúmio
		<right> para drenar mana de criaturas em sua frente
		[c/83B87E:'Tecnologia e magia estão há muito tempo presas em uma corrida armamentista de imitação e retaliação.]
		[c/83B87E:Às vezes, eles trabalham em conjunto, como visto em certos membros protéticos.']
		'''
}

WyvernsCall: {
	DisplayName: Rugido da Serpe
	Tooltip:
		'''
		Dispara serpes e penas coloridas dos céus que grudam nos inimigos e peças e explodem
