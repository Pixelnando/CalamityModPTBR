AdamantiteThrowingAxe: {
	DisplayName: Machado de Arremesso de Adamantina
	Tooltip: Golpes furtivos ignoram a gravidade e causam uma chuva de relâmpagos localizada no inimigo
}

AntlionSkewer: {
	// DisplayName: Antlion Skewer
	/* Tooltip:
		'''
		Throws living, skewered Antlions that fire sand blasts
		Stealth strikes spew a mess of sand balls and gust
		Sand clouds temporarily lower enemy contact damage
		''' */
}

Apoctolith: {
	DisplayName: Apoctólito
	Tooltip:
		'''
		Ataques críticos rasgam a defesa dos inimigos
		Golpes furtivos explodem em fragmentos e atordoam brevemente os inimigos
		'Pensando bem, tentar pegar tijolos com a cara não foi uma boa ideia...'
		'''
}

AshenStalactite: {
	DisplayName: Estalactite Cinzenta
	Tooltip:
		'''
		Lança uma pequena estalactite que se desfaz em pó após percorrer uma curta distância
		Golpes furtivos lançam uma estalagmite mais poderosa e duradoura, embora mais lenta, que se desfaz em pó danoso
		'''
}

AuroradicalThrow: {
	DisplayName: Arremesso Auroradical
	Tooltip:
		'''
		Lança uma estrela que se divide após um curto período de tempo
		Estrelas divididas perseguem os inimigos após alguns segundos
		Golpes furtivos invocam um meteoro ao atingir um inimigo
		'''
}

BallisticPoisonBomb: {
	DisplayName: Bomba Balística de Veneno
	Tooltip:
		'''
		Lança uma bomba grudenta que explode em espinhos e nuvens venenosas
		Golpes furtivos irrompem em mais nuvens com um veneno mais duradouro
		'''
}

BlastBarrel: {
	DisplayName: Barril da Rajada
	Tooltip:
		'''
		Arremessa um barril rolante que explode ao colidir com uma parede
		Golpes furtivos fazem com que o barril ricocheteie duas vezes antes de desaparecer com efeitos variados após cada ricochete
		'Algumas pessoas pulavam por cima de barris como esses'
		'''
}

BlazingStar: {
	DisplayName: Estela Ardente
	Tooltip:
		'''
		Arremessa até 3 gládios super quentes que vão e voltam
		Golpes furtivos arremessam três gládios com perfuração infinita
		'''
}

BloodsoakedCrasher: {
	DisplayName: Esmagador Ensanguentado
	Tooltip:
		'''
		Lança um machado ensanguentado que é afetado pela gravidade e pode ricochetear duas vezes
		O machado acelera com o tempo, mas desacelerará ao atingir um inimigo
		Concede cura ao atingir um inimigo
		Golpes furtivos invocam fluxos de sangue teleguiados ao atingir um inimigo
		'''
}

BouncingEyeball: {
	DisplayName: Globo Ocular Saltitante
	Tooltip:
		'''
		Lança um globo ocular que ricocheteia em superfícies
		Golpes furtivos tornam os globos oculares muito mais velozes e ainda mais saltitantes
		O recuo é mais forte durante uma lua de sangue
		'''
}

Brimblade: {
	DisplayName: Serra de Enxofre
	Tooltip:
		'''
		Lança uma serra que se divide ao atingir um inimigo
		Golpes furtivos se dividem ainda mais e lançam adicionalmente uma barragem de dardos de enxofre
		'''
}

BurningStrife: {
	DisplayName: Porfia Ardente
	Tooltip:
		'''
		Lança uma bola com espinhos de chama das sombras que explode em chamas
		Golpes furtivos tornam a bola mais duradoura e sua explosão mais violenta
		'Nem pense em colocá-la em seus bolsos'
		'''
}

CelestialReaper: {
	DisplayName: Ceifador Celestial
	Tooltip:
		'''
		Lança uma foice veloz e teleguiada
		A foice ricocheteará depois de atingir um inimigo até no máximo seis vezes
		Golpes furtivos criam pós-imagens danosas
		'''
}

Celestus: {
	DisplayName: Celestus
	Tooltip:
		'''
		Arremessa uma foice de alta velocidade que se divide em diversas foices-fantasma ao atingir um inimigo
		Golpes furtivos invertem a direção e seguem os inimigos após retornarem ao jogador
		'''
}

Cinquedea: {
	DisplayName: Cinquedea
	Tooltip: Golpes furtivos se tornam teleguiados após atingir um inimigo
}

CobaltKunai: {
	DisplayName: Kunai de Cobalto
	Tooltip: Golpes furtivos disparam três raios de energia de cobalto teleguiados
}

ConsecratedWater: {
	DisplayName: Água Consagrada
	Tooltip:
		'''
		Lança um frasco de água que explode em um pilar de chamas sagradas
		O pilar é destruído se não houver peças abaixo dele
		Golpes furtivos criam três pilares em vez de um no impacto
		A garrafa está surpreendentemente empoeirada
		'''
}

ContaminatedBile: {
	DisplayName: Bile Contaminada
	Tooltip:
		'''
		Lança um frasco de bile irradiada de uma cor verde doentia que explode ao colidir
		Golpes furtivos tornam a explosão muito mais violenta e poderosa
		'''
}

CorpusAvertor: {
	DisplayName: Corpus Avertor
	Tooltip:
		'''
		Ataques roubam vida com base no dano causado
		Esta arma causa mais dano e rouba mais vida do inimigo caso sua vida esteja baixa
		Golpes furtivos lançam uma adaga contornada por um arco-íris
		Ao atingir um inimigo, esta adaga concede os seguintes efeitos para todos os membros do time:
		10% de aumento nos danos e regeneração de +2 de vida por segundo 
		No entanto, há uma pequena chance da adaga cortar a sua vida na metade e anular o efeito anterior
		'Parece que se desgastou com o tempo'
		'''
}

CosmicKunai: {
	DisplayName: Kunai Cósmica
	Tooltip:
		'''
		Dispara um fluxo rápido de kunais de curto alcance
		Golpes furtivos tornam as kunais perfurantes, mais duradouras e adicionalmente invocam cinco foices teleguiadas
		'''
}

CraniumSmasher: {
	DisplayName: Esmaga-Crânios
	Tooltip:
		'''
		Lança discos que rolam no chão
		Ocasionalmente lança um disco explosivo
		Golpes furtivos lançam um disco explosivo que pode perfurar diversos inimigos
		'''
}

CrushsawCrasher: {
	DisplayName: Garra Esmagadora
	Tooltip:
		'''
		Lança machados saltitantes
		Golpes furtivos lançam cinco de uma só vez
		'''
