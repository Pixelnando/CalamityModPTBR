Brimrose: {
	DisplayName: Rosa de Enxofre
	Tooltip: Invoca uma rosa de enxofre que pode ser montada
}

ExoArmamentsKit: {
	DisplayName: Kit de Armamentos Exo
	Tooltip:
		'''
		Invoca uma máquina de guerra que pode ser montada
		'Uma superarma perfeita para o seu porte'
		'''
}

ExoThrone: {
	DisplayName: Caixa Exo
	Tooltip:
		'''
		Materializa um Trono Exo bem aconchegante e extremamente ágil
		Segure [KEY] enquanto estiver sentado no trono para movimentar-se mais lento para obter mais precisão
		'Um gamer confortável é um gamer perigoso'
		'''
}

FollyFeed: {
	DisplayName: Comida de Bobos
	Tooltip: Invoca uma monstruosidade que pode ser montada
}

GazeOfCrysthamyr: {
	DisplayName: Olhar de Crysthamyr
	Tooltip:
		'''
		Invoca um dragão das sombras que pode ser montado
		Segure {$Key.UP} para ascender mais rápido
		'''
}

TheCartofGods: {
	DisplayName: A Vagoneta dos Deuses
	Tooltip: ""
}

OnyxExcavatorKey: {
	DisplayName: Chave da Escavadeira de Ônix
	Tooltip:
		'''
		Invoca uma Furadeira de Ônix que pode ser montada
		Segure <left> para furar blocos enquanto se movimenta horizontalmente ou para baixo
		O poder da picareta e a velocidade de mineração da furadeira seguem a melhor picareta do seu inventário
		'Demolir irresponsavelmente todo o belíssimo terreno e causar uma devastação ecológica descontrolada? Esplêndido'
		'''
}

SuspiciousLookingJellyBean: {
	DisplayName: Jujuba Suspeita
	Tooltip: JUJUBA
}

TundraLeash: {
	DisplayName: Coleira da Tundra
	Tooltip: Invoca um Cão-da-geada que pode ser montado
}
