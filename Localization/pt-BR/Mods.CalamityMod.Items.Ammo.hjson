AstralSolution: {
	DisplayName: Solução Astral
	Tooltip:
		'''
		Utilizado pelo Limpaminador
		Espalha a Infecção Astral
		'''
}

BloodfireArrow: {
	DisplayName: Flecha de Fogo Sangrento
	Tooltip:
		'''
		Flechas de alta velocidade com uma ponta encharcada de sangue
		Disparar estas flechas drenará a sua vida e aumentará o dano da flecha em 30%
		Acelera a sua regeneração de vida natural e te cura ao atingir o inimigo
		'''
}

BloodfireBullet: {
	DisplayName: Projétil de Fogo Sangrento
	Tooltip:
		'''
		Atravessa peças e acelera a sua regeneração de vida natural no acerto com base na força do acerto
		Causa mais danos de acordo com sua regeneração de vida natural
		Este dano tem um limite de 1,1x
		'''
}

BloodRune: {
	DisplayName: Runa de Sangue
	Tooltip:
		'''
		Usada pela Barragem de Gelo
		'Encontrado em algum tipo de paisagem rúnica'
		'''
}

BubonicRound: {
	DisplayName: Tiro Bubônico
	Tooltip: Espalha a [cbuff:CalamityMod/Plague] no acerto e ignora 10% da defesa do inimigo
}

CinderArrow: {
	DisplayName: Flecha Cinzenta
	Tooltip: Flechas explosivas que explodem em Fragmentos de Enxofre flamejantes mais fracos
}

DryadsTear: {
	DisplayName: Lágrima da Dríade
	Tooltip:
		'''
		Um projétil mágico extremamente poderoso abençoado com a essência da natureza que se torna instável quando há vários por perto
		Acompanha uma lágrima que se separará e colidirá com o inimigo atingido, causando uma explosão
		Todos os acertos do projétil e da lágrima perfuram 18 pontos de armadura
		[c/40E091:'Foco. Respira. Só mais um tiro, e a violência vai desaparecer...']
		'''
}

ElysianArrow: {
	DisplayName: Flecha do Elísio
	Tooltip: Invoca luz purificante por cima e por baixo no inimigo mais próximo no acerto
}

FlashRound: {
	DisplayName: Tiro Brilhante
	Tooltip:
		'''
		Um projétil que causa mais dano com cada ricochete
		O aumento no dano é de 1,13x ou +2 de dano plano por ricochete, dependendo do mais forte
		'''
}

GodSlayerSlug: {
	DisplayName: Bala Caça-deuses
	Tooltip:
		'''
		Munição pesada com perfuração ilimitada que dilacera o espaço-tempo
		Balas que atingirem um alvo dobram o caminho e se sobrecarregam, se estilhaçando no acerto
		'''
}

HailstormBullet: {
	DisplayName: Projétil de Granizo
	Tooltip:
		'''
		Depois de atirados, os projéteis rapidamente desaceleram
		Acertos críticos causam um congelamento instantâneo, causando mais dano e congelando inimigos normais
		'''
}

HallowPointRound: {
	DisplayName: Bala de Ponta Sagrada
	Tooltip:
		'''
		Libera luz galante no acerto que aumenta o dano base do projétil para [DAMAGE]
		Este efeito não ocorre se os projéteis forem convertidos por armas especiais
		'''
}

HolyFireBullet: {
	DisplayName: Projétil de Fogo Sagrado
	Tooltip:
		'''
		Projéteis profanos que causam 1,15x o dano e explodem no impacto
		A explosão é maior e o projétil causa mais dano se o impacto ocorrer logo após o disparo
		O dano adicional tem um limite de 1,15x
		'''
}

HyperiusBullet: {
	DisplayName: Projétil de Hipério
	Tooltip:
		'''
		Projéteis multicoloridos deslumbrantes que se transformam em luzes rodopiantes ao atingir o alvo
		Danos que seriam causados pelos projéteis é armazenado no alvo
		Conforme mais dano é armazenado, ele começará a sobrecarregar, sendo liberado lentamente e machucando o inimigo
		Ataques de outras fontes além dos Projéteis de Hipério liberarão um pouco da carga
		Liberar a carga desta maneira causa 20% a mais de dano
		'''
}

IcicleArrow: {
	DisplayName: Flecha de Gelo
	Tooltip:
		'''
		Ao serem disparadas, as flechas rapidamente congelam em gelos em queda
		Atingir inimigos ou peças antes que a flecha congele por completo ricocheteia a flecha para cima
		'''
}

MarksmanRound: {
	DisplayName: Tiro do Atirador
	Tooltip:
		'''
		Um tiro cuidadosamente elaborado que pode ricochetear em moedas no ar
		Isso permite que outras armas utilizem as moedas lançadas por Colt do Tiro do Craque e Midas Alfa
		'''
}

MortarRound: {
	DisplayName: Tiro de Morteiro
	Tooltip:
		'''
		Tiros altamente explosivos especializados
		Grande raio de impacto. Destrói peças
		Usado por armas normais
		'''
}

RubberMortarRound: {
	DisplayName: Tiro de Morteiro de Borracha
	Tooltip:
		'''
		Tiros altamente explosivos especializados
		Grande raio de impacto. Destrói peças a cada vez que ricocheteia
		Usado por armas normais
		'''
}

SproutingArrow: {
	DisplayName: Flecha Brotante
	Tooltip:
		'''
		Dispara uma flecha energizada que rapidamente se divide em duas flechas
		Essas flechas ignoram 8 pontos de defesa
		'''
}

VanquisherArrow: {
	DisplayName: Flecha do Vencedor
	Tooltip:
		'''
		Perfura peças e é teleguiada nos inimigos
		Rasga o espaço ao atingir o inimigo
		'''
}

VeriumBolt: {
	DisplayName: Feixe de Vério
	Tooltip:
		'''
		Marca os inimigos ao atingí-los, causando mais dano após um curto período de tempo
		Este dano é acumulado com base na quantidade de feixes que atingiram o inimigo
		'Não há escapatória...'
		'''
}
