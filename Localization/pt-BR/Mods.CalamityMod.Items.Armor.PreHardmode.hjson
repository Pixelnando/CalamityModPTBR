VictideBreastplate: {
	DisplayName: Peitoral de Vimaré
	Tooltip:
		'''
		5% de aumento na redução dos danos e chance de acerto crítico
		+5 de defesa e 10% de aumento nos danos enquanto você está submerso em líquidos
		'''
	CommonSetBonus:
		'''
		Enquanto você usa qualquer arma, você tem 10% de chance de arremessar um projétil de concha que retorna para você
		Esta concha causa dano verdadeiro e não se beneficia de nenhuma classe de dano
		Concede maior mobilidade embaixo d´água e levemente reduz a perda de fôlego no abismo
		'''
}

