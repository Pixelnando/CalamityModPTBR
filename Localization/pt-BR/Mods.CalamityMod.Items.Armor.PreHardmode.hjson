DesertProwlerHat: {
	DisplayName: Chapéu do Gatuno do Deserto
	Tooltip: "{$Common.RogueCrit}"
	SetBonus:
		'''
		{$Common.RogueStealth}
		[c/{1}:Bomba de Fumaça de Areia - {2} para se encobrir de uma pequena nuvem de areia]
		[c/CCB648:Enquanto a nuvem de areia está ativada, ganhe um aumento na mobilidade mas uma redução na defesa]
		[c/CCB648:Usar uma arma ladina imediatamente dissipa o manto de areia, mas garante um super crítico por {3}% de dano]
		[c/CCB648:O super crítico aplica contanto que o acerto resultante não excedesse {4} de dano]
		[c/CCB648:Atingir o golpe fatal num inimigo com esse tiro reduz a duração do tempo de recarga da habilidade para {5} {^5:segundo;segundos}]
		'''
}

