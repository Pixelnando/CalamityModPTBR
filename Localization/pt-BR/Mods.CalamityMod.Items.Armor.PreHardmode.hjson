AerospecBreastplate: {
	DisplayName: Peitoral Aeroespectral
	Tooltip: "{$CommonItemTooltip.PercentIncreasedDamageCritChance}"
	CommonSetBonus:
		'''
		Sofrer mais de {0} de dano de um ataque fará com que penas teleguiadas caiam do céu
		Permite que você caia mais rapidamente e desativa o dano de queda
		'''
}

AerospecHeadMagic: {
	DisplayName: Chapéu Aeroespectral
	Tooltip:
		'''
		{$CommonItemTooltip.IncreasesMaxManaBy}
		{$CommonItemTooltip.PercentIncreasedMagicDamage@1}
		'''
	SetBonus:
		'''
		{$CommonItemTooltip.PercentReducedManaCost}
		{1}% de aumento na velocidade dos movimentos e na chance de acerto crítico mágico
		{$AerospecBreastplate.CommonSetBonus@2}
		'''
}

