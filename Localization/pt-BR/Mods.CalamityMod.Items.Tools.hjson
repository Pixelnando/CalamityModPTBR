TheGift: {
	DisplayName: O Presente
	Tooltip:
		'''
		Deixe este presente perto de um de seus NPCs de cidade como um sinal de agradecimento
		Pode fazê-lo amá-lo ou odiá-lo, você não saberá até que ele o abra!
		O efeito durará 24 horas
		'''
	SalesPitch:
		'''
		'Comprar presentes para alguém é difícil, e você tem que garantir que seus cidadãos estejam felizes. Que tal matar dois coelhos numa tacada?'
		'Entregue essa caixinha divertida para alguém e ela terá o presente perfeito para a pessoa a quem você o entregou!' 
		'''
}

