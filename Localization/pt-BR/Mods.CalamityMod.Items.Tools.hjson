		'''
}

Cosmolight: {
	DisplayName: Luz Cósmica
	Tooltip:
		'''
		Avança o tempo imediatamente para o próximo amanhecer, meio-dia, anoitecer ou meia-noite
		Não funciona enquanto um chefe está vivo
		'''
}

TorrentialTear: {
	DisplayName: Lágrima Torrencial
	Tooltip:
		'''
		Invoca a chuva
		A chuva começará um tempo depois que este item for usado
		Se usado enquanto está chovendo, a chuva irá acabar após um tempo
		'''
}

