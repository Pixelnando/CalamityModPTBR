	Tooltip:
		'''
		Invoca um espírito solar para protegê-lo
		Invocações repetidas aumentam seu poder
		'''
}

TacticalPlagueEngine: {
	DisplayName: Motor de Praga Tático
	Tooltip:
		'''
		Invoca um jato da [cbuff:CalamityMod/Plague] para esmagar seus inimigos até a submissão
		Os jatos dispararão projéteis de seu inventário
		Ás vezes disparam um míssil em vez de um projétil
		50% de chance de economizar munição
		Os mísseis não consomem munição
		'''
}

TemporalUmbrella: {
	DisplayName: Guarda-Chuva Temporal
	Tooltip:
		'''
		Invoca uma variedade de ferramentas para auxiliá-lo na batalha
			- Uma flecha vermelha para perfurar seus adversários
			- Um martelo marmelada para bater nos inimigos com estilo
			- Um machado de jade para cortar monstros e ocasionalmente derrubar uma árvore
			- Um guarda-chuva ciano para derrotar seus inimigos com elegância
			- Um rifle de lavanda para atirar em quem estiver no seu caminho
		E o melhor de tudo, você pode usar uma cartola
		Só pode haver um conjunto de ferramentas por vez
		'Surpreendentemente resistente, acho que isso poderia derrotar a Máfia com um único golpe'
		'''
}

TundraFlameBlossomsStaff: {
	DisplayName: Cajado das Flores da Tundra Flamejante
	Tooltip:
		'''
		Invoca três orquídeas de chamas de gelo sobre sua cabeça
		Cada flor consome um espaço de lacaio
		'''
}

UniverseSplitter: {
	DisplayName: Divisor de Universos
	Tooltip:
		'''
		Invoca um campo de energia no cursor
		Após o campo ser implantado, ele começa a convocar vários pequenos feixes
		Após vários segundos, um enorme raio laser aparece na posição do campo
		Este efeito possui um tempo de recarga de 30 segundos
		Tentar usar este item durante o tempo de recarga causará um curto-circuito e causará dano a você
		[c/BB57FF:'Um artefato antigo de uma era passada aguarda seu comando.]
		[c/BB57FF:Essa é uma ideia terrível, mas não é sua de qualquer maneira... né?']
		'''
}

VengefulSunStaff: {
	DisplayName: Cajado do Sol Vingativo
	Tooltip:
		'''
		Invoca um espírito solar vingativo para protegê-lo
		Invocações repetidas eclipsam o espírito e aumentam seu poder
		'''
}

Vigilance: {
	DisplayName: Vigilância
	Tooltip: Invoca um caçador de almas para lutar por você
}

VileFeeder: {
