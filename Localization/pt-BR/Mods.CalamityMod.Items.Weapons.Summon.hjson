}

Sirius: {
	DisplayName: Sírius
	Tooltip:
		'''
		Invoca a estrela mais brilhante do céu, Sírius, para te proteger
		Continue invocando para completar a Cão Maior
		Invocações repetidas aumentam muito seu poder, até mesmo com a constelação completa
		Sírius passivamente regenera Explosões Estelares enquanto foca os inimigos
		Com as Explosões Estelares completas, Sírius as consome para lançar um quasar perfurante e poderoso que inflige [cbuff:CalamityMod/Voidfrost]
		'Um guia a um sonho nunca realizado'
		'''
}

SlimePuppetStaff: {
