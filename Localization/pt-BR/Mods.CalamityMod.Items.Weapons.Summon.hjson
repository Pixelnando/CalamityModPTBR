AbandonedSlimeStaff: {
	DisplayName: Cajado da Geleia Abandonada
	Tooltip:
		'''
		Invoca uma geleia astral que espalha a [cbuff:CalamityMod/AstralInfectionDebuff]
		Consome todos os espaços de lacaio restantes ao ser usado
		Deve ser utilizado pela hotbar
		O poder e o tamanho aumentam de acordo com o número de espaços de lacaio utilizados
		Segurar essa arma concede 10% de aumento na velocidade dos pulos
		Expulsa dos céus com desgosto, esta relíquia canta uma canção de tragédia silenciosa...
		'''
}

AmphibiansGuitar: {
	DisplayName: Violão do Anfíbio
	Tooltip:
		'''
		Invoca até 8 violões e guitarras que giram ao seu redor e disparam notas e tiros espalhados
		Se todas as 8 guitarras estiverem presentes, algumas notas ficam mais fortes, causando mais dano
		'Eu vou te mostrar o que é sofrer!'
		'''
}

AncientIceChunk: {
	DisplayName: Pedaço de Gelo Antigo
	Tooltip:
		'''
		Invoca uma Pinça-de-gelo para lutar por você
		A Pinça-de-gelo dispara fragmentos de gelo em inimigos distantes
		Quando estiver próximo dos inimigos, ela irá atacá-los agressivamente com a fúria congelada
		'''
}

AquasScepter: {
	DisplayName: Cetro de Aqua
	Tooltip:
		'''
		{$CommonItemTooltip.Sentry}
		Invoca uma sentinela de tempestade enorme para fazer chover nos inimigos e golpeá-los com energia tesla sobrecarregada
		'Capitão! Eu acho- que temos risco de chuva!'
		'''
}

AresExoskeleton: {
	DisplayName: Exoesqueleto de Ares
	Tooltip:
		'''
		Cria um painel com quatro espaços para quatro escolhas acima dele: Plasma, Tesla, Laser e Gauss
		Clicar em uma das escolhas e depois clicar em um dos espaços invoca um canhão do tipo escolhido
		Clicar em um espaço que já está ocupado destrói o canhão associado e limpa o espaço
		'''
}

AtlasMunitionsBeacon: {
	DisplayName: Sinalizador de Munições Atlas
	Tooltip:
		'''
		{$CommonItemTooltip.Sentry}
		[c/F2B629:Traz um canhão estacionário com exo-energia
		[c/F2B629:O canhão atirará em inimigos dentro de seu alcance]
		[c/F27049:Se um inimigo estiver próximo, ele entrará no modo de Sobrecarga]
		[c/F27049:No modo Sobrecarga, o canhão usa todo o seu poder para derrubar qualquer inimigo]
		[c/F27049:No modo Sobrecarga, o canhão acumulará calor, eventualmente superaquecendo]
		[c/69F0DC:<right> enquando segura esse item para pegar o canhão e utilizá-lo por conta própria]
		[c/69F0DC:Enquanto é segurado, o canhão sempre estará no modo Sobrecarga]
		[c/69F0DC:Se o canhão superaquecer enquanto você o segura, você será forçado a soltá-lo]
		[c/9AA4AE:Pressionar o <right> permite que você solte-o manualmente]
		[c/9AA4AE:Se for soltado perto da base, ele será reconectado automaticamente]
		'É surpreendentemente fácil carregar isso'
		'''
}

BelladonnaSpiritStaff: {
	DisplayName: Cajado do Espírito de Beladona
	Tooltip: Invoca um espírito fofo da floresta que arremessa pétalas mágicas e tóxicas
}

BlackHawkRemote: {
	DisplayName: Controle Remoto Black Hawk
	Tooltip:
		'''
		Invoca um jato Black Hawk para lutar por você
		Os jatos dispararão projéteis do seu inventário
		50% de chance de economizar munição
		'''
}

BorealisBomber: {
	DisplayName: Bombardeiro Boreal
	Tooltip:
		'''
		Invoca bombardeiros de aureus para caçar seus inimigos
		Os bombardeiros de aureus explodem violentamente ao atingir um inimigo, espalhando a [cbuff:CalamityMod/AstralInfectionDebuff]
		Não consome espaços de lacaio
		'''
}

BrittleStarStaff: {
	DisplayName: Cajado da Estrelinha
	Tooltip:
		'''
		Invoca uma estrelinha para investir através dos inimigos até que despedace
		As estrelas-do-mar regenerarão rapidamente depois de despedaçarem
		Segurar <right> alternará o comportamento das estrelas-do-mar, fazendo com que invistam ou circulem-o
		Quando as estrelas-do-mar estão te circulando, cada uma concede {0} pontos de defesa
		'''
}

CadaverousCarrion: {
	DisplayName: Carniça Cadavérica
	Tooltip:
		'''
		{$CommonItemTooltip.Sentry}
		Invoca uma cabeça nojenta do Velho Duque no chão que vomita tubarões
		'''
}

CalamarisLament: {
	DisplayName: Lamento da Lula
	Tooltip: "[GFB]"
	TooltipNormal:
		'''
		Invoca uma lula em miniatura que cospe tinta ferozmente nos inimigos
		Em longas distâncias, a lula disparará barragens de tinta agressivamente teleguiadas
		Em curtas distâncias, a lula grudará nos inimigos e causar mais dano
		'No Abismo, todos os tipos de recursos são escassos.
		Cada espécie é solitária. Simplesmente não há o suficiente para compartilhar.'
		'''
	TooltipGFB: "'Woomy!'"
}

CausticCroakerStaff: {
	DisplayName: Cajado do Coaxador Cáustico
	Tooltip:
		'''
		{$CommonItemTooltip.Sentry}
		Invoca um sapo que explode caso inimigos se aproximem
		'''
}

CausticStaff: {
	DisplayName: Cajado Cáustico
	Tooltip:
		'''
		Invoca um mini dragão para lutar por você
		Conforme mais dragões são invocados, ele dispara com mais velocidade e causa mais efeitos negativos
		'''
	HoldShiftTooltip:
		'''
		Sempre inflige [cbuff:OnFire3]
		Inflige [cbuff:CursedInferno] com 2 dragões invocados
		Inflige [cbuff:Venom] com 3 dragões invocados
		Inflige [cbuff:Ichor] e [cbuff:CalamityMod/MarkedforDeath] com 4 dragões invocados
		'''
}

CinderBlossomStaff: {
	DisplayName: Cajado da Flor-de-cinzas
	Tooltip:
		'''
		Invoca uma flor escaldante sobre sua cabeça
		Só pode haver uma flor
		'''
}

CindersOfLament: {
	DisplayName: Cinzas Lamentosas
	Tooltip:
		'''
		Invoca Cataclismo ou Catástrofe dependendo da posição do mouse
		Eles olharão para você antes de realizar uma investida na sua direção
		Eles podem machucar você e os inimigos
		'''
	Calamitas:
		'''
		'Meus irmãos faleceram em Azafure. Encontrei seus cadáveres perto do centro da cidade, depois que saíram para uma expedição.
		Antes de ter o poder que tenho hoje, eles sempre estiveram do meu lado e não permitiam que ninguém me machucasse.
		Talvez tenha sido um problema às vezes, mas eles eram incrivelmente obedientes.
		E mesmo com tudo o que aconteceu, mesmo mortos, eles ainda cuidam de mim. Não é uma gentileza da parte deles?'
		'''
}

Cnidarian: {
	DisplayName: Cnidariano
	Tooltip:
		'''
		Pesca uma água-viva elétrica
		Periodicamente libera faísca para eletrocutar inimigos próximos
		[c/5C95A1:'Observando seus irmãos menos sábios, os habitantes do Velho Reino adaptaram ferramentas e armas projetadas para eficiência subaquática.]
		[c/5C95A1:As propriedades elétricas dos sinos fantasmas permanecem úteis mesmo após a morte, tendo sido comumente usados como condutores.']
		'''
}

CorroslimeStaff: {
	DisplayName: Cajado da Geleia Corrosiva
	Tooltip: Invoca uma Geleia Corrosiva para lutar por você
}

CorvidHarbringerStaff: {
	DisplayName: Cajado do Mensageiro Corvídeo
	Tooltip:
		'''
		Invoca um corvo poderoso que teleporta e realiza investidas
		'Nunca mais'
		'''
}

CosmicImmaterializer: {
	DisplayName: Imaterializador Cósmico
	Tooltip:
		'''
		Invoca um espiral de energia cósmica para lutar por você
		A espiral disparará barragens de raios de energia teleguiados quando inimigos forem detectados por ele
		Os inimigos atingidos são purificados com [cbuff:CalamityMod/MiracleBlight]
		Só pode haver uma espiral de energia
		'''
}

CosmicViperEngine: {
	DisplayName: Motor da Víbora Cósmica
	Tooltip:
		'''
		Invoca uma nave de guerra cósmica para abater seus inimigos
		As naves de guerra dispararão projéteis de seu inventário
		Alterna entre disparar foguetes e projéteis
		50% de chance de economizar munição
		Os foguetes não consomem munição
		'''
}

Cosmilamp: {
	DisplayName: Lâmpada Cósmica
	Tooltip: Invoca uma lâmpada cósmica sobre sua cabeça para lutar por você
}

CrimslimeStaff: {
	DisplayName: Cajado da Geleia do Carmim
	Tooltip: Invoca uma geleia do carmim para lutar por você
}

CryogenicStaff: {
	DisplayName: Cajado Criogênico
	Tooltip:
		'''
		{$CommonItemTooltip.Sentry}
		Invoca uma construção de gelo para libertar o frio sobre seus inimigos
		A taxa de disparo e o alcance aumentam à medida que o inimigo é focado por mais tempo
		'''
}

DaedalusGolemStaff: {
	DisplayName: Cajado do Golem de Dédalo
	Tooltip:
		'''
		Invoca um soldado Golem de Dédalo que dispara pelotas e eletricidade
		'O brilhante deus da ganância'
		'''
}

DankStaff: {
	DisplayName: Cajado Nojento
	Tooltip: Invoca um rastejante nojento para lutar por você
}

DazzlingStabberStaff: {
	DisplayName: Cajado do Esfaqueador Deslumbrante
	Tooltip:
		'''
		Invoca três adagas sagradas feitas de materiais profanos para lutar por você
		As adagas de chamas sagradas transformam galantemente em cinzas tudo o que se opõe a elas
		Adagas cristalinas cortam os inimigos em tiras com elegância
		Adagas profanas se fragmentam violentamente e se recompõem eternamente
		'Sempre em frente, rumo ao futuro dEla'
		'''
}

DeathstareRod: {
	DisplayName: Bastão do Olhar da Morte
	Tooltip:
		'''
		Invoca um olho sobre sua cabeça que observa-o e atira nos inimigos
		Só pode haver um olho por vez
		'''
}

DeepseaStaff: {
	DisplayName: Cajado do Mar Profundo
	Tooltip: Invoca uma estrela aquática para lutar por você
}

DormantBrimseeker: {
	DisplayName: Caçador de Enxofre
	Tooltip:
		'''
		Invoca um caçador de enxofre para acompanhar você
		Disparar outro caçador de enxofre quando todos os espaços de lacaio estiverem cheios invoca uma aura de enxofre
		A aura fortalece seus caçadores de enxofre e produz bolas de fogo que causam [cbuff:CalamityMod/BrimstoneFlames]
		Apenas uma aura pode estar ativada por vez
		Você podia jurar que eles ficaram ainda mais assustadores quando olhou para seus reflexos no espelho
		'''
}

DragonbloodDisgorger: {
	DisplayName: Expurgador de Sangue
	Tooltip:
		'''
		Invoca um dragão esqueletal e suas duas crianças
		Os cuspes dos bebês explodem em orbes de sangue ao atingir o inimigo
		Recolher estes orbes de sangue reduz a duração do [cbuffplr:PotionSickness]
		Só pode haver uma família por vez
		'''
}

DreadmineStaff: {
	DisplayName: Cajado da Mina Medonha
	Tooltip:
		'''
		{$CommonItemTooltip.Sentry}
		Invoca uma torreta que enxameia os inimigos com minas navais
		'''
}

EnchantedConch: {
	DisplayName: Concha Encantada
	Tooltip: Invoca um caranguejo eremita para lutar por você
}

EnchantedKnifeStaff: {
	DisplayName: Cajado da Faca Encantada
	Tooltip: Invoca uma Faca Encantada para lutar por você
}

Endogenesis: {
	DisplayName: Endogênese
	Tooltip:
		'''
		Invoca uma construção de gelo ascendida para protegê-lo
		Alterne entre modos de ataque reinvocando ou reutilizando o cajado
		O primeiro modo a faz disparar lasers varredores na direção do inimigo
		O segundo modo sacrifica seus membros para disparar projéteis teleguiados
		O terceiro modo permite que ela colida agressivamente contra seus inimigos
		O quarto modo faz com que os membros funcionem como lança-chamas endotérmicos
		Só pode haver uma construção por vez
		[c/B0FBFF:'Sem trocadilhos gelados']
		'''
}

EndoHydraStaff: {
	DisplayName: Cajado da Endo-hidra
	Tooltip:
		'''
		Invoca uma entidade endotérmica frígida de uma cabeça
		Se a entidade já existe, utilizar este item novamente fará com que ela receba mais cabeças
		'''
}

EntropysVigil: {
	DisplayName: Vigília da Entropia
	Tooltip: Invoca um Clone da Calamitas em miniatura e seus mini-irmãos para te proteger
}

EtherealSubjugator: {
	DisplayName: Subjugador Etéreo
	Tooltip: Invoca um fantasma para te proteger
}

EyeOfNight: {
	DisplayName: Olho da Noite
	Tooltip: Invoca um globo ocular doentio que dispara células que grudam nos inimigos
}

FlamsteedRing: {
	DisplayName: Anel de Flamsteed
	NoSpaceTextTop: Impossível Implantar
	NoSpaceTextBottom: Espaço insuficiente!
	Tooltip:
		'''
		Invoca uma meca colossal que pode ser controlada
		<right> para exibir o painel de controle da meca
		O painel possui três configurações, selecionadas utilizando os colchetes nas bordas da interface
		Cada colchete liga dois de três funções possíveis, representados pelos ícones circulares
		O ícone do canto inferior esquerdo miniaturiza a meca ao tamanho do jogador, mas enfraquece suas armas
		O ícone no canto inferior direito é um impulsionador a jato poderoso que reforça muito o movimento
		O ícone do topo é o equipamento da meca. Ele deve ser ligado para que seja possível atacar
		Clique no ícone no topo para alternar entre Regicídio, uma lâmina de energia enorme, e um rifle Gauss poderoso
		Sair da montaria enquanto um chefe estiver vivo irá temporariamente reduzir a sua velocidade de movimento
		[c/87CEEB:'Agora, faça-os pagar']
		'''
}

FleshOfInfidelity: {
	DisplayName: Carne da Infidelidade
	Tooltip: Invoca uma bola de carne com tentáculos que espirra sangue nos inimigos
}

FlowersOfMortality: {
	DisplayName: Flores da Mortalidade
	Tooltip: Invoca cinco flores arco-íris sobre sua cabeça
}

ForgottenApexWand: {
	DisplayName: Varinha do Ápice Esquecida
	Tooltip:
		'''
		Invoca tubarões minerais antigos para enfrentar seus inimigos
		'Parece ter perdido a mandíbula há algum tempo'
		'''
}

FrostBlossomStaff: {
	DisplayName: Cajado da Flor Congelante
	Tooltip:
		'''
		Invoca uma flor congelada sobre sua cabeça
		Só pode haver uma flor por vez
		'''
}

FuelCellBundle: {
	DisplayName: Pacote de Célula-combustível
	Tooltip: Libera uma variante pequena especial das pestíferas
}

GammaHeart: {
	DisplayName: Coração Gama
	Tooltip: Invoca cabeças radiativas que são anexadas ao seu corpo
}

GastricBelcherStaff: {
	DisplayName: Cajado do Arrotador Gástrico
	Tooltip:
		'''
		Invoca aberrações aquáticas para protegê-lo
		As aberrações disparam vômito em inimigos próximos a cada três golpes de disparar bolhas
		'''
}

GlacialEmbrace: {
	DisplayName: Abraço Glacial
	Tooltip:
		'''
		Invoca o poder do antigo castelo de gelo
		Para cada espaço de lacaio, você receberá um espinho de escudo orbital adicional
		Estes espinhos aceleram rapidamente na direção de um inimigo próximo para infligir um dano pesado
		Eles levam um tempo para regenerar depois de lançarem-se no alvo
		<right> para invocar um outro anel em volta do inimigo alvo, que lentamente converge e depois explode
		'''
}

GuidelightofOblivion: {
	DisplayName: Luz-Guia do Oblívio
	Tooltip:
		'''
		{$CommonItemTooltip.Sentry}
		Invoca uma torreta lanterna que incendeia os inimigos com chamas
		'As sombras sonham com fogo sem fim, chamas devoram e brasas mergulham'
		'''
}

HarvestStaff: {
	DisplayName: Cajado da Colheita
	Tooltip:
		'''
		{$CommonItemTooltip.Sentry}
		Cultiva um canteiro de abóboras que brota abóboras por perto
		As abóboras saltarão quando criaturas ou jogadores próximos se aproximarem
		Uma vez fora, elas atacarão agressivamente os inimigos, explodindo ao serem atingidas
		'Já olhou pra alguém e pensou: O que se passa na cabeça dela?'
		'''
}

HauntedScroll: {
	DisplayName: Pergaminho Amaldiçoado
	Tooltip: Invoca uma pilha de pratos amaldiçoados para lutar por você
}

HerringStaff: {
	DisplayName: Cajado do Arenque
	Tooltip: Invoca um cardume de arenques para lutar por você
}

HivePod: {
	DisplayName: Casulo-colmeia
	Tooltip:
		'''
		{$CommonItemTooltip.Sentry}
		Invoca uma astromeia para invocar astromeículas que caçam os inimigos
		      Glomerinhos espalham a [cbuff:CalamityMod/AstralInfectionDebuff] no impacto
		'''
}

IgneousExaltation: {
	DisplayName: Exaltação Ígnea
	Tooltip:
		'''
		Invoca uma lâmina ígnea que orbita o cursor
		Quando os espaços de lacaio estiverem cheios, <left> novamente para disparar todas as lâminas ao cursor
		Esta habilidade possui um tempo de recarga de 2 segundos que só diminui enquanto este item estiver empunhado
		Segure Shift e <right> neste item em seu inventário para alternar a direção da rotação
		'''
}

InfectedRemote: {
	DisplayName: Controle Remoto Infectado
	Tooltip:
		'''
		Invoca um híbrido de pestífera humanóide, de codinome 'Virili', para auxiliá-lo na batalha
		Virili só pode ser invocada uma vez
		Virili usa uma variedade de ataques em ciclo cronometrado
		Todos os ataques espalham a [cbuff:CalamityMod/Plague], como era sua intenção original
		'Há uma única etiqueta na parte de trás:
		[c/1FFBFF:AVISO: Sujeito é extremamente corrosivo e contagioso. Evite contato direto.']
		'''
}

KingofConstellationsTenryu: {
	DisplayName: Tenryū, Rei das Constelações
	Tooltip:
		'''
		Invoca um par de dragões celestiais para lutar por você
		Só pode haver um par de dragões por vez
		'Aqueles que devorarão a Estrela Imóvel'
		'''
}

LegionofCelestia: {
	DisplayName: Legion of Celestia
	Tooltip: Summons a possessed, celestial axe to fight for you
}

LiliesOfFinality: {
	DisplayName: Lírios da Finalidade
	Tooltip:
		'''
		Só pode ser invocado uma vez
		'Acorde'
		'''
}

Metastasis: {
	DisplayName: Metástase
	Tooltip:
		'''
		Invoca um Sepulcro para lutar por você
		Enquanto o Sepulcro está ativado, corações de enxofre começarão a aparecer e orbitar você
		Quando muitos corações estiverem presentes, ele deixará de atacar e irá atrás dos corações
		Isto acontece mais frequentemente conforme mais corações estiverem presentes
		Só pode ser invocado uma vez
		'''
	Calamitas:
		'''
		'Quando me juntei ao exército de Yharim, o Devorador foi um dos primeiros a me cumprimentar. Ele parecia gentil no início, mas essa máscara não durou muito.
		Ele era arrogante, desrespeitoso e suspeito. Se você não o tivesse matado, eu o teria feito.
		Criei meu Sepulcro como uma zombaria à arrogância dele, mas parece que o insulto não surtiu efeito. Você pode acrescentar "cabeça oca" à lista de títulos inventados dele.”
		'''
}

MidnightSunBeacon: {
	DisplayName: Sinalizador do Sol da Meia-Noite
	Tooltip: Invoca um OVNI para vaporizar os inimigos
}

MirrorofKalandra: {
	DisplayName: Espelho de Kalandra
	Tooltip:
		'''
		Invoca cinco armas antigas para aniquilar seus inimigos
		Só pode haver uma de cada arma individual
		[c/BD7F59:O Desfavor de Atziri corta brutalmente os inimigos]
		[c/E7A7FF:A Forja Estelar rasga os inimigos e ocasionalmente induz explosões cósmica]
		[c/868B8F:A Paradóxica se teletransporta para os inimigos e os atravessa em alta velocidade]
		[c/EBC3A5:A Rasga-Ventos dispara uma única flecha poderosa e de alta velocidade nos inimigos]
		[c/9B6856:O Triturador de Esperanças atira flechas que se dividem em três e perfuram os inimigos duas vezes]
		'Supremo, Imensurável, Indescritível'
		'''
}

MutatedTruffle: {
	DisplayName: Trufa Mutada
	Tooltip:
		'''
		Invoca um peixe-dragão mais jovem para irradiar seus inimigos
		O peixe-dragão alternará entre investidas, projéteis e um tufão
		Só pode haver um desse lacaio
		'''
}

OrthoceraShell: {
	DisplayName: Concha de Ortocera
	Tooltip:
		'''
		{$CommonItemTooltip.Sentry}
		Invoca uma ortocera sentinela voadora que cospe fluxos de [cbuff:CalamityMod/Irradiated] e [cbuff:Venom] nos inimigos
		'''
}

Perdition: {
	DisplayName: Perdição
	Tooltip:
		'''
		{$CommonItemTooltip.Sentry}
		Invoca um sinalizador na posição do mouse
		Quando um alvo é selecionado manualmente através do <right>, ele libera torrentes de almas de baixo para cima do alvo
		Apenas um sinalizador pode existir por vez
		'''
}

PlantationStaff: {
	DisplayName: Cajado da Plantação
	Tooltip:
		'''
		Invoca uma Plantera em miniatura para devastar os inimigos com sua fúria floral
		Só pode haver uma Mini-Plantera por vez
		'''
}

PolypLauncher: {
	DisplayName: Lançador de Pólipos
	Tooltip:
		'''
		{$CommonItemTooltip.Sentry}
		Invoca um aglomerado de pólipos que lançam pedaços de coral nos inimigos próximos
		'''
}

PuffShroom: {
	DisplayName: Cogumelo-folha
	Tooltip: Invoca um guerreiro cogumelo fofinho para lutar por você
}

ResurrectionButterfly: {
	DisplayName: Borboleta da Ressurreição
	Tooltip:
		'''
		Invoca um par de borboletas para lutar por você
		'Lembrando da melancolia da existência humana
		Até os fantasmas se desviam do caminho da retidão'
		'''
}

RustyBeaconPrototype: {
	DisplayName: Protótipo de Sinalizador Enferrujado
	Tooltip:
		'''
		{$CommonItemTooltip.Sentry}
		Invoca um drone há muito abandonado que passivamente emite ondas de [cbuff:CalamityMod/Irradiated]
		'''
}

SanctifiedSpark: {
	DisplayName: Faísca Santificada
	Tooltip:
		'''
		{$CommonItemTooltip.Sentry}
		Invoca um imolador amigável que flutuam ao seu redor
		Os imoladores disparam [cbuff:CalamityMod/HolyFlames] teleguiadas em inimigos próximos e logo voltam a orbitá-lo
		Depois de disparar, os imoladores disparam um raio de cura em sua direção para cada 4 espaços de lacaio
		'Podem ser meio apegados, mas pelo menos são quentinhos'
		'''
}

